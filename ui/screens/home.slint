import { Icons, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText } from "@material";
import { ToolCard } from "../components/tool-card.slint";
import { SectionHeader } from "../components/section-header.slint";
import { AppIcons } from "../components/app-icons.slint";
import { TopBar } from "../components/top-bar.slint";

export component HomeScreen inherits VerticalLayout {
    in property <bool> is_wide: root.width >= 600px;
    in property <length> status_bar_inset: 24px;
    in property <[bool]> tool_favorites: [false, false, false, false, false, false, false];
    callback open_tool(int);
    callback toggle_favorite(int);

    property <bool> is_entered: false;
    init => { self.is_entered = true; }

    // Status bar clearance
    Rectangle {
        height: root.status_bar_inset;
    }

    // Material 3 Small App Bar (56dp height, aligned on 28dp centerline)
    TopBar {
        title: "DevKit";
        has_back: false;
    }

    // Scrollable Tool Grid
    ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            padding_left: MaterialStyleMetrics.padding_16;
            padding_right: MaterialStyleMetrics.padding_16;
            padding_top: MaterialStyleMetrics.padding_8;
            padding_bottom: 112px; // Clears the floating pill nav bar at bottom
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            SectionHeader {
                title: "DEVELOPER TOOLS";
            }

            // Phone width layout: 2 columns
            if !root.is_wide : VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_12;

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_12;
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Subnet Calculator";
                        description: "IPv4 CIDR, netmask & range";
                        icon: AppIcons.lan;
                        accent_color: #00897b;
                        entrance_index: 0;
                        is_entered: root.is_entered;
                        is_favorite: root.tool_favorites[1];
                        clicked => { root.open_tool(1); }
                        toggle_favorite => { root.toggle_favorite(1); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Hash Calculator";
                        description: "MD5, SHA-256 checksums";
                        icon: AppIcons.lock;
                        accent_color: #8e24aa;
                        entrance_index: 1;
                        is_entered: root.is_entered;
                        is_favorite: root.tool_favorites[2];
                        clicked => { root.open_tool(2); }
                        toggle_favorite => { root.toggle_favorite(2); }
                    }
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_12;
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Base64";
                        description: "Encode & decode strings";
                        icon: AppIcons.code;
                        accent_color: #f4511e;
                        entrance_index: 2;
                        is_entered: root.is_entered;
                        is_favorite: root.tool_favorites[3];
                        clicked => { root.open_tool(3); }
                        toggle_favorite => { root.toggle_favorite(3); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "UUID Generator";
                        description: "Generate unique identifiers";
                        icon: AppIcons.fingerprint;
                        accent_color: #2e7d32;
                        entrance_index: 3;
                        is_entered: root.is_entered;
                        is_favorite: root.tool_favorites[4];
                        clicked => { root.open_tool(4); }
                        toggle_favorite => { root.toggle_favorite(4); }
                    }
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_12;
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Timestamp";
                        description: "Epoch & date conversions";
                        icon: AppIcons.timer;
                        accent_color: #1e88e5;
                        entrance_index: 4;
                        is_entered: root.is_entered;
                        is_favorite: root.tool_favorites[5];
                        clicked => { root.open_tool(5); }
                        toggle_favorite => { root.toggle_favorite(5); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Regex Tester";
                        description: "Evaluate pattern matches";
                        icon: AppIcons.regex;
                        accent_color: #d97706;
                        entrance_index: 5;
                        is_entered: root.is_entered;
                        is_favorite: root.tool_favorites[6];
                        clicked => { root.open_tool(6); }
                        toggle_favorite => { root.toggle_favorite(6); }
                    }
                }
            }

            // Tablet / wide width layout: 3 columns
            if root.is_wide : VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_12;

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_12;
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Subnet Calculator";
                        description: "IPv4 CIDR, netmask & range";
                        icon: AppIcons.lan;
                        accent_color: #00897b;
                        entrance_index: 0;
                        is_entered: root.is_entered;
                        is_favorite: root.tool_favorites[1];
                        clicked => { root.open_tool(1); }
                        toggle_favorite => { root.toggle_favorite(1); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Hash Calculator";
                        description: "MD5, SHA-256 checksums";
                        icon: AppIcons.lock;
                        accent_color: #8e24aa;
                        entrance_index: 1;
                        is_entered: root.is_entered;
                        is_favorite: root.tool_favorites[2];
                        clicked => { root.open_tool(2); }
                        toggle_favorite => { root.toggle_favorite(2); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Base64";
                        description: "Encode & decode strings";
                        icon: AppIcons.code;
                        accent_color: #f4511e;
                        entrance_index: 2;
                        is_entered: root.is_entered;
                        is_favorite: root.tool_favorites[3];
                        clicked => { root.open_tool(3); }
                        toggle_favorite => { root.toggle_favorite(3); }
                    }
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_12;
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "UUID Generator";
                        description: "Generate unique identifiers";
                        icon: AppIcons.fingerprint;
                        accent_color: #2e7d32;
                        entrance_index: 3;
                        is_entered: root.is_entered;
                        is_favorite: root.tool_favorites[4];
                        clicked => { root.open_tool(4); }
                        toggle_favorite => { root.toggle_favorite(4); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Timestamp";
                        description: "Epoch & date conversions";
                        icon: AppIcons.timer;
                        accent_color: #1e88e5;
                        entrance_index: 4;
                        is_entered: root.is_entered;
                        is_favorite: root.tool_favorites[5];
                        clicked => { root.open_tool(5); }
                        toggle_favorite => { root.toggle_favorite(5); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Regex Tester";
                        description: "Evaluate pattern matches";
                        icon: AppIcons.regex;
                        accent_color: #d97706;
                        entrance_index: 5;
                        is_entered: root.is_entered;
                        is_favorite: root.tool_favorites[6];
                        clicked => { root.open_tool(6); }
                        toggle_favorite => { root.toggle_favorite(6); }
                    }
                }
            }
        }
    }
}
