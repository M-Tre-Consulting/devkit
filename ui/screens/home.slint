import { Icons, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText } from "@material";
import { ToolCard } from "../components/tool-card.slint";
import { SectionHeader } from "../components/section-header.slint";

export component HomeScreen inherits VerticalLayout {
    in property <bool> is_wide: root.width >= 600px;
    callback open_tool(int);

    property <bool> is_entered: false;
    init => {
        self.is_entered = true;
    }

    // Compact title row with entrance animation (content-forward, minimal chrome)
    title_bar := HorizontalLayout {
        padding_left: MaterialStyleMetrics.padding_20;
        padding_right: MaterialStyleMetrics.padding_20;
        padding_top: 32px + (root.is_entered ? 0px : 12px);
        padding_bottom: MaterialStyleMetrics.padding_8;
        alignment: start;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate padding_top {
            duration: 250ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }
        animate opacity {
            duration: 250ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        MaterialText {
            text: "DevKit";
            style: MaterialTypography.headline_small;
            color: MaterialPalette.on_surface;
        }
    }

    // Scrollable Tool Grid
    ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            padding_left: MaterialStyleMetrics.padding_16;
            padding_right: MaterialStyleMetrics.padding_16;
            padding_top: MaterialStyleMetrics.padding_8;
            padding_bottom: 112px; // Clears the floating pill nav bar at bottom
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            SectionHeader {
                title: "DEVELOPER TOOLS";
            }

            // Phone width layout: 2 columns
            if !root.is_wide : VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_12;

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_12;
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Subnet Calculator";
                        description: "IPv4 CIDR, netmask & range";
                        icon: Icons.keyboard;
                        icon_symbol: "🌐";
                        entrance_index: 0;
                        is_entered: root.is_entered;
                        clicked => { root.open_tool(1); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Hash Calculator";
                        description: "MD5, SHA-256 checksums";
                        icon: Icons.check;
                        icon_symbol: "🔒";
                        entrance_index: 1;
                        is_entered: root.is_entered;
                        clicked => { root.open_tool(2); }
                    }
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_12;
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Base64";
                        description: "Encode & decode strings";
                        icon: Icons.edit;
                        icon_symbol: "🔤";
                        entrance_index: 2;
                        is_entered: root.is_entered;
                        clicked => { root.open_tool(3); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "UUID Generator";
                        description: "Generate unique identifiers";
                        icon: Icons.menu;
                        icon_symbol: "🆔";
                        entrance_index: 3;
                        is_entered: root.is_entered;
                        clicked => { root.open_tool(4); }
                    }
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_12;
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Timestamp";
                        description: "Epoch & date conversions";
                        icon: Icons.schedule;
                        icon_symbol: "⏱️";
                        entrance_index: 4;
                        is_entered: root.is_entered;
                        clicked => { root.open_tool(5); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Regex Tester";
                        description: "Evaluate pattern matches";
                        icon: Icons.calendar_today;
                        icon_symbol: "🔍";
                        entrance_index: 5;
                        is_entered: root.is_entered;
                        clicked => { root.open_tool(6); }
                    }
                }
            }

            // Tablet / wide width layout: 3 columns
            if root.is_wide : VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_12;

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_12;
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Subnet Calculator";
                        description: "IPv4 CIDR, netmask & range";
                        icon: Icons.keyboard;
                        icon_symbol: "🌐";
                        entrance_index: 0;
                        is_entered: root.is_entered;
                        clicked => { root.open_tool(1); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Hash Calculator";
                        description: "MD5, SHA-256 checksums";
                        icon: Icons.check;
                        icon_symbol: "🔒";
                        entrance_index: 1;
                        is_entered: root.is_entered;
                        clicked => { root.open_tool(2); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Base64";
                        description: "Encode & decode strings";
                        icon: Icons.edit;
                        icon_symbol: "🔤";
                        entrance_index: 2;
                        is_entered: root.is_entered;
                        clicked => { root.open_tool(3); }
                    }
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_12;
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "UUID Generator";
                        description: "Generate unique identifiers";
                        icon: Icons.menu;
                        icon_symbol: "🆔";
                        entrance_index: 3;
                        is_entered: root.is_entered;
                        clicked => { root.open_tool(4); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Timestamp";
                        description: "Epoch & date conversions";
                        icon: Icons.schedule;
                        icon_symbol: "⏱️";
                        entrance_index: 4;
                        is_entered: root.is_entered;
                        clicked => { root.open_tool(5); }
                    }
                    ToolCard {
                        horizontal-stretch: 1;
                        title: "Regex Tester";
                        description: "Evaluate pattern matches";
                        icon: Icons.calendar_today;
                        icon_symbol: "🔍";
                        entrance_index: 5;
                        is_entered: root.is_entered;
                        clicked => { root.open_tool(6); }
                    }
                }
            }
        }
    }
}
