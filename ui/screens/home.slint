import { ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, Icon, StateLayerArea } from "@material";
import { ToolGrid } from "../components/tool-grid.slint";
import { SectionHeader } from "../components/section-header.slint";
import { AppIcons, ToolInfo } from "../components/app-icons.slint";
import { TopBar } from "../components/top-bar.slint";

export struct SmartSuggestion {
    tool_id: int,
    tool_title: string,
    kind: string,
}

component SuggestionRow inherits Rectangle {
    in property <SmartSuggestion> item;
    in property <bool> primary;
    callback clicked();

    height: 56px;
    border_radius: MaterialStyleMetrics.border_radius_12;
    background: root.primary ? MaterialPalette.primary_container : MaterialPalette.surface_container_high;

    StateLayerArea {
        width: 100%;
        height: 100%;
        border_radius: parent.border_radius;
        color: root.primary ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding_left: 12px;
            padding_right: 12px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;
                Icon {
                    source: AppIcons.tool_icon(root.item.tool_id);
                    colorize: root.primary ? MaterialPalette.on_primary_container : MaterialPalette.primary;
                    width: 22px;
                    height: 22px;
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;
                MaterialText {
                    text: root.item.tool_title;
                    style: MaterialTypography.title_small;
                    color: root.primary ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                    overflow: elide;
                }
                MaterialText {
                    text: root.item.kind;
                    style: MaterialTypography.body_small;
                    color: root.primary ? MaterialPalette.on_primary_container.with_alpha(80%) : MaterialPalette.on_surface_variant;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;
                Icon {
                    source: AppIcons.arrow_forward;
                    colorize: root.primary ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant;
                    width: 20px;
                    height: 20px;
                }
            }
        }
    }
}

component RoundIconButton inherits Rectangle {
    in property <image> icon;
    in property <color> tint: MaterialPalette.on_surface_variant;
    callback clicked();

    width: 44px;
    height: 44px;
    border_radius: 22px;

    StateLayerArea {
        width: 100%;
        height: 100%;
        border_radius: parent.border_radius;
        color: root.tint;
        clicked => { root.clicked(); }

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.tint;
            width: 22px;
            height: 22px;
        }
    }
}

export component HomeScreen inherits VerticalLayout {
    property <int> columns: root.width >= 840px ? 4 : (root.width >= 560px ? 3 : 2);
    property <length> screen_margin: root.width >= 600px ? 24px : 16px;
    property <length> grid_gap: root.width >= 600px ? 16px : 12px;
    in property <length> status_bar_inset: 24px;
    in property <length> nav_bar_inset: 16px;
    in property <length> pill_height: 56px;
    in property <length> pill_bottom_margin: 28px;
    property <length> bottom_clearance: root.pill_height + root.pill_bottom_margin + root.nav_bar_inset + 24px;

    in property <[ToolInfo]> tools;
    in-out property <string> search_query;
    in property <[SmartSuggestion]> suggestions;
    in property <string> suggestion_source;
    in property <string> paste_feedback;

    callback home-open-tool(int);
    callback home-toggle-favorite(int);
    callback search-edited(string);
    callback smart-paste();
    callback open-suggestion(int);
    callback clear-search();

    property <bool> is_entered: false;
    init => { self.is_entered = true; }

    // Status bar clearance
    Rectangle {
        height: root.status_bar_inset;
    }

    TopBar {
        title: "DevKit";
        has_back: false;
    }

    ScrollView {
        vertical-stretch: 1;

        HorizontalLayout {
            alignment: center;
            width: 100%;

            VerticalLayout {
                max_width: 1040px;
                width: 100%;
                padding_left: root.screen_margin;
                padding_right: root.screen_margin;
                padding_top: MaterialStyleMetrics.padding_4;
                padding_bottom: root.bottom_clearance;
                spacing: MaterialStyleMetrics.spacing_16;
                alignment: start;

                // Omnibox: filter tools by name, or paste any data to get routed.
                omnibox := Rectangle {
                    height: 56px;
                    border_radius: 28px;
                    background: MaterialPalette.surface_container_high;
                    border_width: search_input.has-focus ? 2px : 1px;
                    border_color: search_input.has-focus ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(30%);

                    HorizontalLayout {
                        padding_left: 16px;
                        padding_right: 6px;
                        spacing: 10px;

                        VerticalLayout {
                            alignment: center;
                            Icon {
                                source: AppIcons.search;
                                colorize: MaterialPalette.on_surface_variant;
                                width: 22px;
                                height: 22px;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;

                            if root.search_query == "" : MaterialText {
                                width: 100%;
                                height: 100%;
                                vertical_alignment: center;
                                text: "Search tools or paste anything…";
                                style: MaterialTypography.body_large;
                                color: MaterialPalette.on_surface_variant;
                                overflow: elide;
                            }

                            search_input := TextInput {
                                width: 100%;
                                height: 100%;
                                vertical-alignment: center;
                                single-line: true;
                                text <=> root.search_query;
                                font-size: MaterialTypography.body_large.font_size;
                                color: MaterialPalette.on_surface;
                                selection-background-color: MaterialPalette.primary.with_alpha(35%);
                                selection-foreground-color: MaterialPalette.on_surface;
                                edited => { root.search-edited(self.text); }
                                accepted => {
                                    if root.suggestions.length > 0 {
                                        root.open-suggestion(0);
                                    } else if root.tools.length == 1 {
                                        root.home-open-tool(root.tools[0].id);
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            if root.search_query != "" : RoundIconButton {
                                icon: AppIcons.close;
                                clicked => {
                                    root.clear-search();
                                    search_input.clear-focus();
                                }
                            }
                            if root.search_query == "" : RoundIconButton {
                                icon: AppIcons.paste;
                                tint: MaterialPalette.primary;
                                clicked => { root.smart-paste(); }
                            }
                        }
                    }
                }

                if root.paste_feedback != "" : MaterialText {
                    text: root.paste_feedback;
                    style: MaterialTypography.body_small;
                    color: MaterialPalette.on_surface_variant;
                    horizontal_alignment: center;
                }

                // Smart Paste suggestions
                if root.suggestions.length > 0 : Rectangle {
                    border_radius: MaterialStyleMetrics.border_radius_16;
                    background: MaterialPalette.surface_container;
                    border_width: 1px;
                    border_color: MaterialPalette.primary.with_alpha(25%);

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            padding_left: 4px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: AppIcons.sparkle;
                                    colorize: MaterialPalette.primary;
                                    width: 18px;
                                    height: 18px;
                                }
                            }
                            MaterialText {
                                horizontal-stretch: 1;
                                text: "Smart Paste · " + root.suggestion_source;
                                style: MaterialTypography.label_large;
                                color: MaterialPalette.primary;
                                vertical_alignment: center;
                                overflow: elide;
                            }
                        }

                        for s[i] in root.suggestions : SuggestionRow {
                            item: s;
                            primary: i == 0;
                            clicked => { root.open-suggestion(i); }
                        }
                    }
                }

                SectionHeader {
                    title: root.search_query == "" ? "DEVELOPER TOOLS" : (root.tools.length == 0 ? "NO MATCHING TOOLS" : "MATCHING TOOLS");
                }

                ToolGrid {
                    tools: root.tools;
                    columns: root.columns;
                    gap: root.grid_gap;
                    is_entered: root.is_entered;
                    open_tool(id) => { root.home-open-tool(id); }
                    toggle_favorite(id) => { root.home-toggle-favorite(id); }
                }
            }
        }
    }
}
