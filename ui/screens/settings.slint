// Copyright 2026 M-Tre Consulting

import { Icons, ScrollView, Switch, HorizontalDivider, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, StateLayerArea, Icon, PopupMenu, MenuItem } from "@material";
import { SectionHeader } from "../components/section-header.slint";
import { AppIcons } from "../components/app-icons.slint";
import { TopBar } from "../components/top-bar.slint";

export component SettingsScreen inherits VerticalLayout {
    in property <length> status_bar_inset: 24px;
    in property <length> nav_bar_inset: 16px;
    in property <length> pill_height: 56px;
    in property <length> pill_bottom_margin: 28px;
    property <length> bottom_clearance: root.pill_height + root.pill_bottom_margin + root.nav_bar_inset + 24px;
    in-out property <bool> high_refresh_rate_enabled: false;
    in-out property <bool> high_refresh_rate_supported: false;
    callback settings-high-refresh-rate-changed(bool);
    callback settings-clear-recents();
    callback settings-clear-favorites();
    callback settings-reset-welcome();
    callback settings-open-about();

    in-out property <bool> dark_theme_enabled: true;
    in-out property <bool> dynamic_color_enabled: false;
    in-out property <int> default_hash_algorithm: 2;
    in-out property <int> default_uuid_version: 1;
    in-out property <int> default_timestamp_format: 0;
    callback settings-dark-theme-changed(bool);
    callback settings-dynamic-color-changed(bool);
    callback settings-default-hash-algorithm-changed(int);
    callback settings-default-uuid-version-changed(int);
    callback settings-default-timestamp-format-changed(int);

    pure function hash_algo_name(idx: int) -> string {
        if idx == 0 { return "MD5"; }
        if idx == 1 { return "SHA-1"; }
        if idx == 2 { return "SHA-256"; }
        if idx == 3 { return "SHA-512"; }
        if idx == 4 { return "BLAKE2b"; }
        if idx == 5 { return "BLAKE3"; }
        return "SHA-256";
    }

    pure function uuid_version_name(idx: int) -> string {
        if idx == 0 { return "UUID v1"; }
        if idx == 1 { return "UUID v4"; }
        if idx == 2 { return "UUID v7"; }
        return "UUID v4";
    }

    pure function timestamp_format_name(idx: int) -> string {
        if idx == 0 { return "ISO 8601"; }
        if idx == 1 { return "RFC 2822"; }
        if idx == 2 { return "Human Readable"; }
        if idx == 3 { return "Unix Seconds"; }
        if idx == 4 { return "Unix Millis"; }
        return "ISO 8601";
    }

    // Status bar clearance
    Rectangle {
        height: root.status_bar_inset;
    }

    // Material 3 Small App Bar (56dp height, aligned on 28dp centerline)
    TopBar {
        title: "Settings";
        has_back: false;
    }

    ScrollView {
        vertical-stretch: 1;

        HorizontalLayout {
            alignment: center;
            width: 100%;

            VerticalLayout {
                max_width: 720px;
                width: 100%;
                padding_left: root.width >= 600px ? 24px : 16px;
                padding_right: root.width >= 600px ? 24px : 16px;
                padding_top: MaterialStyleMetrics.padding_8;
                padding_bottom: root.bottom_clearance;
                spacing: MaterialStyleMetrics.spacing_16;
                alignment: start;

            // Section 1: Appearance
            SectionHeader {
                title: "APPEARANCE";
            }

            Rectangle {
                border_radius: MaterialStyleMetrics.border_radius_16;
                background: MaterialPalette.surface_container;
                border_width: 1px;
                border_color: MaterialPalette.outline_variant.with_alpha(15%);
                clip: true;

                VerticalLayout {
                    // Dark theme toggle
                    StateLayerArea {
                        width: 100%;
                        color: MaterialPalette.on_surface;

                        clicked => {
                            root.dark_theme_enabled = !root.dark_theme_enabled;
                            root.settings-dark-theme-changed(root.dark_theme_enabled);
                        }

                        HorizontalLayout {
                            padding: MaterialStyleMetrics.padding_16;
                            alignment: space-between;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: MaterialStyleMetrics.spacing_4;

                                MaterialText {
                                    text: "Dark Theme";
                                    style: MaterialTypography.title_medium;
                                    color: MaterialPalette.on_surface;
                                }
                                MaterialText {
                                    text: "Follow system display appearance";
                                    style: MaterialTypography.body_small;
                                    color: MaterialPalette.on_surface_variant;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked: root.dark_theme_enabled;
                                    checked_state_changed(checked) => {
                                        root.dark_theme_enabled = checked;
                                        root.settings-dark-theme-changed(checked);
                                    }
                                }
                            }
                        }
                    }

                    HorizontalDivider {}

                    // Dynamic colors toggle
                    StateLayerArea {
                        width: 100%;
                        color: MaterialPalette.on_surface;

                        clicked => {
                            root.dynamic_color_enabled = !root.dynamic_color_enabled;
                            root.settings-dynamic-color-changed(root.dynamic_color_enabled);
                        }

                        HorizontalLayout {
                            padding: MaterialStyleMetrics.padding_16;
                            alignment: space-between;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: MaterialStyleMetrics.spacing_4;

                                MaterialText {
                                    text: "Dynamic Colors";
                                    style: MaterialTypography.title_medium;
                                    color: MaterialPalette.on_surface;
                                }
                                MaterialText {
                                    text: "Extract accents from wallpaper (Monet)";
                                    style: MaterialTypography.body_small;
                                    color: MaterialPalette.on_surface_variant;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked: root.dynamic_color_enabled;
                                    checked_state_changed(checked) => {
                                        root.dynamic_color_enabled = checked;
                                        root.settings-dynamic-color-changed(checked);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Section 2: Display
            if root.high_refresh_rate_supported : SectionHeader {
                title: "DISPLAY";
            }

            if root.high_refresh_rate_supported : Rectangle {
                border_radius: MaterialStyleMetrics.border_radius_16;
                background: MaterialPalette.surface_container;
                border_width: 1px;
                border_color: MaterialPalette.outline_variant.with_alpha(15%);

                StateLayerArea {
                    width: 100%;
                    border_radius: parent.border_radius;
                    color: MaterialPalette.on_surface;

                    clicked => {
                        root.high_refresh_rate_enabled = !root.high_refresh_rate_enabled;
                        root.settings-high-refresh-rate-changed(root.high_refresh_rate_enabled);
                    }

                    HorizontalLayout {
                        padding: MaterialStyleMetrics.padding_16;
                        alignment: space-between;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: MaterialStyleMetrics.spacing_4;

                            MaterialText {
                                text: "High refresh rate";
                                style: MaterialTypography.title_medium;
                                color: MaterialPalette.on_surface;
                            }
                            MaterialText {
                                text: "Use the display's maximum refresh rate (may increase battery usage)";
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.on_surface_variant;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked: root.high_refresh_rate_enabled;
                                checked_state_changed(checked) => {
                                    root.high_refresh_rate_enabled = checked;
                                    root.settings-high-refresh-rate-changed(checked);
                                }
                            }
                        }
                    }
                }
            }

            // Section 3: Preferences
            SectionHeader {
                title: "TOOL PREFERENCES";
            }

            Rectangle {
                border_radius: MaterialStyleMetrics.border_radius_16;
                background: MaterialPalette.surface_container;
                border_width: 1px;
                border_color: MaterialPalette.outline_variant.with_alpha(15%);

                VerticalLayout {
                    StateLayerArea {
                        width: 100%;
                        color: MaterialPalette.on_surface;

                        clicked => {
                            hash_menu.show();
                        }

                        HorizontalLayout {
                            padding: MaterialStyleMetrics.padding_16;
                            alignment: space-between;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: MaterialStyleMetrics.spacing_4;

                                MaterialText {
                                    text: "Default Hash Algorithm";
                                    style: MaterialTypography.title_medium;
                                    color: MaterialPalette.on_surface;
                                }
                                MaterialText {
                                    text: "Pre-select " + root.hash_algo_name(root.default_hash_algorithm) + " on tool open";
                                    style: MaterialTypography.body_small;
                                    color: MaterialPalette.on_surface_variant;
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                MaterialText {
                                    text: root.hash_algo_name(root.default_hash_algorithm);
                                    style: MaterialTypography.label_medium;
                                    color: MaterialPalette.primary;
                                }
                                Icon {
                                    source: Icons.arrow_drop_down;
                                    colorize: MaterialPalette.primary;
                                    width: 20px;
                                    height: 20px;
                                }
                            }
                        }

                        hash_menu := PopupMenu {
                            width: 200px;
                            x: parent.width - self.width - 16px;
                            y: parent.height;
                            current_index: root.default_hash_algorithm;
                            items: [
                                { icon: @image-url(""), text: "MD5", trailing_text: "", enabled: true },
                                { icon: @image-url(""), text: "SHA-1", trailing_text: "", enabled: true },
                                { icon: @image-url(""), text: "SHA-256", trailing_text: "", enabled: true },
                                { icon: @image-url(""), text: "SHA-512", trailing_text: "", enabled: true },
                                { icon: @image-url(""), text: "BLAKE2b", trailing_text: "", enabled: true },
                                { icon: @image-url(""), text: "BLAKE3", trailing_text: "", enabled: true },
                            ];
                            activated(index) => {
                                root.default_hash_algorithm = index;
                                root.settings-default-hash-algorithm-changed(index);
                                hash_menu.close();
                            }
                        }
                    }

                    HorizontalDivider {}

                    // Default UUID Version
                    StateLayerArea {
                        width: 100%;
                        color: MaterialPalette.on_surface;

                        clicked => {
                            uuid_menu.show();
                        }

                        HorizontalLayout {
                            padding: MaterialStyleMetrics.padding_16;
                            alignment: space-between;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: MaterialStyleMetrics.spacing_4;

                                MaterialText {
                                    text: "Default UUID Version";
                                    style: MaterialTypography.title_medium;
                                    color: MaterialPalette.on_surface;
                                }
                                MaterialText {
                                    text: "Pre-select " + root.uuid_version_name(root.default_uuid_version) + " on tool open";
                                    style: MaterialTypography.body_small;
                                    color: MaterialPalette.on_surface_variant;
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                MaterialText {
                                    text: root.uuid_version_name(root.default_uuid_version);
                                    style: MaterialTypography.label_medium;
                                    color: MaterialPalette.primary;
                                }
                                Icon {
                                    source: Icons.arrow_drop_down;
                                    colorize: MaterialPalette.primary;
                                    width: 20px;
                                    height: 20px;
                                }
                            }
                        }

                        uuid_menu := PopupMenu {
                            width: 220px;
                            x: parent.width - self.width - 16px;
                            y: parent.height;
                            current_index: root.default_uuid_version;
                            items: [
                                { icon: @image-url(""), text: "UUID v1 (MAC & Time)", trailing_text: "", enabled: true },
                                { icon: @image-url(""), text: "UUID v4 (Random)", trailing_text: "", enabled: true },
                                { icon: @image-url(""), text: "UUID v7 (Time-ordered)", trailing_text: "", enabled: true },
                            ];
                            activated(index) => {
                                root.default_uuid_version = index;
                                root.settings-default-uuid-version-changed(index);
                                uuid_menu.close();
                            }
                        }
                    }

                    HorizontalDivider {}

                    // Timestamp Output
                    StateLayerArea {
                        width: 100%;
                        color: MaterialPalette.on_surface;

                        clicked => {
                            timestamp_menu.show();
                        }

                        HorizontalLayout {
                            padding: MaterialStyleMetrics.padding_16;
                            alignment: space-between;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: MaterialStyleMetrics.spacing_4;

                                MaterialText {
                                    text: "Timestamp Output";
                                    style: MaterialTypography.title_medium;
                                    color: MaterialPalette.on_surface;
                                }
                                MaterialText {
                                    text: "Default format: " + root.timestamp_format_name(root.default_timestamp_format);
                                    style: MaterialTypography.body_small;
                                    color: MaterialPalette.on_surface_variant;
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                MaterialText {
                                    text: root.timestamp_format_name(root.default_timestamp_format);
                                    style: MaterialTypography.label_medium;
                                    color: MaterialPalette.primary;
                                }
                                Icon {
                                    source: Icons.arrow_drop_down;
                                    colorize: MaterialPalette.primary;
                                    width: 20px;
                                    height: 20px;
                                }
                            }
                        }

                        timestamp_menu := PopupMenu {
                            width: 220px;
                            x: parent.width - self.width - 16px;
                            y: parent.height;
                            current_index: root.default_timestamp_format;
                            items: [
                                { icon: @image-url(""), text: "ISO 8601", trailing_text: "", enabled: true },
                                { icon: @image-url(""), text: "RFC 2822", trailing_text: "", enabled: true },
                                { icon: @image-url(""), text: "Human Readable", trailing_text: "", enabled: true },
                                { icon: @image-url(""), text: "Unix Seconds", trailing_text: "", enabled: true },
                                { icon: @image-url(""), text: "Unix Milliseconds", trailing_text: "", enabled: true },
                            ];
                            activated(index) => {
                                root.default_timestamp_format = index;
                                root.settings-default-timestamp-format-changed(index);
                                timestamp_menu.close();
                            }
                        }
                    }
                }
            }

            // Section 3: Data & Storage
            SectionHeader {
                title: "DATA & STORAGE";
            }

            Rectangle {
                border_radius: MaterialStyleMetrics.border_radius_16;
                background: MaterialPalette.surface_container;
                border_width: 1px;
                border_color: MaterialPalette.outline_variant.with_alpha(15%);

                VerticalLayout {
                    Rectangle {
                        border_radius: MaterialStyleMetrics.border_radius_16;

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.error;

                            clicked => {
                                root.settings-clear-recents();
                            }

                            HorizontalLayout {
                                padding: MaterialStyleMetrics.padding_16;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: MaterialStyleMetrics.spacing_4;

                                    MaterialText {
                                        text: "Clear Recent Tools";
                                        style: MaterialTypography.title_medium;
                                        color: MaterialPalette.on_surface;
                                    }
                                    MaterialText {
                                        text: "Reset recently used history list";
                                        style: MaterialTypography.body_small;
                                        color: MaterialPalette.on_surface_variant;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: AppIcons.history;
                                        colorize: MaterialPalette.error;
                                        width: 20px;
                                        height: 20px;
                                    }
                                }
                            }
                        }
                    }

                    HorizontalDivider {}

                    Rectangle {
                        border_radius: MaterialStyleMetrics.border_radius_16;

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.error;

                            clicked => {
                                root.settings-clear-favorites();
                            }

                            HorizontalLayout {
                                padding: MaterialStyleMetrics.padding_16;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: MaterialStyleMetrics.spacing_4;

                                    MaterialText {
                                        text: "Clear All Favorites";
                                        style: MaterialTypography.title_medium;
                                        color: MaterialPalette.on_surface;
                                    }
                                    MaterialText {
                                        text: "Unpin all pinned tools from Favorites";
                                        style: MaterialTypography.body_small;
                                        color: MaterialPalette.on_surface_variant;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: AppIcons.star_outline;
                                        colorize: MaterialPalette.error;
                                        width: 20px;
                                        height: 20px;
                                    }
                                }
                            }
                        }
                    }
                    HorizontalDivider {}

                    Rectangle {
                        border_radius: MaterialStyleMetrics.border_radius_16;

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;

                            clicked => {
                                root.settings-reset-welcome();
                            }

                            HorizontalLayout {
                                padding: MaterialStyleMetrics.padding_16;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: MaterialStyleMetrics.spacing_4;

                                    MaterialText {
                                        text: "Show Welcome Again";
                                        style: MaterialTypography.title_medium;
                                        color: MaterialPalette.on_surface;
                                    }
                                    MaterialText {
                                        text: "Replay the first-launch welcome tour";
                                        style: MaterialTypography.body_small;
                                        color: MaterialPalette.on_surface_variant;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: Icons.chevron_forward;
                                        colorize: MaterialPalette.on_surface_variant;
                                        width: 20px;
                                        height: 20px;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Section 4: About
            SectionHeader {
                title: "ABOUT";
            }

            Rectangle {
                border_radius: MaterialStyleMetrics.border_radius_16;
                background: MaterialPalette.surface_container;
                border_width: 1px;
                border_color: MaterialPalette.outline_variant.with_alpha(15%);

                VerticalLayout {
                    Rectangle {
                        border_radius: MaterialStyleMetrics.border_radius_16;

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;

                            clicked => {
                                root.settings-open-about();
                            }

                            HorizontalLayout {
                                padding: MaterialStyleMetrics.padding_16;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: MaterialStyleMetrics.spacing_4;

                                    MaterialText {
                                        text: "About DevKit";
                                        style: MaterialTypography.title_medium;
                                        color: MaterialPalette.on_surface;
                                    }
                                    MaterialText {
                                        text: "Version 0.2.0 • Slint attribution & license";
                                        style: MaterialTypography.body_small;
                                        color: MaterialPalette.on_surface_variant;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: Icons.chevron_forward;
                                        colorize: MaterialPalette.on_surface_variant;
                                        width: 20px;
                                        height: 20px;
                                    }
                                }
                            }
                        }
                    }

                    HorizontalDivider {}

                    HorizontalLayout {
                        padding: MaterialStyleMetrics.padding_16;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: MaterialStyleMetrics.spacing_4;

                            MaterialText {
                                text: "Application ID";
                                style: MaterialTypography.title_medium;
                                color: MaterialPalette.on_surface;
                            }
                            MaterialText {
                                text: "it.mtreconsulting.devkit";
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.on_surface_variant;
                            }
                        }
                    }
                }
            }

            // M-Tre Brand Footer
            VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_8;
                padding_top: MaterialStyleMetrics.padding_16;
                padding_bottom: MaterialStyleMetrics.padding_8;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    spacing: MaterialStyleMetrics.spacing_8;

                    Image {
                        source: AppIcons.mtre_logo;
                        width: 18px;
                        height: 18px;
                        opacity: 0.75;
                    }

                    MaterialText {
                        text: "Made by M-Tre Consulting";
                        style: MaterialTypography.label_medium;
                        color: MaterialPalette.on_surface_variant;
                        horizontal_alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    MaterialText {
                        text: "https://mtre-consulting.it";
                        style: MaterialTypography.body_small;
                        color: MaterialPalette.on_surface_variant.with_alpha(70%);
                        horizontal_alignment: center;
                    }
                }
            }
        }
    }
}
}
