import { Icons, ScrollView, Switch, HorizontalDivider, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, StateLayerArea, Icon } from "@material";
import { SectionHeader } from "../components/section-header.slint";
import { AppIcons } from "../components/app-icons.slint";
import { TopBar } from "../components/top-bar.slint";

export component SettingsScreen inherits VerticalLayout {
    in property <length> status_bar_inset: 24px;
    in property <length> nav_bar_inset: 16px;
    in property <length> pill_height: 56px;
    in property <length> pill_bottom_margin: 28px;
    property <length> bottom_clearance: root.pill_height + root.pill_bottom_margin + root.nav_bar_inset + 24px;
    callback clear_recents();
    callback clear_favorites();
    callback open_about();

    // Local toggle state properties (stubbed for future engine wiring)
    property <bool> dark_theme_enabled: true;
    property <bool> dynamic_color_enabled: true;

    // Status bar clearance
    Rectangle {
        height: root.status_bar_inset;
    }

    // Material 3 Small App Bar (56dp height, aligned on 28dp centerline)
    TopBar {
        title: "Settings";
        has_back: false;
    }

    ScrollView {
        vertical-stretch: 1;

        HorizontalLayout {
            alignment: center;
            width: 100%;

            VerticalLayout {
                max_width: 720px;
                width: 100%;
                padding_left: root.width >= 600px ? 24px : 16px;
                padding_right: root.width >= 600px ? 24px : 16px;
                padding_top: MaterialStyleMetrics.padding_8;
                padding_bottom: root.bottom_clearance;
                spacing: MaterialStyleMetrics.spacing_16;
                alignment: start;

            // Section 1: Appearance
            SectionHeader {
                title: "APPEARANCE";
            }

            Rectangle {
                border_radius: MaterialStyleMetrics.border_radius_16;
                background: MaterialPalette.surface_container;
                border_width: 1px;
                border_color: MaterialPalette.outline_variant.with_alpha(15%);

                VerticalLayout {
                    // Dark theme toggle
                    HorizontalLayout {
                        padding: MaterialStyleMetrics.padding_16;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: MaterialStyleMetrics.spacing_4;

                            MaterialText {
                                text: "Dark Theme";
                                style: MaterialTypography.title_medium;
                                color: MaterialPalette.on_surface;
                            }
                            MaterialText {
                                text: "Follow system display appearance";
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.on_surface_variant;
                            }
                        }

                        Switch {
                            checked: root.dark_theme_enabled;
                            checked_state_changed(checked) => {
                                // TODO: Wire to theme engine
                                root.dark_theme_enabled = checked;
                            }
                        }
                    }

                    HorizontalDivider {}

                    // Dynamic colors toggle
                    HorizontalLayout {
                        padding: MaterialStyleMetrics.padding_16;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: MaterialStyleMetrics.spacing_4;

                            MaterialText {
                                text: "Dynamic Colors";
                                style: MaterialTypography.title_medium;
                                color: MaterialPalette.on_surface;
                            }
                            MaterialText {
                                text: "Extract accents from wallpaper (Monet)";
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.on_surface_variant;
                            }
                        }

                        Switch {
                            checked: root.dynamic_color_enabled;
                            checked_state_changed(checked) => {
                                // TODO: Wire to dynamic color Monet provider
                                root.dynamic_color_enabled = checked;
                            }
                        }
                    }
                }
            }

            // Section 2: Preferences
            SectionHeader {
                title: "TOOL PREFERENCES";
            }

            Rectangle {
                border_radius: MaterialStyleMetrics.border_radius_16;
                background: MaterialPalette.surface_container;
                border_width: 1px;
                border_color: MaterialPalette.outline_variant.with_alpha(15%);

                VerticalLayout {
                    HorizontalLayout {
                        padding: MaterialStyleMetrics.padding_16;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: MaterialStyleMetrics.spacing_4;

                            MaterialText {
                                text: "Default Hash Algorithm";
                                style: MaterialTypography.title_medium;
                                color: MaterialPalette.on_surface;
                            }
                            MaterialText {
                                text: "Pre-select SHA-256 on tool open";
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.on_surface_variant;
                            }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            MaterialText {
                                text: "SHA-256";
                                style: MaterialTypography.label_medium;
                                color: MaterialPalette.primary;
                            }
                        }
                    }

                    HorizontalDivider {}

                    HorizontalLayout {
                        padding: MaterialStyleMetrics.padding_16;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: MaterialStyleMetrics.spacing_4;

                            MaterialText {
                                text: "Timestamp Output";
                                style: MaterialTypography.title_medium;
                                color: MaterialPalette.on_surface;
                            }
                            MaterialText {
                                text: "Format timestamp conversions in UTC";
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.on_surface_variant;
                            }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            MaterialText {
                                text: "ISO 8601";
                                style: MaterialTypography.label_medium;
                                color: MaterialPalette.primary;
                            }
                        }
                    }
                }
            }

            // Section 3: Data & Storage
            SectionHeader {
                title: "DATA & STORAGE";
            }

            Rectangle {
                border_radius: MaterialStyleMetrics.border_radius_16;
                background: MaterialPalette.surface_container;
                border_width: 1px;
                border_color: MaterialPalette.outline_variant.with_alpha(15%);

                VerticalLayout {
                    Rectangle {
                        border_radius: MaterialStyleMetrics.border_radius_16;

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.error;

                            clicked => {
                                root.clear_recents();
                            }

                            HorizontalLayout {
                                padding: MaterialStyleMetrics.padding_16;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: MaterialStyleMetrics.spacing_4;

                                    MaterialText {
                                        text: "Clear Recent Tools";
                                        style: MaterialTypography.title_medium;
                                        color: MaterialPalette.on_surface;
                                    }
                                    MaterialText {
                                        text: "Reset recently used history list";
                                        style: MaterialTypography.body_small;
                                        color: MaterialPalette.on_surface_variant;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: AppIcons.history;
                                        colorize: MaterialPalette.error;
                                        width: 20px;
                                        height: 20px;
                                    }
                                }
                            }
                        }
                    }

                    HorizontalDivider {}

                    Rectangle {
                        border_radius: MaterialStyleMetrics.border_radius_16;

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.error;

                            clicked => {
                                root.clear_favorites();
                            }

                            HorizontalLayout {
                                padding: MaterialStyleMetrics.padding_16;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: MaterialStyleMetrics.spacing_4;

                                    MaterialText {
                                        text: "Clear All Favorites";
                                        style: MaterialTypography.title_medium;
                                        color: MaterialPalette.on_surface;
                                    }
                                    MaterialText {
                                        text: "Unpin all pinned tools from Favorites";
                                        style: MaterialTypography.body_small;
                                        color: MaterialPalette.on_surface_variant;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: AppIcons.star_outline;
                                        colorize: MaterialPalette.error;
                                        width: 20px;
                                        height: 20px;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Section 4: About
            SectionHeader {
                title: "ABOUT";
            }

            Rectangle {
                border_radius: MaterialStyleMetrics.border_radius_16;
                background: MaterialPalette.surface_container;
                border_width: 1px;
                border_color: MaterialPalette.outline_variant.with_alpha(15%);

                VerticalLayout {
                    Rectangle {
                        border_radius: MaterialStyleMetrics.border_radius_16;

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;

                            clicked => {
                                root.open_about();
                            }

                            HorizontalLayout {
                                padding: MaterialStyleMetrics.padding_16;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: MaterialStyleMetrics.spacing_4;

                                    MaterialText {
                                        text: "About DevKit";
                                        style: MaterialTypography.title_medium;
                                        color: MaterialPalette.on_surface;
                                    }
                                    MaterialText {
                                        text: "Version 0.1.0 • Slint attribution & license";
                                        style: MaterialTypography.body_small;
                                        color: MaterialPalette.on_surface_variant;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: Icons.chevron_forward;
                                        colorize: MaterialPalette.on_surface_variant;
                                        width: 20px;
                                        height: 20px;
                                    }
                                }
                            }
                        }
                    }

                    HorizontalDivider {}

                    HorizontalLayout {
                        padding: MaterialStyleMetrics.padding_16;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: MaterialStyleMetrics.spacing_4;

                            MaterialText {
                                text: "Application ID";
                                style: MaterialTypography.title_medium;
                                color: MaterialPalette.on_surface;
                            }
                            MaterialText {
                                text: "it.mtreconsulting.devkit";
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.on_surface_variant;
                            }
                        }
                    }
                }
            }
        }
    }
}
}
