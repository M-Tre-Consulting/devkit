import { ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, StateLayerArea, Icon, TextField } from "@material";
import { TopBar } from "../components/top-bar.slint";
import { ToolErrorBanner } from "../components/tool-error-banner.slint";
import { ToolActionButton } from "../components/tool-action-button.slint";
import { AppIcons } from "../components/app-icons.slint";

export struct PortItem {
    port: int,
    is_open: bool,
    service_name: string,
    service_category: string,
    description: string,
    latency_ms: int,
}

export struct HostItem {
    ip: string,
    latency_ms: int,
    open_ports: string,
    is_self: bool,
    is_gateway: bool,
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    height: 32px;
    min-width: label.preferred-width + 24px;
    border-radius: 8px;
    background: root.selected ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
    border-width: 1px;
    border-color: root.selected ? MaterialPalette.secondary : MaterialPalette.outline_variant;

    label := MaterialText {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        style: MaterialTypography.label_medium;
        color: root.selected ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
    }

    StateLayerArea {
        width: 100%;
        height: 100%;
        border_radius: parent.border-radius;
        color: MaterialPalette.on_surface;
        clicked => { root.clicked(); }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fg: MaterialPalette.on_surface_variant;
    in property <color> bg: MaterialPalette.surface_container_highest;

    height: 22px;
    min-width: txt.preferred-width + 14px;
    border-radius: 6px;
    background: root.bg;

    txt := MaterialText {
        x: 7px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        style: MaterialTypography.label_small;
        color: root.fg;
    }
}

component SmallIconButton inherits Rectangle {
    in property <image> icon;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: MaterialPalette.surface_container_high;

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: MaterialPalette.on_surface_variant;
    }

    StateLayerArea {
        width: 100%;
        height: 100%;
        border_radius: parent.border-radius;
        color: MaterialPalette.primary;
        clicked => { root.clicked(); }
    }
}

export component LanScoutScreen inherits VerticalLayout {
    in property <length> status_bar_inset: 24px;
    in property <length> nav_bar_inset: 16px;
    callback scout-back();
    // (host, timeout_ms, mode, custom_ports) — mode 0 = known services, 1 = custom ports
    callback scout-scan(string, int, int, string);
    callback scout-discover(int);
    callback scout-copy(string);
    callback scout-refresh-network();
    // Hand a target to another tool (tool id, payload).
    callback scout-open-tool(int, string);

    in property <string> detected_gateway: "192.168.0.1";
    in property <string> detected_device_ip: "127.0.0.1";
    in property <string> network_summary: "";
    in-out property <string> target_host: "192.168.0.1";
    in-out property <int> selected_timeout_ms: 600;
    in-out property <int> mode: 0; // 0 = services, 1 = custom ports, 2 = discover hosts
    in-out property <string> custom_ports: "22,80,443,3000-3010,5000,8000-8100";
    in property <bool> is_scanning: false;
    in property <string> progress_text: "";
    in-out property <bool> filter_only_open: true;
    in property <string> error_message: "";

    in property <int> open_ports_count: 0;
    in property <int> total_scanned_count: 0;
    in property <[PortItem]> scan_results: [];
    in property <[PortItem]> open_results: [];
    in property <[HostItem]> hosts: [];
    in property <int> hosts_probed: 0;

    property <bool> is_entered: false;
    init => {
        self.is_entered = true;
    }

    TopBar {
        title: "LAN & Service Scout";
        has_back: true;
        back => { root.scout-back(); }
    }

    ScrollView {
        vertical-stretch: 1;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate opacity {
            duration: 200ms;
            delay: 150ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding_left: MaterialStyleMetrics.padding_16;
            padding_right: MaterialStyleMetrics.padding_16;
            padding_top: MaterialStyleMetrics.padding_8;
            padding_bottom: 96px + root.nav_bar_inset;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            // Network identity card
            Rectangle {
                background: MaterialPalette.surface_container_low;
                border-radius: MaterialStyleMetrics.border_radius_12;
                border-width: 1px;
                border-color: MaterialPalette.outline_variant.with_alpha(40%);

                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        Icon {
                            source: AppIcons.lan;
                            colorize: MaterialPalette.primary;
                            width: 22px;
                            height: 22px;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        MaterialText {
                            text: "This device: " + root.detected_device_ip + "  ·  Gateway: " + root.detected_gateway;
                            style: MaterialTypography.label_large;
                            color: MaterialPalette.on_surface;
                            wrap: word-wrap;
                        }
                        if root.network_summary != "" : MaterialText {
                            text: root.network_summary;
                            style: MaterialTypography.body_small;
                            color: MaterialPalette.on_surface_variant;
                            wrap: word-wrap;
                        }
                    }

                    SmallIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: AppIcons.history;
                        clicked => { root.scout-refresh-network(); }
                    }
                }
            }

            // Mode selector
            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;
                alignment: start;
                Chip { text: "Services"; selected: root.mode == 0; clicked => { root.mode = 0; } }
                Chip { text: "Custom Ports"; selected: root.mode == 1; clicked => { root.mode = 1; } }
                Chip { text: "Discover Hosts"; selected: root.mode == 2; clicked => { root.mode = 2; } }
            }

            ToolErrorBanner {
                message: root.error_message;
            }

            // Target / options card
            Rectangle {
                background: MaterialPalette.surface_container_low;
                border-radius: MaterialStyleMetrics.border_radius_12;
                border-width: 1px;
                border-color: MaterialPalette.outline_variant;

                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_12;

                    if root.mode != 2 : VerticalLayout {
                        spacing: MaterialStyleMetrics.spacing_12;

                        MaterialText {
                            text: "Target IP or Hostname";
                            style: MaterialTypography.title_small;
                            color: MaterialPalette.on_surface;
                        }

                        TextField {
                            text <=> root.target_host;
                            placeholder_text: "e.g. 192.168.1.100 or myserver.local";
                        }

                        HorizontalLayout {
                            spacing: MaterialStyleMetrics.spacing_8;
                            alignment: start;
                            Chip { text: "Gateway"; selected: root.target_host == root.detected_gateway; clicked => { root.target_host = root.detected_gateway; } }
                            Chip { text: "This device"; selected: root.target_host == root.detected_device_ip; clicked => { root.target_host = root.detected_device_ip; } }
                            Chip { text: "localhost"; selected: root.target_host == "127.0.0.1"; clicked => { root.target_host = "127.0.0.1"; } }
                        }

                        if root.mode == 1 : VerticalLayout {
                            spacing: MaterialStyleMetrics.spacing_8;
                            MaterialText {
                                text: "Ports (comma separated, ranges allowed, max 1024)";
                                style: MaterialTypography.title_small;
                                color: MaterialPalette.on_surface;
                            }
                            TextField {
                                text <=> root.custom_ports;
                                placeholder_text: "22, 80, 443, 8000-8100";
                            }
                        }
                    }

                    if root.mode == 2 : MaterialText {
                        text: "Sweeps the local /24 around " + root.detected_device_ip + ". A host counts as alive when it accepts or actively refuses a TCP connection, so even firewalled phones usually show up.";
                        style: MaterialTypography.body_small;
                        color: MaterialPalette.on_surface_variant;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;
                        alignment: start;

                        MaterialText {
                            text: "Timeout";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface_variant;
                            vertical_alignment: center;
                        }
                        Chip { text: "Fast"; selected: root.selected_timeout_ms == 300; clicked => { root.selected_timeout_ms = 300; } }
                        Chip { text: "Balanced"; selected: root.selected_timeout_ms == 600; clicked => { root.selected_timeout_ms = 600; } }
                        Chip { text: "Reliable"; selected: root.selected_timeout_ms == 1500; clicked => { root.selected_timeout_ms = 1500; } }
                    }
                }
            }

            ToolActionButton {
                text: root.is_scanning ? (root.progress_text != "" ? root.progress_text : "Scanning…") : (root.mode == 2 ? "Discover Hosts" : (root.mode == 1 ? "Scan Ports" : "Scan Known Services"));
                enabled: !root.is_scanning;
                has_clear: false;
                clicked => {
                    if root.mode == 2 {
                        root.scout-discover(root.selected_timeout_ms);
                    } else {
                        root.scout-scan(root.target_host, root.selected_timeout_ms, root.mode, root.custom_ports);
                    }
                }
            }

            // ---------------- Port results ----------------
            if root.mode != 2 && root.total_scanned_count > 0 : HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                Badge {
                    text: root.open_ports_count + " open";
                    bg: root.open_ports_count > 0 ? MaterialPalette.primary_container : MaterialPalette.surface_container_highest;
                    fg: root.open_ports_count > 0 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant;
                }
                Badge { text: root.total_scanned_count + " probed"; }
                Rectangle { horizontal-stretch: 1; }
                Chip {
                    text: root.filter_only_open ? "Open only" : "All ports";
                    selected: root.filter_only_open;
                    clicked => { root.filter_only_open = !root.filter_only_open; }
                }
            }

            if root.mode != 2 && root.total_scanned_count > 0 && root.filter_only_open && root.open_ports_count == 0 : MaterialText {
                text: "No open ports found. Try a longer timeout or another target.";
                style: MaterialTypography.body_medium;
                color: MaterialPalette.on_surface_variant;
                horizontal_alignment: center;
                wrap: word-wrap;
            }

            // A filtered model (computed in Rust) instead of `visible: false` rows, so
            // hidden rows don't leave empty gaps in the layout.
            if root.mode != 2 : VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                for item in (root.filter_only_open ? root.open_results : root.scan_results) : Rectangle {
                    background: item.is_open ? MaterialPalette.surface_container : MaterialPalette.surface_container_lowest;
                    border-radius: MaterialStyleMetrics.border_radius_8;
                    border-width: 1px;
                    border-color: item.is_open ? MaterialPalette.primary.with_alpha(60%) : MaterialPalette.outline_variant.with_alpha(50%);

                    HorizontalLayout {
                        padding: MaterialStyleMetrics.padding_12;
                        spacing: MaterialStyleMetrics.spacing_8;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            alignment: center;

                            HorizontalLayout {
                                spacing: MaterialStyleMetrics.spacing_8;
                                alignment: start;
                                MaterialText {
                                    text: ":" + item.port;
                                    style: MaterialTypography.title_medium;
                                    color: item.is_open ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
                                    vertical_alignment: center;
                                }
                                Badge {
                                    y: (parent.height - self.height) / 2;
                                    text: item.service_name;
                                    bg: item.is_open ? MaterialPalette.tertiary_container : MaterialPalette.surface_container_highest;
                                    fg: item.is_open ? MaterialPalette.on_tertiary_container : MaterialPalette.outline;
                                }
                            }

                            MaterialText {
                                text: item.service_category + " · " + item.description;
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.outline;
                                overflow: elide;
                            }
                        }

                        Badge {
                            y: (parent.height - self.height) / 2;
                            text: item.is_open ? (item.latency_ms + " ms") : "closed";
                            bg: item.is_open ? MaterialPalette.primary_container : MaterialPalette.surface_container_highest;
                            fg: item.is_open ? MaterialPalette.on_primary_container : MaterialPalette.outline;
                        }

                        // Cross-tool actions for open ports
                        if item.is_open && (item.port == 443 || item.port == 8443 || item.port == 6443 || item.port == 993 || item.port == 465) : SmallIconButton {
                            y: (parent.height - self.height) / 2;
                            icon: AppIcons.shield;
                            clicked => { root.scout-open-tool(19, root.target_host + ":" + item.port); }
                        }
                        if item.is_open && item.service_category != "Database" && item.port != 22 && item.port != 443 && item.port != 8443 : SmallIconButton {
                            y: (parent.height - self.height) / 2;
                            icon: AppIcons.http;
                            clicked => { root.scout-open-tool(17, "http://" + root.target_host + ":" + item.port + "/"); }
                        }
                        if item.is_open : SmallIconButton {
                            y: (parent.height - self.height) / 2;
                            icon: AppIcons.copy;
                            clicked => { root.scout-copy(root.target_host + ":" + item.port); }
                        }
                    }
                }
            }

            // ---------------- Host discovery results ----------------
            if root.mode == 2 && root.hosts_probed > 0 : HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;
                Badge {
                    text: root.hosts.length + " hosts alive";
                    bg: MaterialPalette.primary_container;
                    fg: MaterialPalette.on_primary_container;
                }
                Badge { text: root.hosts_probed + " addresses probed"; }
            }

            if root.mode == 2 : VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                for host in root.hosts : Rectangle {
                    background: MaterialPalette.surface_container;
                    border-radius: MaterialStyleMetrics.border_radius_8;
                    border-width: 1px;
                    border-color: MaterialPalette.outline_variant.with_alpha(50%);

                    HorizontalLayout {
                        padding: MaterialStyleMetrics.padding_12;
                        spacing: MaterialStyleMetrics.spacing_8;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            alignment: center;

                            HorizontalLayout {
                                spacing: MaterialStyleMetrics.spacing_8;
                                alignment: start;
                                MaterialText {
                                    text: host.ip;
                                    style: MaterialTypography.title_medium;
                                    color: MaterialPalette.on_surface;
                                    vertical_alignment: center;
                                }
                                if host.is_gateway : Badge {
                                    y: (parent.height - self.height) / 2;
                                    text: "gateway";
                                    bg: MaterialPalette.tertiary_container;
                                    fg: MaterialPalette.on_tertiary_container;
                                }
                                if host.is_self : Badge {
                                    y: (parent.height - self.height) / 2;
                                    text: "this device";
                                    bg: MaterialPalette.secondary_container;
                                    fg: MaterialPalette.on_secondary_container;
                                }
                            }

                            MaterialText {
                                text: host.open_ports != "" ? ("Responds on :" + host.open_ports) : "Alive (connection refused)";
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.outline;
                            }
                        }

                        Badge {
                            y: (parent.height - self.height) / 2;
                            text: host.latency_ms + " ms";
                        }

                        SmallIconButton {
                            y: (parent.height - self.height) / 2;
                            icon: AppIcons.radar;
                            clicked => {
                                root.target_host = host.ip;
                                root.mode = 0;
                                root.scout-scan(host.ip, root.selected_timeout_ms, 0, root.custom_ports);
                            }
                        }
                        SmallIconButton {
                            y: (parent.height - self.height) / 2;
                            icon: AppIcons.copy;
                            clicked => { root.scout-copy(host.ip); }
                        }
                    }
                }
            }
        }
    }
}
