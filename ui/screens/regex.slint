import { AppBar, Icons, TextField, OutlinedCard, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText } from "@material";

export component RegexScreen inherits VerticalLayout {
    callback back();

    AppBar {
        title: "Regex Tester";
        show_background: true;
        leading_button: {
            icon: Icons.arrow_back,
            tooltip: "Back",
            enabled: true
        };
        leading_button_clicked => {
            root.back();
        }
    }

    ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            padding: MaterialStyleMetrics.padding_16;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            HorizontalLayout {
                alignment: center;
                MaterialText {
                    text: "Coming soon";
                    style: MaterialTypography.label_large;
                    color: MaterialPalette.on_surface_variant;
                }
            }

            MaterialText {
                text: "REGULAR EXPRESSION";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            TextField {
                label: "Pattern (e.g. ^[a-zA-Z0-9_]+$)";
                enabled: false;
            }

            MaterialText {
                text: "TEST STRING";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            TextField {
                label: "Enter text to evaluate regex match...";
                enabled: false;
            }

            MaterialText {
                text: "MATCH RESULTS";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            OutlinedCard {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_8;

                    MaterialText {
                        text: "Match Status: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Match Count: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Capture Groups: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                }
            }
        }
    }
}
