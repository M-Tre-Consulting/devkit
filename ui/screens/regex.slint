import { Icons, TextField, Switch, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, StateLayerArea, Icon } from "@material";
import { TopBar } from "../components/top-bar.slint";
import { ToolErrorBanner } from "../components/tool-error-banner.slint";
import { ToolActionButton } from "../components/tool-action-button.slint";
import { ToolOutputArea } from "../components/tool-output-area.slint";
import { ToolTextArea } from "../components/tool-text-area.slint";
import { AppIcons } from "../components/app-icons.slint";

export component RegexScreen inherits VerticalLayout {
    in property <length> status_bar_inset: 24px;
    in property <length> nav_bar_inset: 16px;
    callback back();

    in-out property <string> pattern: "[a-zA-Z0-9_]+";
    in-out property <string> test_string: "DevKit_2026";
    in-out property <bool> case_insensitive: false;
    in-out property <bool> multiline: false;
    in-out property <bool> dot_matches_newline: false;
    in-out property <string> match_summary: "1 match found";
    in-out property <[string]> matches_list: ["Match 1: 'DevKit_2026' [0..11]"];
    in-out property <string> error_message: "";
    in-out property <bool> is_loading: false;

    callback evaluate();
    callback clear();
    callback copy(string);

    property <bool> is_entered: false;
    init => { self.is_entered = true; }

    TopBar {
        title: "Regex Tester";
        has_back: true;
        show_background: true;
        back => { root.back(); }
    }

    ScrollView {
        vertical-stretch: 1;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate opacity {
            duration: 200ms;
            delay: 150ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding_left: MaterialStyleMetrics.padding_16;
            padding_right: MaterialStyleMetrics.padding_16;
            padding_top: MaterialStyleMetrics.padding_16;
            padding_bottom: 96px + root.nav_bar_inset;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            ToolErrorBanner {
                message: root.error_message;
            }

            // Pattern input
            MaterialText {
                text: "REGULAR EXPRESSION";
                style: MaterialTypography.label_large;
                color: MaterialPalette.primary;
            }

            TextField {
                label: "Regex pattern (e.g. ^[a-z0-9_-]+$)";
                text <=> root.pattern;
                enabled: !root.is_loading;
            }

            // Flags selection
            MaterialText {
                text: "FLAGS & MODIFIERS";
                style: MaterialTypography.label_large;
                color: MaterialPalette.primary;
            }

            Rectangle {
                border_radius: MaterialStyleMetrics.border_radius_12;
                background: MaterialPalette.surface_container;
                border_width: 1px;
                border_color: MaterialPalette.outline_variant.with_alpha(15%);

                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_12;
                    spacing: MaterialStyleMetrics.spacing_8;

                    // Case-insensitive
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            alignment: center;
                            MaterialText {
                                text: "Case Insensitive (i)";
                                style: MaterialTypography.body_medium;
                                color: MaterialPalette.on_surface;
                            }
                        }
                        Switch {
                            checked <=> root.case_insensitive;
                        }
                    }

                    // Multiline
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            alignment: center;
                            MaterialText {
                                text: "Multiline Mode (m)";
                                style: MaterialTypography.body_medium;
                                color: MaterialPalette.on_surface;
                            }
                        }
                        Switch {
                            checked <=> root.multiline;
                        }
                    }

                    // Dot matches newline
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            alignment: center;
                            MaterialText {
                                text: "Dot Matches Newline (s)";
                                style: MaterialTypography.body_medium;
                                color: MaterialPalette.on_surface;
                            }
                        }
                        Switch {
                            checked <=> root.dot_matches_newline;
                        }
                    }
                }
            }

            // Test string input
            ToolTextArea {
                label: "TEST STRING";
                placeholder_text: "Text to evaluate against regex...";
                text <=> root.test_string;
                enabled: !root.is_loading;
                min_box_height: 160px;
                max_box_height: 240px;
            }

            ToolActionButton {
                text: "Evaluate Regex";
                enabled: root.pattern != "" && !root.is_loading;
                has_clear: true;
                clicked => { root.evaluate(); }
                clear => {
                    root.pattern = "";
                    root.test_string = "";
                    root.match_summary = "";
                    root.matches_list = [];
                    root.error_message = "";
                    root.clear();
                }
            }

            // Match Summary
            ToolOutputArea {
                title: "EVALUATION SUMMARY";
                text: root.match_summary;
                is_code: false;
                has_copy: false;
            }

            // Matches List
            MaterialText {
                text: "MATCHES & CAPTURES";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                for match[idx] in root.matches_list: Rectangle {
                    border_radius: MaterialStyleMetrics.border_radius_12;
                    background: MaterialPalette.surface_container;
                    border_width: 1px;
                    border_color: MaterialPalette.outline_variant.with_alpha(15%);

                    HorizontalLayout {
                        padding: MaterialStyleMetrics.padding_12;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            MaterialText {
                                text: match;
                                style: MaterialTypography.body_medium;
                                color: MaterialPalette.on_surface;
                            }
                        }

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border_radius: 16px;
                            StateLayerArea {
                                width: 100%;
                                height: 100%;
                                border_radius: parent.border_radius;
                                color: MaterialPalette.primary;
                                clicked => { root.copy(match); }
                                HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            source: AppIcons.copy;
                                            colorize: MaterialPalette.primary;
                                            width: 16px;
                                            height: 16px;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
