import { Icons, TextField, OutlinedCard, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText } from "@material";
import { TopBar } from "../components/top-bar.slint";

export component RegexScreen inherits VerticalLayout {
    callback back();

    property <bool> is_entered: false;
    init => { self.is_entered = true; }

    TopBar {
        title: "Regex Tester";
        has_back: true;
        show_background: true;
        back => { root.back(); }
    }

    ScrollView {
        vertical-stretch: 1;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate opacity {
            duration: 200ms;
            delay: 150ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding: MaterialStyleMetrics.padding_16;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            HorizontalLayout {
                alignment: center;
                MaterialText {
                    text: "Coming soon";
                    style: MaterialTypography.label_large;
                    color: MaterialPalette.on_surface_variant;
                }
            }

            MaterialText {
                text: "REGULAR EXPRESSION";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            TextField {
                label: "Pattern (e.g. ^[a-zA-Z0-9_]+$)";
                enabled: false;
            }

            MaterialText {
                text: "TEST STRING";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            TextField {
                label: "Enter text to evaluate regex match...";
                enabled: false;
            }

            MaterialText {
                text: "MATCH RESULTS";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            OutlinedCard {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_8;

                    MaterialText {
                        text: "Match Status: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Match Count: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Capture Groups: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                }
            }
        }
    }
}
