import { AppBar, Icons, TextField, OutlinedCard, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText } from "@material";

export component TimestampScreen inherits VerticalLayout {
    callback back();

    property <bool> is_entered: false;
    init => { self.is_entered = true; }

    AppBar {
        title: "Timestamp Converter";
        show_background: true;
        leading_button: {
            icon: Icons.arrow_back,
            tooltip: "Back",
            enabled: true
        };
        leading_button_clicked => {
            root.back();
        }
    }

    ScrollView {
        vertical-stretch: 1;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate opacity {
            duration: 200ms;
            delay: 150ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding: MaterialStyleMetrics.padding_16;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            HorizontalLayout {
                alignment: center;
                MaterialText {
                    text: "Coming soon";
                    style: MaterialTypography.label_large;
                    color: MaterialPalette.on_surface_variant;
                }
            }

            MaterialText {
                text: "EPOCH OR DATE INPUT";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            TextField {
                label: "Timestamp (seconds/ms) or ISO 8601...";
                enabled: false;
            }

            MaterialText {
                text: "CONVERTED TIMESTAMPS";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            OutlinedCard {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_8;

                    MaterialText {
                        text: "Unix Seconds: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Unix Milliseconds: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "ISO 8601 (UTC): —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Local Time: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                }
            }
        }
    }
}
