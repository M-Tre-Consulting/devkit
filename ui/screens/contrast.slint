import { Icons, TextField, OutlinedCard, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, Icon, StateLayerArea } from "@material";
import { TopBar } from "../components/top-bar.slint";
import { ToolErrorBanner } from "../components/tool-error-banner.slint";
import { ToolActionButton } from "../components/tool-action-button.slint";
import { ToolOutputArea } from "../components/tool-output-area.slint";
import { AppIcons } from "../components/app-icons.slint";

export component ContrastScreen inherits VerticalLayout {
    callback back();
    callback check_contrast();
    callback swap_colors();
    callback select_preset(string, string);
    callback copy(string);

    in-out property <string> fg_color_text: "#FFFFFF";
    in-out property <string> bg_color_text: "#6750A4";
    in-out property <color> fg_color: #ffffff;
    in-out property <color> bg_color: #6750a4;

    in-out property <string> ratio_text: "7.15 : 1";
    in-out property <bool> aa_normal_pass: true;
    in-out property <bool> aa_large_pass: true;
    in-out property <bool> aaa_normal_pass: true;
    in-out property <bool> aaa_large_pass: true;
    in-out property <bool> ui_components_pass: true;
    in-out property <string> error_message: "";

    property <bool> is_entered: false;
    init => { self.is_entered = true; }

    TopBar {
        title: "Contrast Checker";
        has_back: true;
        show_background: true;
        back => { root.back(); }
    }

    ScrollView {
        vertical-stretch: 1;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate opacity {
            duration: 200ms;
            delay: 150ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding_left: MaterialStyleMetrics.padding_16;
            padding_right: MaterialStyleMetrics.padding_16;
            padding_top: MaterialStyleMetrics.padding_16;
            padding_bottom: 96px;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            ToolErrorBanner {
                message: root.error_message;
            }

            // Presets
            VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                MaterialText {
                    text: "PALETTE PAIRS";
                    style: MaterialTypography.label_medium;
                    color: MaterialPalette.primary;
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_8;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.fg_color_text == "#FFFFFF" && root.bg_color_text == "#6750A4" ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.fg_color_text == "#FFFFFF" && root.bg_color_text == "#6750A4" ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => {
                                root.fg_color_text = "#FFFFFF";
                                root.bg_color_text = "#6750A4";
                                root.fg_color = #ffffff;
                                root.bg_color = #6750a4;
                                root.select_preset("#FFFFFF", "#6750A4");
                            }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "White/Purple";
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.fg_color_text == "#1C1B1F" && root.bg_color_text == "#F4EFF4" ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.fg_color_text == "#1C1B1F" && root.bg_color_text == "#F4EFF4" ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => {
                                root.fg_color_text = "#1C1B1F";
                                root.bg_color_text = "#F4EFF4";
                                root.fg_color = #1c1b1f;
                                root.bg_color = #f4eff4;
                                root.select_preset("#1C1B1F", "#F4EFF4");
                            }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "Dark/Light";
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.fg_color_text == "#E6E1E5" && root.bg_color_text == "#1C1B1F" ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.fg_color_text == "#E6E1E5" && root.bg_color_text == "#1C1B1F" ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => {
                                root.fg_color_text = "#E6E1E5";
                                root.bg_color_text = "#1C1B1F";
                                root.fg_color = #e6e1e5;
                                root.bg_color = #1c1b1f;
                                root.select_preset("#E6E1E5", "#1C1B1F");
                            }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "Light/Dark";
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Dual Color Inputs
            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;
                alignment: end;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: MaterialStyleMetrics.spacing_4;

                    MaterialText {
                        text: "TEXT COLOR";
                        style: MaterialTypography.label_medium;
                        color: MaterialPalette.primary;
                    }

                    TextField {
                        placeholder_text: "#FFFFFF";
                        text <=> root.fg_color_text;
                        accepted => { root.check_contrast(); }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    padding_bottom: 2px;

                    ToolActionButton {
                        text: "⇄";
                        clicked => {
                            root.swap_colors();
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: MaterialStyleMetrics.spacing_4;

                    MaterialText {
                        text: "BACKGROUND";
                        style: MaterialTypography.label_medium;
                        color: MaterialPalette.primary;
                    }

                    TextField {
                        placeholder_text: "#6750A4";
                        text <=> root.bg_color_text;
                        accepted => { root.check_contrast(); }
                    }
                }
            }

            // Live Preview Card
            MaterialText {
                text: "LIVE CONTRAST PREVIEW";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.primary;
            }

            OutlinedCard {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_12;

                    Rectangle {
                        background: root.bg_color;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        border_width: 1px;
                        border_color: MaterialPalette.outline_variant;
                        min_height: 100px;

                        VerticalLayout {
                            padding: MaterialStyleMetrics.padding_16;
                            spacing: MaterialStyleMetrics.spacing_8;
                            alignment: center;

                            MaterialText {
                                text: "Headline 18pt Large Text";
                                style: MaterialTypography.title_large;
                                color: root.fg_color;
                            }

                            MaterialText {
                                text: "The quick brown fox jumps over the lazy dog. Normal 14pt body text.";
                                style: MaterialTypography.body_medium;
                                color: root.fg_color;
                            }
                        }
                    }
                }
            }

            ToolActionButton {
                text: "Check Contrast Ratio";
                clicked => { root.check_contrast(); }
            }

            // Contrast Ratio & WCAG Score Card
            MaterialText {
                text: "WCAG 2.1 COMPLIANCE RESULTS";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.primary;
            }

            OutlinedCard {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_12;

                    Rectangle {
                        background: MaterialPalette.surface_container;
                        border_radius: MaterialStyleMetrics.border_radius_4;

                        VerticalLayout {
                            padding: MaterialStyleMetrics.padding_16;
                            spacing: MaterialStyleMetrics.spacing_12;

                            HorizontalLayout {
                                alignment: space-between;
                                MaterialText {
                                    text: "Contrast Ratio";
                                    style: MaterialTypography.title_medium;
                                    color: MaterialPalette.on_surface;
                                }
                                MaterialText {
                                    text: root.ratio_text;
                                    style: MaterialTypography.title_large;
                                    color: MaterialPalette.primary;
                                }
                            }

                            // AA Normal
                            HorizontalLayout {
                                alignment: space-between;
                                MaterialText {
                                    text: "AA Normal Text (≥ 4.5:1)";
                                    style: MaterialTypography.body_medium;
                                    color: MaterialPalette.on_surface_variant;
                                }
                                Rectangle {
                                    border_radius: MaterialStyleMetrics.border_radius_4;
                                    background: root.aa_normal_pass ? #1b5e20 : #b71c1c;
                                    HorizontalLayout {
                                        padding_left: 8px;
                                        padding_right: 8px;
                                        padding_top: 2px;
                                        padding_bottom: 2px;
                                        MaterialText {
                                            text: root.aa_normal_pass ? "PASS" : "FAIL";
                                            style: MaterialTypography.label_medium;
                                            color: #ffffff;
                                        }
                                    }
                                }
                            }

                            // AA Large
                            HorizontalLayout {
                                alignment: space-between;
                                MaterialText {
                                    text: "AA Large Text (≥ 3.0:1)";
                                    style: MaterialTypography.body_medium;
                                    color: MaterialPalette.on_surface_variant;
                                }
                                Rectangle {
                                    border_radius: MaterialStyleMetrics.border_radius_4;
                                    background: root.aa_large_pass ? #1b5e20 : #b71c1c;
                                    HorizontalLayout {
                                        padding_left: 8px;
                                        padding_right: 8px;
                                        padding_top: 2px;
                                        padding_bottom: 2px;
                                        MaterialText {
                                            text: root.aa_large_pass ? "PASS" : "FAIL";
                                            style: MaterialTypography.label_medium;
                                            color: #ffffff;
                                        }
                                    }
                                }
                            }

                            // AAA Normal
                            HorizontalLayout {
                                alignment: space-between;
                                MaterialText {
                                    text: "AAA Normal Text (≥ 7.0:1)";
                                    style: MaterialTypography.body_medium;
                                    color: MaterialPalette.on_surface_variant;
                                }
                                Rectangle {
                                    border_radius: MaterialStyleMetrics.border_radius_4;
                                    background: root.aaa_normal_pass ? #1b5e20 : #b71c1c;
                                    HorizontalLayout {
                                        padding_left: 8px;
                                        padding_right: 8px;
                                        padding_top: 2px;
                                        padding_bottom: 2px;
                                        MaterialText {
                                            text: root.aaa_normal_pass ? "PASS" : "FAIL";
                                            style: MaterialTypography.label_medium;
                                            color: #ffffff;
                                        }
                                    }
                                }
                            }

                            // AAA Large
                            HorizontalLayout {
                                alignment: space-between;
                                MaterialText {
                                    text: "AAA Large Text (≥ 4.5:1)";
                                    style: MaterialTypography.body_medium;
                                    color: MaterialPalette.on_surface_variant;
                                }
                                Rectangle {
                                    border_radius: MaterialStyleMetrics.border_radius_4;
                                    background: root.aaa_large_pass ? #1b5e20 : #b71c1c;
                                    HorizontalLayout {
                                        padding_left: 8px;
                                        padding_right: 8px;
                                        padding_top: 2px;
                                        padding_bottom: 2px;
                                        MaterialText {
                                            text: root.aaa_large_pass ? "PASS" : "FAIL";
                                            style: MaterialTypography.label_medium;
                                            color: #ffffff;
                                        }
                                    }
                                }
                            }

                            // UI Components
                            HorizontalLayout {
                                alignment: space-between;
                                MaterialText {
                                    text: "UI Components (≥ 3.0:1)";
                                    style: MaterialTypography.body_medium;
                                    color: MaterialPalette.on_surface_variant;
                                }
                                Rectangle {
                                    border_radius: MaterialStyleMetrics.border_radius_4;
                                    background: root.ui_components_pass ? #1b5e20 : #b71c1c;
                                    HorizontalLayout {
                                        padding_left: 8px;
                                        padding_right: 8px;
                                        padding_top: 2px;
                                        padding_bottom: 2px;
                                        MaterialText {
                                            text: root.ui_components_pass ? "PASS" : "FAIL";
                                            style: MaterialTypography.label_medium;
                                            color: #ffffff;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
