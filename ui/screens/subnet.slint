import { Icons, TextField, OutlinedCard, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText } from "@material";
import { TopBar } from "../components/top-bar.slint";

export component SubnetScreen inherits VerticalLayout {
    callback back();

    property <bool> is_entered: false;
    init => { self.is_entered = true; }

    TopBar {
        title: "Subnet Calculator";
        has_back: true;
        show_background: true;
        back => { root.back(); }
    }

    ScrollView {
        vertical-stretch: 1;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate opacity {
            duration: 200ms;
            delay: 150ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding: MaterialStyleMetrics.padding_16;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            HorizontalLayout {
                alignment: center;
                MaterialText {
                    text: "Coming soon";
                    style: MaterialTypography.label_large;
                    color: MaterialPalette.on_surface_variant;
                }
            }

            MaterialText {
                text: "NETWORK INPUT";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            TextField {
                label: "IP Address / CIDR (e.g. 192.168.1.1/24)";
                enabled: false;
            }

            MaterialText {
                text: "NETWORK DETAILS";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            OutlinedCard {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_8;

                    MaterialText {
                        text: "Netmask: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Network Address: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Broadcast Address: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Usable Host Range: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Total Usable Hosts: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                }
            }
        }
    }
}
