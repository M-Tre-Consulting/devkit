import { AppBar, Icons, TextField, OutlinedCard, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText } from "@material";

export component SubnetScreen inherits VerticalLayout {
    callback back();

    AppBar {
        title: "Subnet Calculator";
        show_background: true;
        leading_button: {
            icon: Icons.arrow_back,
            tooltip: "Back",
            enabled: true
        };
        leading_button_clicked => {
            root.back();
        }
    }

    ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            padding: MaterialStyleMetrics.padding_16;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            HorizontalLayout {
                alignment: center;
                MaterialText {
                    text: "Coming soon";
                    style: MaterialTypography.label_large;
                    color: MaterialPalette.on_surface_variant;
                }
            }

            MaterialText {
                text: "NETWORK INPUT";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            TextField {
                label: "IP Address / CIDR (e.g. 192.168.1.1/24)";
                enabled: false;
            }

            MaterialText {
                text: "NETWORK DETAILS";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            OutlinedCard {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_8;

                    MaterialText {
                        text: "Netmask: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Network Address: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Broadcast Address: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Usable Host Range: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Total Usable Hosts: —";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                }
            }
        }
    }
}
