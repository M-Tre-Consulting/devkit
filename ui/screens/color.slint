import { Icons, TextField, OutlinedCard, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, Icon, StateLayerArea } from "@material";
import { TopBar } from "../components/top-bar.slint";
import { ToolErrorBanner } from "../components/tool-error-banner.slint";
import { ToolActionButton } from "../components/tool-action-button.slint";
import { ToolOutputArea } from "../components/tool-output-area.slint";
import { AppIcons } from "../components/app-icons.slint";

export component ColorScreen inherits VerticalLayout {
    in property <length> nav_bar_inset: 16px;
    callback back();
    callback convert();
    callback select_preset(string);
    callback copy(string);
    callback clear_input();

    in-out property <string> color_input: "#6750A4";
    in-out property <int> selected_format: 0; // 0=Auto, 1=Hex, 2=Rgb, 3=Hsl, 4=Hsv
    in-out property <color> preview_color: #6750a4;

    // Converted outputs
    in-out property <string> hex_output: "#6750A4";
    in-out property <string> rgb_output: "rgb(103, 80, 164)";
    in-out property <string> hsl_output: "hsl(256, 34%, 48%)";
    in-out property <string> hsv_output: "hsv(256, 51%, 64%)";
    in-out property <string> cmyk_output: "cmyk(37%, 51%, 0%, 36%)";
    in-out property <string> error_message: "";

    property <bool> is_entered: false;
    init => { self.is_entered = true; }

    TopBar {
        title: "Color Converter";
        has_back: true;
        show_background: true;
        back => { root.back(); }
    }

    ScrollView {
        vertical-stretch: 1;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate opacity {
            duration: 200ms;
            delay: 150ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding_left: MaterialStyleMetrics.padding_16;
            padding_right: MaterialStyleMetrics.padding_16;
            padding_top: MaterialStyleMetrics.padding_16;
            padding_bottom: 96px + root.nav_bar_inset;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            ToolErrorBanner {
                message: root.error_message;
            }

            // Live Preview Swatch Card
            MaterialText {
                text: "PREVIEW";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.primary;
            }

            OutlinedCard {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_12;

                    Rectangle {
                        height: 80px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.preview_color;
                        border_width: 1px;
                        border_color: MaterialPalette.outline_variant;

                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                background: #00000088;
                                border_radius: MaterialStyleMetrics.border_radius_4;
                                HorizontalLayout {
                                    padding_left: 12px;
                                    padding_right: 12px;
                                    padding_top: 4px;
                                    padding_bottom: 4px;
                                    MaterialText {
                                        text: root.hex_output;
                                        style: MaterialTypography.title_medium;
                                        color: #ffffff;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Presets
            VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                MaterialText {
                    text: "PALETTE PRESETS";
                    style: MaterialTypography.label_medium;
                    color: MaterialPalette.primary;
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_8;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.hex_output == "#6750A4" ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.hex_output == "#6750A4" ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => {
                                root.color_input = "#6750A4";
                                root.preview_color = #6750a4;
                                root.select_preset("#6750A4");
                            }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "Purple";
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.hex_output == "#2196F3" ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.hex_output == "#2196F3" ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => {
                                root.color_input = "#2196F3";
                                root.preview_color = #2196f3;
                                root.select_preset("#2196F3");
                            }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "Blue";
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.hex_output == "#009688" ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.hex_output == "#009688" ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => {
                                root.color_input = "#009688";
                                root.preview_color = #009688;
                                root.select_preset("#009688");
                            }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "Teal";
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.hex_output == "#FFC107" ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.hex_output == "#FFC107" ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => {
                                root.color_input = "#FFC107";
                                root.preview_color = #ffc107;
                                root.select_preset("#FFC107");
                            }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "Amber";
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Format Selection
            VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                MaterialText {
                    text: "INPUT FORMAT";
                    style: MaterialTypography.label_medium;
                    color: MaterialPalette.primary;
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_6;

                    // Auto
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 34px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.selected_format == 0 ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.selected_format == 0 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => { root.selected_format = 0; }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "Auto";
                                        style: MaterialTypography.label_small;
                                        color: root.selected_format == 0 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }

                    // HEX
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 34px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.selected_format == 1 ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.selected_format == 1 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => { root.selected_format = 1; }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "HEX";
                                        style: MaterialTypography.label_small;
                                        color: root.selected_format == 1 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }

                    // RGB
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 34px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.selected_format == 2 ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.selected_format == 2 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => { root.selected_format = 2; }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "RGB";
                                        style: MaterialTypography.label_small;
                                        color: root.selected_format == 2 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }

                    // HSL
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 34px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.selected_format == 3 ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.selected_format == 3 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => { root.selected_format = 3; }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "HSL";
                                        style: MaterialTypography.label_small;
                                        color: root.selected_format == 3 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }

                    // HSV
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 34px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.selected_format == 4 ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.selected_format == 4 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => { root.selected_format = 4; }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "HSV";
                                        style: MaterialTypography.label_small;
                                        color: root.selected_format == 4 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Input TextField
            MaterialText {
                text: "COLOR VALUE";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.primary;
            }

            TextField {
                placeholder_text: "e.g. #6750A4, rgb(103, 80, 164), hsl(256, 34%, 48%)";
                text <=> root.color_input;
                accepted => { root.convert(); }
            }

            ToolActionButton {
                text: "Convert Color";
                clicked => { root.convert(); }
            }

            // Converted Formats Outputs
            MaterialText {
                text: "CONVERTED FORMATS";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.primary;
            }

            ToolOutputArea {
                title: "HEX";
                text: root.hex_output;
                copy(val) => { root.copy(val); }
            }

            ToolOutputArea {
                title: "RGB";
                text: root.rgb_output;
                copy(val) => { root.copy(val); }
            }

            ToolOutputArea {
                title: "HSL";
                text: root.hsl_output;
                copy(val) => { root.copy(val); }
            }

            ToolOutputArea {
                title: "HSV";
                text: root.hsv_output;
                copy(val) => { root.copy(val); }
            }

            ToolOutputArea {
                title: "CMYK";
                text: root.cmyk_output;
                copy(val) => { root.copy(val); }
            }
        }
    }
}
