import { Icons, OutlinedCard, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, Icon, TextField, StateLayerArea } from "@material";
import { TopBar } from "../components/top-bar.slint";
import { ToolErrorBanner } from "../components/tool-error-banner.slint";
import { ToolActionButton } from "../components/tool-action-button.slint";
import { ToolOutputArea } from "../components/tool-output-area.slint";
import { AppIcons } from "../components/app-icons.slint";

export component ChmodScreen inherits VerticalLayout {
    callback back();
    callback calculate();
    callback apply_preset(string);
    callback apply_octal(string);
    callback copy(string);

    // Permission states
    in-out property <bool> owner_r: true;
    in-out property <bool> owner_w: true;
    in-out property <bool> owner_x: true;

    in-out property <bool> group_r: true;
    in-out property <bool> group_w: false;
    in-out property <bool> group_x: true;

    in-out property <bool> other_r: true;
    in-out property <bool> other_w: false;
    in-out property <bool> other_x: true;

    // Direct octal input
    in-out property <string> octal_input: "755";

    // Calculated outputs
    in-out property <string> octal_output: "0755";
    in-out property <string> symbolic_output: "-rwxr-xr-x";
    in-out property <string> command_output: "chmod 755 <file>";
    in-out property <string> error_message: "";

    property <bool> is_entered: false;
    init => { self.is_entered = true; }

    TopBar {
        title: "Chmod Calculator";
        has_back: true;
        show_background: true;
        back => { root.back(); }
    }

    ScrollView {
        vertical-stretch: 1;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate opacity {
            duration: 200ms;
            delay: 150ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding_left: MaterialStyleMetrics.padding_16;
            padding_right: MaterialStyleMetrics.padding_16;
            padding_top: MaterialStyleMetrics.padding_16;
            padding_bottom: 96px;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            ToolErrorBanner {
                message: root.error_message;
            }

            // Quick Presets
            VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                MaterialText {
                    text: "COMMON PRESETS";
                    style: MaterialTypography.label_medium;
                    color: MaterialPalette.primary;
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_8;

                    // 755
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.octal_output == "0755" || root.octal_output == "755" ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.octal_output == "0755" || root.octal_output == "755" ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => {
                                root.owner_r = true; root.owner_w = true; root.owner_x = true;
                                root.group_r = true; root.group_w = false; root.group_x = true;
                                root.other_r = true; root.other_w = false; root.other_x = true;
                                root.octal_output = "0755";
                                root.symbolic_output = "-rwxr-xr-x";
                                root.command_output = "chmod 755 <file>";
                                root.apply_preset("755");
                            }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "755 (Exec)";
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }

                    // 644
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.octal_output == "0644" || root.octal_output == "644" ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.octal_output == "0644" || root.octal_output == "644" ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => {
                                root.owner_r = true; root.owner_w = true; root.owner_x = false;
                                root.group_r = true; root.group_w = false; root.group_x = false;
                                root.other_r = true; root.other_w = false; root.other_x = false;
                                root.octal_output = "0644";
                                root.symbolic_output = "-rw-r--r--";
                                root.command_output = "chmod 644 <file>";
                                root.apply_preset("644");
                            }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "644 (File)";
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }

                    // 777
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.octal_output == "0777" || root.octal_output == "777" ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.octal_output == "0777" || root.octal_output == "777" ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => {
                                root.owner_r = true; root.owner_w = true; root.owner_x = true;
                                root.group_r = true; root.group_w = true; root.group_x = true;
                                root.other_r = true; root.other_w = true; root.other_x = true;
                                root.octal_output = "0777";
                                root.symbolic_output = "-rwxrwxrwx";
                                root.command_output = "chmod 777 <file>";
                                root.apply_preset("777");
                            }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "777 (Full)";
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }

                    // 600
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border_radius: MaterialStyleMetrics.border_radius_8;
                        background: root.octal_output == "0600" || root.octal_output == "600" ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.octal_output == "0600" || root.octal_output == "600" ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border_radius: parent.border_radius;
                            color: MaterialPalette.primary;
                            clicked => {
                                root.owner_r = true; root.owner_w = true; root.owner_x = false;
                                root.group_r = false; root.group_w = false; root.group_x = false;
                                root.other_r = false; root.other_w = false; root.other_x = false;
                                root.octal_output = "0600";
                                root.symbolic_output = "-rw-------";
                                root.command_output = "chmod 600 <file>";
                                root.apply_preset("600");
                            }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: "600 (Key)";
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Permission Matrix Grid Card
            MaterialText {
                text: "PERMISSION MATRIX";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.primary;
            }

            OutlinedCard {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_12;

                    // Table Header
                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;
                        MaterialText {
                            text: "SCOPE";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface_variant;
                            width: 70px;
                        }
                        MaterialText {
                            text: "Read (4)";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface_variant;
                            horizontal-stretch: 1;
                            horizontal_alignment: center;
                        }
                        MaterialText {
                            text: "Write (2)";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface_variant;
                            horizontal-stretch: 1;
                            horizontal_alignment: center;
                        }
                        MaterialText {
                            text: "Exec (1)";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface_variant;
                            horizontal-stretch: 1;
                            horizontal_alignment: center;
                        }
                    }

                    // Owner row
                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;
                        alignment: center;
                        MaterialText {
                            text: "Owner";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface;
                            width: 70px;
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border_radius: 6px;
                                background: root.owner_r ? MaterialPalette.primary : MaterialPalette.surface_container;
                                border_width: 1px;
                                border_color: root.owner_r ? MaterialPalette.primary : MaterialPalette.outline;
                                StateLayerArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.owner_r = !root.owner_r; root.calculate(); }
                                    if root.owner_r : Icon {
                                        source: Icons.check;
                                        colorize: MaterialPalette.on_primary;
                                        width: 18px;
                                        height: 18px;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border_radius: 6px;
                                background: root.owner_w ? MaterialPalette.primary : MaterialPalette.surface_container;
                                border_width: 1px;
                                border_color: root.owner_w ? MaterialPalette.primary : MaterialPalette.outline;
                                StateLayerArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.owner_w = !root.owner_w; root.calculate(); }
                                    if root.owner_w : Icon {
                                        source: Icons.check;
                                        colorize: MaterialPalette.on_primary;
                                        width: 18px;
                                        height: 18px;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border_radius: 6px;
                                background: root.owner_x ? MaterialPalette.primary : MaterialPalette.surface_container;
                                border_width: 1px;
                                border_color: root.owner_x ? MaterialPalette.primary : MaterialPalette.outline;
                                StateLayerArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.owner_x = !root.owner_x; root.calculate(); }
                                    if root.owner_x : Icon {
                                        source: Icons.check;
                                        colorize: MaterialPalette.on_primary;
                                        width: 18px;
                                        height: 18px;
                                    }
                                }
                            }
                        }
                    }

                    // Group row
                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;
                        alignment: center;
                        MaterialText {
                            text: "Group";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface;
                            width: 70px;
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border_radius: 6px;
                                background: root.group_r ? MaterialPalette.primary : MaterialPalette.surface_container;
                                border_width: 1px;
                                border_color: root.group_r ? MaterialPalette.primary : MaterialPalette.outline;
                                StateLayerArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.group_r = !root.group_r; root.calculate(); }
                                    if root.group_r : Icon {
                                        source: Icons.check;
                                        colorize: MaterialPalette.on_primary;
                                        width: 18px;
                                        height: 18px;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border_radius: 6px;
                                background: root.group_w ? MaterialPalette.primary : MaterialPalette.surface_container;
                                border_width: 1px;
                                border_color: root.group_w ? MaterialPalette.primary : MaterialPalette.outline;
                                StateLayerArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.group_w = !root.group_w; root.calculate(); }
                                    if root.group_w : Icon {
                                        source: Icons.check;
                                        colorize: MaterialPalette.on_primary;
                                        width: 18px;
                                        height: 18px;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border_radius: 6px;
                                background: root.group_x ? MaterialPalette.primary : MaterialPalette.surface_container;
                                border_width: 1px;
                                border_color: root.group_x ? MaterialPalette.primary : MaterialPalette.outline;
                                StateLayerArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.group_x = !root.group_x; root.calculate(); }
                                    if root.group_x : Icon {
                                        source: Icons.check;
                                        colorize: MaterialPalette.on_primary;
                                        width: 18px;
                                        height: 18px;
                                    }
                                }
                            }
                        }
                    }

                    // Others row
                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;
                        alignment: center;
                        MaterialText {
                            text: "Others";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface;
                            width: 70px;
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border_radius: 6px;
                                background: root.other_r ? MaterialPalette.primary : MaterialPalette.surface_container;
                                border_width: 1px;
                                border_color: root.other_r ? MaterialPalette.primary : MaterialPalette.outline;
                                StateLayerArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.other_r = !root.other_r; root.calculate(); }
                                    if root.other_r : Icon {
                                        source: Icons.check;
                                        colorize: MaterialPalette.on_primary;
                                        width: 18px;
                                        height: 18px;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border_radius: 6px;
                                background: root.other_w ? MaterialPalette.primary : MaterialPalette.surface_container;
                                border_width: 1px;
                                border_color: root.other_w ? MaterialPalette.primary : MaterialPalette.outline;
                                StateLayerArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.other_w = !root.other_w; root.calculate(); }
                                    if root.other_w : Icon {
                                        source: Icons.check;
                                        colorize: MaterialPalette.on_primary;
                                        width: 18px;
                                        height: 18px;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border_radius: 6px;
                                background: root.other_x ? MaterialPalette.primary : MaterialPalette.surface_container;
                                border_width: 1px;
                                border_color: root.other_x ? MaterialPalette.primary : MaterialPalette.outline;
                                StateLayerArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.other_x = !root.other_x; root.calculate(); }
                                    if root.other_x : Icon {
                                        source: Icons.check;
                                        colorize: MaterialPalette.on_primary;
                                        width: 18px;
                                        height: 18px;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Direct Octal Input Card
            MaterialText {
                text: "DIRECT OCTAL INPUT";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.primary;
            }

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_12;
                alignment: center;

                TextField {
                    horizontal-stretch: 1;
                    placeholder_text: "e.g. 755";
                    text <=> root.octal_input;
                    accepted => { root.apply_octal(root.octal_input); }
                }

                ToolActionButton {
                    text: "Apply";
                    clicked => { root.apply_octal(root.octal_input); }
                }
            }

            ToolActionButton {
                text: "Calculate Permissions";
                clicked => { root.calculate(); }
            }

            // Calculated Output Section
            MaterialText {
                text: "CALCULATED OUTPUT";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.primary;
            }

            ToolOutputArea {
                title: "Octal Notation";
                text: root.octal_output;
                copy(val) => { root.copy(val); }
            }

            ToolOutputArea {
                title: "Symbolic Notation";
                text: root.symbolic_output;
                copy(val) => { root.copy(val); }
            }

            ToolOutputArea {
                title: "Command";
                text: root.command_output;
                copy(val) => { root.copy(val); }
            }
        }
    }
}
