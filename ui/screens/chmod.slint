import { Icons, OutlinedCard, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, Icon, CheckBox, TextField, FilterChip } from "@material";
import { TopBar } from "../components/top-bar.slint";
import { AppIcons } from "../components/app-icons.slint";
import { ToolOutputArea, ToolActionButton, ToolErrorBanner } from "../components/tool-components.slint";

export component ChmodScreen inherits VerticalLayout {
    callback back();
    callback calculate();
    callback apply_preset(string);
    callback apply_octal(string);
    callback copy_value(string);

    // Permission states
    in-out property <bool> owner_r: true;
    in-out property <bool> owner_w: true;
    in-out property <bool> owner_x: true;

    in-out property <bool> group_r: true;
    in-out property <bool> group_w: false;
    in-out property <bool> group_x: true;

    in-out property <bool> other_r: true;
    in-out property <bool> other_w: false;
    in-out property <bool> other_x: true;

    // Direct octal input
    in-out property <string> octal_input: "755";

    // Calculated outputs
    in-out property <string> octal_output: "0755";
    in-out property <string> symbolic_output: "-rwxr-xr-x";
    in-out property <string> command_output: "chmod 755 <file>";
    in-out property <string> error_message: "";

    property <bool> is_entered: false;
    init => { self.is_entered = true; }

    TopBar {
        title: "Chmod Calculator";
        has_back: true;
        show_background: true;
        back => { root.back(); }
    }

    ScrollView {
        vertical-stretch: 1;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate opacity {
            duration: 200ms;
            delay: 150ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding: MaterialStyleMetrics.padding_16;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            ToolErrorBanner {
                error_message: root.error_message;
            }

            // Quick Presets
            VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                MaterialText {
                    text: "COMMON PRESETS";
                    style: MaterialTypography.label_medium;
                    color: MaterialPalette.primary;
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_8;

                    FilterChip {
                        text: "755 (Exec)";
                        selected: root.octal_output == "0755" || root.octal_output == "755";
                        clicked => { root.apply_preset("755"); }
                    }

                    FilterChip {
                        text: "644 (File)";
                        selected: root.octal_output == "0644" || root.octal_output == "644";
                        clicked => { root.apply_preset("644"); }
                    }

                    FilterChip {
                        text: "777 (Full)";
                        selected: root.octal_output == "0777" || root.octal_output == "777";
                        clicked => { root.apply_preset("777"); }
                    }

                    FilterChip {
                        text: "600 (Private)";
                        selected: root.octal_output == "0600" || root.octal_output == "600";
                        clicked => { root.apply_preset("600"); }
                    }
                }
            }

            // Permission Matrix Grid Card
            MaterialText {
                text: "PERMISSION MATRIX";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.primary;
            }

            OutlinedCard {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_12;

                    // Table Header
                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;
                        MaterialText {
                            text: "SCOPE";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface_variant;
                            width: 80px;
                        }
                        MaterialText {
                            text: "Read (4)";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface_variant;
                            horizontal-stretch: 1;
                            horizontal_alignment: center;
                        }
                        MaterialText {
                            text: "Write (2)";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface_variant;
                            horizontal-stretch: 1;
                            horizontal_alignment: center;
                        }
                        MaterialText {
                            text: "Exec (1)";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface_variant;
                            horizontal-stretch: 1;
                            horizontal_alignment: center;
                        }
                    }

                    // Owner row
                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;
                        alignment: center;
                        MaterialText {
                            text: "Owner";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface;
                            width: 80px;
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            CheckBox {
                                checked <=> root.owner_r;
                                toggled => { root.calculate(); }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            CheckBox {
                                checked <=> root.owner_w;
                                toggled => { root.calculate(); }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            CheckBox {
                                checked <=> root.owner_x;
                                toggled => { root.calculate(); }
                            }
                        }
                    }

                    // Group row
                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;
                        alignment: center;
                        MaterialText {
                            text: "Group";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface;
                            width: 80px;
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            CheckBox {
                                checked <=> root.group_r;
                                toggled => { root.calculate(); }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            CheckBox {
                                checked <=> root.group_w;
                                toggled => { root.calculate(); }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            CheckBox {
                                checked <=> root.group_x;
                                toggled => { root.calculate(); }
                            }
                        }
                    }

                    // Others row
                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;
                        alignment: center;
                        MaterialText {
                            text: "Others";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface;
                            width: 80px;
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            CheckBox {
                                checked <=> root.other_r;
                                toggled => { root.calculate(); }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            CheckBox {
                                checked <=> root.other_w;
                                toggled => { root.calculate(); }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            CheckBox {
                                checked <=> root.other_x;
                                toggled => { root.calculate(); }
                            }
                        }
                    }
                }
            }

            // Direct Octal Input Card
            MaterialText {
                text: "DIRECT OCTAL INPUT";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.primary;
            }

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_12;
                alignment: center;

                TextField {
                    horizontal-stretch: 1;
                    placeholder_text: "e.g. 755";
                    text <=> root.octal_input;
                    accepted => { root.apply_octal(root.octal_input); }
                }

                ToolActionButton {
                    text: "Apply";
                    primary: false;
                    clicked => { root.apply_octal(root.octal_input); }
                }
            }

            ToolActionButton {
                text: "Calculate Permissions";
                primary: true;
                clicked => { root.calculate(); }
            }

            // Calculated Output Section
            MaterialText {
                text: "CALCULATED OUTPUT";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.primary;
            }

            ToolOutputArea {
                label: "Octal Notation";
                value: root.octal_output;
                copy => { root.copy_value(root.octal_output); }
            }

            ToolOutputArea {
                label: "Symbolic Notation";
                value: root.symbolic_output;
                copy => { root.copy_value(root.symbolic_output); }
            }

            ToolOutputArea {
                label: "Command";
                value: root.command_output;
                copy => { root.copy_value(root.command_output); }
            }
        }
    }
}
