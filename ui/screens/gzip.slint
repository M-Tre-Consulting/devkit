import { Icons, TextField, OutlinedCard, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, Icon } from "@material";
import { TopBar } from "../components/top-bar.slint";
import { AppIcons } from "../components/app-icons.slint";

export component GzipScreen inherits VerticalLayout {
    callback back();

    property <bool> is_entered: false;
    property <bool> is_compress: true;
    init => { self.is_entered = true; }

    TopBar {
        title: "GZip Compressor";
        has_back: true;
        show_background: true;
        back => { root.back(); }
    }

    ScrollView {
        vertical-stretch: 1;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate opacity {
            duration: 200ms;
            delay: 150ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding: MaterialStyleMetrics.padding_16;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            HorizontalLayout {
                alignment: center;
                MaterialText {
                    text: "Coming soon";
                    style: MaterialTypography.label_large;
                    color: MaterialPalette.on_surface_variant;
                }
            }

            // Mode Toggle
            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;
                alignment: center;

                Rectangle {
                    background: MaterialPalette.surface_container;
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    height: 40px;

                    HorizontalLayout {
                        padding_left: MaterialStyleMetrics.padding_12;
                        padding_right: MaterialStyleMetrics.padding_12;
                        spacing: MaterialStyleMetrics.spacing_8;
                        alignment: center;

                        MaterialText {
                            text: root.is_compress ? "Mode: Compress (GZip)" : "Mode: Decompress (GZip)";
                            style: MaterialTypography.label_large;
                            color: MaterialPalette.primary;
                        }

                        Icon {
                            source: AppIcons.archive;
                            colorize: MaterialPalette.primary;
                            width: 20px;
                            height: 20px;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.is_compress = !root.is_compress;
                        }
                    }
                }
            }

            // Input section
            HorizontalLayout {
                alignment: space-between;
                MaterialText {
                    text: root.is_compress ? "RAW PAYLOAD / TEXT" : "COMPRESSED BYTES (BASE64)";
                    style: MaterialTypography.title_small;
                    color: MaterialPalette.primary;
                }
                MaterialText {
                    text: "Clear";
                    style: MaterialTypography.label_medium;
                    color: MaterialPalette.on_surface_variant;
                }
            }

            TextField {
                label: root.is_compress ? "Text or bytes to compress..." : "Base64 or hex gzipped string...";
                enabled: false;
            }

            // Output section
            HorizontalLayout {
                alignment: space-between;
                MaterialText {
                    text: root.is_compress ? "COMPRESSED ARCHIVE" : "DECOMPRESSED OUTPUT";
                    style: MaterialTypography.title_small;
                    color: MaterialPalette.primary;
                }
                MaterialText {
                    text: "Copy";
                    style: MaterialTypography.label_medium;
                    color: MaterialPalette.primary;
                }
            }

            OutlinedCard {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_12;

                    Rectangle {
                        background: MaterialPalette.surface_container;
                        border_radius: MaterialStyleMetrics.border_radius_4;
                        min_height: 90px;

                        VerticalLayout {
                            padding: MaterialStyleMetrics.padding_12;
                            alignment: start;

                            MaterialText {
                                text: root.is_compress ? "H4sICAAAAAAACjExLTYAAB... (gzip stream)" : "Original uncompressed content will appear here...";
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.on_surface_variant;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: MaterialStyleMetrics.spacing_4;

                        MaterialText {
                            text: "Compression ratio: —";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface_variant;
                        }
                        MaterialText {
                            text: "Original size: — bytes";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface_variant;
                        }
                        MaterialText {
                            text: "Compressed size: — bytes";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface_variant;
                        }
                    }
                }
            }
        }
    }
}
