import { Icons, TextField, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, StateLayerArea, Icon } from "@material";
import { TopBar } from "../components/top-bar.slint";
import { ToolErrorBanner } from "../components/tool-error-banner.slint";
import { ToolActionButton } from "../components/tool-action-button.slint";
import { ToolOutputArea } from "../components/tool-output-area.slint";
import { AppIcons } from "../components/app-icons.slint";

export component GzipScreen inherits VerticalLayout {
    in property <length> status_bar_inset: 24px;
    in property <length> nav_bar_inset: 16px;
    callback back();

    in-out property <string> input_data: "DevKit: A native Rust + Slint developer toolbox for Android.";
    in-out property <int> mode: 0; // 0=Compress, 1=Decompress
    in-out property <string> result_data: "H4sICAEw+VkCA2RldmtpdAA...";
    in-out property <string> original_size: "62 bytes";
    in-out property <string> processed_size: "38 bytes";
    in-out property <string> ratio: "38.7% reduction (0.61x)";
    in-out property <string> error_message: "";
    in-out property <bool> is_loading: false;

    callback process();
    callback clear();
    callback copy(string);

    property <bool> is_entered: false;
    init => { self.is_entered = true; }

    TopBar {
        title: "GZip Compressor";
        has_back: true;
        show_background: true;
        back => { root.back(); }
    }

    ScrollView {
        vertical-stretch: 1;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate opacity {
            duration: 200ms;
            delay: 150ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding_left: MaterialStyleMetrics.padding_16;
            padding_right: MaterialStyleMetrics.padding_16;
            padding_top: MaterialStyleMetrics.padding_16;
            padding_bottom: 96px + root.nav_bar_inset;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            ToolErrorBanner {
                message: root.error_message;
            }

            // Mode Selector
            MaterialText {
                text: "OPERATION MODE";
                style: MaterialTypography.label_large;
                color: MaterialPalette.primary;
            }

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    background: root.mode == 0 ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                    border_width: 1px;
                    border_color: root.mode == 0 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                    StateLayerArea {
                        width: 100%;
                        height: 100%;
                        border_radius: parent.border_radius;
                        color: MaterialPalette.primary;
                        clicked => { root.mode = 0; }
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                MaterialText {
                                    text: "Compress (GZip)";
                                    style: MaterialTypography.label_large;
                                    color: root.mode == 0 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    background: root.mode == 1 ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                    border_width: 1px;
                    border_color: root.mode == 1 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                    StateLayerArea {
                        width: 100%;
                        height: 100%;
                        border_radius: parent.border_radius;
                        color: MaterialPalette.primary;
                        clicked => { root.mode = 1; }
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                MaterialText {
                                    text: "Decompress";
                                    style: MaterialTypography.label_large;
                                    color: root.mode == 1 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                }
                            }
                        }
                    }
                }
            }

            // Input section
            MaterialText {
                text: root.mode == 0 ? "RAW TEXT INPUT" : "GZIP DATA INPUT (BASE64)";
                style: MaterialTypography.label_large;
                color: MaterialPalette.primary;
            }

            TextField {
                label: root.mode == 0 ? "Text to compress..." : "Base64 gzip stream to unpack...";
                text <=> root.input_data;
                enabled: !root.is_loading;
            }

            ToolActionButton {
                text: root.mode == 0 ? "Compress with GZip" : "Decompress Payload";
                enabled: root.input_data != "" && !root.is_loading;
                has_clear: true;
                clicked => { root.process(); }
                clear => {
                    root.input_data = "";
                    root.result_data = "";
                    root.original_size = "";
                    root.processed_size = "";
                    root.ratio = "";
                    root.error_message = "";
                    root.clear();
                }
            }

            // Result output
            ToolOutputArea {
                title: root.mode == 0 ? "COMPRESSED OUTPUT (BASE64)" : "DECOMPRESSED TEXT";
                text: root.result_data;
                is_code: true;
                copy(str) => { root.copy(str); }
            }

            // Compression statistics
            MaterialText {
                text: "SIZE & COMPRESSION STATISTICS";
                style: MaterialTypography.title_small;
                color: MaterialPalette.primary;
            }

            Rectangle {
                border_radius: MaterialStyleMetrics.border_radius_12;
                background: MaterialPalette.surface_container;
                border_width: 1px;
                border_color: MaterialPalette.outline_variant.with_alpha(15%);

                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_12;

                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_16;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: MaterialStyleMetrics.spacing_4;
                            MaterialText {
                                text: "Original Size";
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.on_surface_variant;
                            }
                            MaterialText {
                                text: root.original_size != "" ? root.original_size : "—";
                                style: MaterialTypography.body_medium;
                                color: MaterialPalette.on_surface;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: MaterialStyleMetrics.spacing_4;
                            MaterialText {
                                text: "Processed Size";
                                style: MaterialTypography.body_small;
                                color: MaterialPalette.on_surface_variant;
                            }
                            MaterialText {
                                text: root.processed_size != "" ? root.processed_size : "—";
                                style: MaterialTypography.body_medium;
                                color: MaterialPalette.on_surface;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: MaterialStyleMetrics.spacing_4;
                        MaterialText {
                            text: "Compression Efficiency";
                            style: MaterialTypography.body_small;
                            color: MaterialPalette.on_surface_variant;
                        }
                        MaterialText {
                            text: root.ratio != "" ? root.ratio : "—";
                            style: MaterialTypography.title_medium;
                            color: MaterialPalette.primary;
                        }
                    }
                }
            }
        }
    }
}
