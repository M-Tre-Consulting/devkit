import { Icons, TextField, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, StateLayerArea, Icon } from "@material";
import { TopBar } from "../components/top-bar.slint";
import { ToolErrorBanner } from "../components/tool-error-banner.slint";
import { ToolActionButton } from "../components/tool-action-button.slint";
import { ToolOutputArea } from "../components/tool-output-area.slint";
import { AppIcons } from "../components/app-icons.slint";

export component FormatterScreen inherits VerticalLayout {
    in property <length> status_bar_inset: 24px;
    in property <length> nav_bar_inset: 16px;
    callback back();

    in-out property <string> source_code: "{\"name\":\"DevKit\",\"version\":\"0.1.0\",\"status\":\"ready\"}";
    in-out property <int> selected_lang: 0; // 0: JSON, 1: YAML, 2: XML, 3: SQL, 4: TOML
    in-out property <int> indent_size: 2;
    in-out property <string> formatted_code: "{\n  \"name\": \"DevKit\",\n  \"version\": \"0.1.0\",\n  \"status\": \"ready\"\n}";
    in-out property <string> error_message: "";
    in-out property <bool> is_loading: false;

    callback format();
    callback clear();
    callback copy(string);

    property <bool> is_entered: false;
    init => { self.is_entered = true; }

    TopBar {
        title: "Code Formatter";
        has_back: true;
        show_background: true;
        back => { root.back(); }
    }

    ScrollView {
        vertical-stretch: 1;
        opacity: root.is_entered ? 1.0 : 0.0;

        animate opacity {
            duration: 200ms;
            delay: 150ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding_left: MaterialStyleMetrics.padding_16;
            padding_right: MaterialStyleMetrics.padding_16;
            padding_top: MaterialStyleMetrics.padding_16;
            padding_bottom: 96px + root.nav_bar_inset;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            ToolErrorBanner {
                message: root.error_message;
            }

            // Language Selector Chips
            MaterialText {
                text: "LANGUAGE";
                style: MaterialTypography.label_large;
                color: MaterialPalette.primary;
            }

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_6;

                // JSON
                Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    background: root.selected_lang == 0 ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                    border_width: 1px;
                    border_color: root.selected_lang == 0 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                    StateLayerArea {
                        width: 100%;
                        height: 100%;
                        border_radius: parent.border_radius;
                        color: MaterialPalette.primary;
                        clicked => { root.selected_lang = 0; }
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                MaterialText {
                                    text: "JSON";
                                    style: MaterialTypography.label_small;
                                    color: root.selected_lang == 0 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                }
                            }
                        }
                    }
                }

                // YAML
                Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    background: root.selected_lang == 1 ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                    border_width: 1px;
                    border_color: root.selected_lang == 1 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                    StateLayerArea {
                        width: 100%;
                        height: 100%;
                        border_radius: parent.border_radius;
                        color: MaterialPalette.primary;
                        clicked => { root.selected_lang = 1; }
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                MaterialText {
                                    text: "YAML";
                                    style: MaterialTypography.label_small;
                                    color: root.selected_lang == 1 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                }
                            }
                        }
                    }
                }

                // XML
                Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    background: root.selected_lang == 2 ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                    border_width: 1px;
                    border_color: root.selected_lang == 2 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                    StateLayerArea {
                        width: 100%;
                        height: 100%;
                        border_radius: parent.border_radius;
                        color: MaterialPalette.primary;
                        clicked => { root.selected_lang = 2; }
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                MaterialText {
                                    text: "XML";
                                    style: MaterialTypography.label_small;
                                    color: root.selected_lang == 2 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                }
                            }
                        }
                    }
                }

                // SQL
                Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    background: root.selected_lang == 3 ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                    border_width: 1px;
                    border_color: root.selected_lang == 3 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                    StateLayerArea {
                        width: 100%;
                        height: 100%;
                        border_radius: parent.border_radius;
                        color: MaterialPalette.primary;
                        clicked => { root.selected_lang = 3; }
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                MaterialText {
                                    text: "SQL";
                                    style: MaterialTypography.label_small;
                                    color: root.selected_lang == 3 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                }
                            }
                        }
                    }
                }

                // TOML
                Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    background: root.selected_lang == 4 ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                    border_width: 1px;
                    border_color: root.selected_lang == 4 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                    StateLayerArea {
                        width: 100%;
                        height: 100%;
                        border_radius: parent.border_radius;
                        color: MaterialPalette.primary;
                        clicked => { root.selected_lang = 4; }
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                MaterialText {
                                    text: "TOML";
                                    style: MaterialTypography.label_small;
                                    color: root.selected_lang == 4 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                }
                            }
                        }
                    }
                }
            }

            // Indentation
            MaterialText {
                text: "INDENTATION SPACES";
                style: MaterialTypography.label_large;
                color: MaterialPalette.primary;
            }

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    background: root.indent_size == 2 ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                    border_width: 1px;
                    border_color: root.indent_size == 2 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                    StateLayerArea {
                        width: 100%;
                        height: 100%;
                        border_radius: parent.border_radius;
                        color: MaterialPalette.primary;
                        clicked => { root.indent_size = 2; }
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                MaterialText {
                                    text: "2 Spaces";
                                    style: MaterialTypography.label_medium;
                                    color: root.indent_size == 2 ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    background: root.indent_size == 4 ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                    border_width: 1px;
                    border_color: root.indent_size == 4 ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(20%);

                    StateLayerArea {
                        width: 100%;
                        height: 100%;
                        border_radius: parent.border_radius;
                        color: MaterialPalette.primary;
                        clicked => { root.indent_size = 4; }
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                MaterialText {
                                    text: "4 Spaces";
                                    style: MaterialTypography.label_medium;
                                    color: root.indent_size == 4 ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
                                }
                            }
                        }
                    }
                }
            }

            // Unformatted Input
            MaterialText {
                text: "SOURCE CODE INPUT";
                style: MaterialTypography.label_large;
                color: MaterialPalette.primary;
            }

            TextField {
                label: "Paste unformatted or minified code here...";
                text <=> root.source_code;
                enabled: !root.is_loading;
            }

            ToolActionButton {
                text: "Format Code";
                enabled: root.source_code != "" && !root.is_loading;
                has_clear: true;
                clicked => { root.format(); }
                clear => {
                    root.source_code = "";
                    root.formatted_code = "";
                    root.error_message = "";
                    root.clear();
                }
            }

            // Formatted Output
            ToolOutputArea {
                title: "FORMATTED CODE OUTPUT";
                text: root.formatted_code;
                is_code: true;
                copy(str) => { root.copy(str); }
            }
        }
    }
}
