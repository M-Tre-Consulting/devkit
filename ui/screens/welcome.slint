import { Icons, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, StateLayerArea, Icon } from "@material";
import { AppIcons } from "../components/app-icons.slint";

export component WelcomeScreen inherits Rectangle {
    in property <length> status_bar_inset: 24px;
    in property <length> nav_bar_inset: 16px;
    in-out property <int> current_page: 0;

    callback finish();
    callback next();
    callback prev();

    background: MaterialPalette.surface;
    width: 100%;
    height: 100%;

    function go_next() {
        if root.current_page < 3 {
            root.current_page += 1;
            root.next();
        } else {
            root.finish();
        }
    }

    function go_back() {
        if root.current_page > 0 {
            root.current_page -= 1;
            root.prev();
        }
    }

    // Top action bar area (Skip button)
    top_bar := Rectangle {
        x: 0;
        y: root.status_bar_inset;
        width: 100%;
        height: 56px;
        z: 20;

        // Skip button (visible on pages 0, 1, 2)
        if root.current_page < 3 : Rectangle {
            x: parent.width - self.width - 16px;
            y: (parent.height - self.height) / 2;
            width: 72px;
            height: 36px;
            border_radius: 18px;

            StateLayerArea {
                width: 100%;
                height: 100%;
                border_radius: parent.border_radius;
                color: MaterialPalette.primary;

                clicked => {
                    root.finish();
                }

                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        MaterialText {
                            text: "Skip";
                            style: MaterialTypography.label_large;
                            color: MaterialPalette.primary;
                        }
                    }
                }
            }
        }
    }

    // Page Content Container
    page_viewport := Rectangle {
        x: 0;
        y: root.status_bar_inset + 56px;
        width: 100%;
        height: parent.height - (root.status_bar_inset + 56px) - (root.nav_bar_inset + 80px);
        clip: true;

        // Page 0: Welcome
        page_0 := Rectangle {
            x: (0 - root.current_page) * parent.width;
            width: parent.width;
            height: parent.height;
            opacity: root.current_page == 0 ? 1.0 : 0.0;
            visible: self.opacity > 0.01;

            animate x {
                duration: 320ms;
                easing: cubic-bezier(0.2, 0, 0, 1);
            }
            animate opacity {
                duration: 250ms;
                easing: ease-in-out;
            }

            VerticalLayout {
                alignment: center;
                spacing: MaterialStyleMetrics.spacing_16;
                padding_left: 28px;
                padding_right: 28px;

                // M-Tre Logo Lockup at the top of Page 1 ONLY
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Image {
                        source: AppIcons.mtre_logo;
                        width: 22px;
                        height: 22px;
                    }

                    MaterialText {
                        text: "M-Tre Consulting";
                        style: MaterialTypography.label_large;
                        color: MaterialPalette.primary;
                    }
                }

                // Primary Vector Illustration Container
                HorizontalLayout {
                    alignment: center;
                    padding_top: 12px;
                    padding_bottom: 12px;

                    Rectangle {
                        width: 120px;
                        height: 120px;
                        border_radius: 60px;
                        background: MaterialPalette.primary_container;

                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 96px;
                            height: 96px;
                            border_radius: 48px;
                            background: MaterialPalette.surface;
                            border_width: 2px;
                            border_color: MaterialPalette.primary.with_alpha(30%);

                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: AppIcons.wrench;
                                    colorize: MaterialPalette.primary;
                                    width: 48px;
                                    height: 48px;
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    alignment: center;

                    MaterialText {
                        text: "DevKit";
                        style: MaterialTypography.headline_large;
                        color: MaterialPalette.on_surface;
                        horizontal_alignment: center;
                    }

                    MaterialText {
                        text: "A developer toolbox in your pocket.";
                        style: MaterialTypography.title_medium;
                        color: MaterialPalette.primary;
                        horizontal_alignment: center;
                    }

                    MaterialText {
                        text: "All your essential everyday utilities—subnetting, hashing, encoding, regex, and tokens—crafted with 100% native Rust.";
                        style: MaterialTypography.body_large;
                        color: MaterialPalette.on_surface_variant;
                        horizontal_alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Page 1: The Tools
        page_1 := Rectangle {
            x: (1 - root.current_page) * parent.width;
            width: parent.width;
            height: parent.height;
            opacity: root.current_page == 1 ? 1.0 : 0.0;
            visible: self.opacity > 0.01;

            animate x {
                duration: 320ms;
                easing: cubic-bezier(0.2, 0, 0, 1);
            }
            animate opacity {
                duration: 250ms;
                easing: ease-in-out;
            }

            VerticalLayout {
                alignment: center;
                spacing: MaterialStyleMetrics.spacing_16;
                padding_left: 28px;
                padding_right: 28px;

                // Composed Tools Icon Grid Collage
                HorizontalLayout {
                    alignment: center;
                    padding_top: 8px;
                    padding_bottom: 8px;

                    Rectangle {
                        width: 220px;
                        height: 140px;
                        border_radius: 24px;
                        background: MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: MaterialPalette.outline_variant.with_alpha(20%);

                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            padding: 16px;

                            // Row 1
                            HorizontalLayout {
                                alignment: center;
                                spacing: 14px;

                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border_radius: 14px;
                                    background: MaterialPalette.primary_container;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon { source: AppIcons.lan; colorize: MaterialPalette.on_primary_container; width: 24px; height: 24px; }
                                    }
                                }

                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border_radius: 14px;
                                    background: MaterialPalette.secondary_container;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon { source: AppIcons.fingerprint; colorize: MaterialPalette.on_secondary_container; width: 24px; height: 24px; }
                                    }
                                }

                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border_radius: 14px;
                                    background: MaterialPalette.tertiary_container;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon { source: AppIcons.swap; colorize: MaterialPalette.on_tertiary_container; width: 24px; height: 24px; }
                                    }
                                }
                            }

                            // Row 2
                            HorizontalLayout {
                                alignment: center;
                                spacing: 14px;

                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border_radius: 14px;
                                    background: MaterialPalette.secondary_container;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon { source: AppIcons.regex; colorize: MaterialPalette.on_secondary_container; width: 24px; height: 24px; }
                                    }
                                }

                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border_radius: 14px;
                                    background: MaterialPalette.primary_container;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon { source: AppIcons.lock; colorize: MaterialPalette.on_primary_container; width: 24px; height: 24px; }
                                    }
                                }

                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border_radius: 14px;
                                    background: MaterialPalette.tertiary_container;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon { source: AppIcons.code; colorize: MaterialPalette.on_tertiary_container; width: 24px; height: 24px; }
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    alignment: center;

                    MaterialText {
                        text: "Essential Tools";
                        style: MaterialTypography.headline_large;
                        color: MaterialPalette.on_surface;
                        horizontal_alignment: center;
                    }

                    MaterialText {
                        text: "Subnet, Hash, Base64, Regex, JWT & more.";
                        style: MaterialTypography.title_medium;
                        color: MaterialPalette.primary;
                        horizontal_alignment: center;
                    }

                    MaterialText {
                        text: "A comprehensive offline suite for network engineers and software developers, always instantly available.";
                        style: MaterialTypography.body_large;
                        color: MaterialPalette.on_surface_variant;
                        horizontal_alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Page 2: Expressive by Design
        page_2 := Rectangle {
            x: (2 - root.current_page) * parent.width;
            width: parent.width;
            height: parent.height;
            opacity: root.current_page == 2 ? 1.0 : 0.0;
            visible: self.opacity > 0.01;

            animate x {
                duration: 320ms;
                easing: cubic-bezier(0.2, 0, 0, 1);
            }
            animate opacity {
                duration: 250ms;
                easing: ease-in-out;
            }

            VerticalLayout {
                alignment: center;
                spacing: MaterialStyleMetrics.spacing_16;
                padding_left: 28px;
                padding_right: 28px;

                // Expressive Motion Illustration Container
                HorizontalLayout {
                    alignment: center;
                    padding_top: 12px;
                    padding_bottom: 12px;

                    Rectangle {
                        width: 260px;
                        height: 110px;
                        border_radius: 28px;
                        background: MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: MaterialPalette.outline_variant.with_alpha(20%);

                        // Mock floating pill nav bar - centered horizontally and vertically
                        mock_pill := Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 216px;
                            height: 48px;
                            border_radius: 24px;
                            background: MaterialPalette.surface_container_high;
                            border_width: 1px;
                            border_color: MaterialPalette.outline_variant.with_alpha(25%);
                            drop_shadow_blur: 16px;
                            drop_shadow_offset_y: 4px;
                            drop_shadow_color: MaterialPalette.shadow_30;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;
                                padding_left: 6px;
                                padding_right: 12px;

                                // Active Home Item (Capsule with Icon + Label matching real pill)
                                Rectangle {
                                    height: 36px;
                                    border_radius: 18px;
                                    background: MaterialPalette.secondary_container;

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        padding_left: 10px;
                                        padding_right: 12px;

                                        VerticalLayout {
                                            alignment: center;
                                            Icon {
                                                source: AppIcons.home;
                                                colorize: MaterialPalette.on_secondary_container;
                                                width: 18px;
                                                height: 18px;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            MaterialText {
                                                text: "Home";
                                                style: MaterialTypography.label_medium;
                                                color: MaterialPalette.on_secondary_container;
                                            }
                                        }
                                    }
                                }

                                // Inactive icons centered vertically
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: AppIcons.history;
                                        colorize: MaterialPalette.on_surface_variant;
                                        width: 18px;
                                        height: 18px;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: AppIcons.star;
                                        colorize: MaterialPalette.on_surface_variant;
                                        width: 18px;
                                        height: 18px;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: AppIcons.settings;
                                        colorize: MaterialPalette.on_surface_variant;
                                        width: 18px;
                                        height: 18px;
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    alignment: center;

                    MaterialText {
                        text: "Expressive by Design";
                        style: MaterialTypography.headline_large;
                        color: MaterialPalette.on_surface;
                        horizontal_alignment: center;
                    }

                    MaterialText {
                        text: "Built with Rust and Slint. Designed to feel native.";
                        style: MaterialTypography.title_medium;
                        color: MaterialPalette.primary;
                        horizontal_alignment: center;
                    }

                    MaterialText {
                        text: "Fluid physics-based springs, dynamic color theming, and an edge-to-edge floating navigation pill.";
                        style: MaterialTypography.body_large;
                        color: MaterialPalette.on_surface_variant;
                        horizontal_alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Page 3: Get Started
        page_3 := Rectangle {
            x: (3 - root.current_page) * parent.width;
            width: parent.width;
            height: parent.height;
            opacity: root.current_page == 3 ? 1.0 : 0.0;
            visible: self.opacity > 0.01;

            animate x {
                duration: 320ms;
                easing: cubic-bezier(0.2, 0, 0, 1);
            }
            animate opacity {
                duration: 250ms;
                easing: ease-in-out;
            }

            VerticalLayout {
                alignment: center;
                spacing: MaterialStyleMetrics.spacing_16;
                padding_left: 28px;
                padding_right: 28px;

                // Launch / Ready Vector Illustration
                HorizontalLayout {
                    alignment: center;
                    padding_top: 12px;
                    padding_bottom: 12px;

                    Rectangle {
                        width: 120px;
                        height: 120px;
                        border_radius: 60px;
                        background: MaterialPalette.primary_container;

                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 96px;
                            height: 96px;
                            border_radius: 48px;
                            background: MaterialPalette.surface;
                            border_width: 2px;
                            border_color: MaterialPalette.primary.with_alpha(30%);

                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: AppIcons.star;
                                    colorize: MaterialPalette.primary;
                                    width: 48px;
                                    height: 48px;
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    alignment: center;

                    MaterialText {
                        text: "Ready to Build";
                        style: MaterialTypography.headline_large;
                        color: MaterialPalette.on_surface;
                        horizontal_alignment: center;
                    }

                    MaterialText {
                        text: "Your daily developer companion.";
                        style: MaterialTypography.title_medium;
                        color: MaterialPalette.primary;
                        horizontal_alignment: center;
                    }

                    MaterialText {
                        text: "Completely private, ultra-fast, and built for modern Android. Tap below to explore your tools.";
                        style: MaterialTypography.body_large;
                        color: MaterialPalette.on_surface_variant;
                        horizontal_alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // Bottom Navigation Bar Area
    bottom_bar := Rectangle {
        x: 0;
        y: parent.height - self.height - root.nav_bar_inset;
        width: 100%;
        height: 80px;
        z: 20;

        // Perfectly centered Page Indicator Dots (Pill indicator)
        indicator_container := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 72px;
            height: 8px;

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                // Dot 0
                Rectangle {
                    width: root.current_page == 0 ? 24px : 8px;
                    height: 8px;
                    border_radius: 4px;
                    background: root.current_page == 0 ? MaterialPalette.primary : MaterialPalette.on_surface_variant.with_alpha(30%);

                    animate width, background {
                        duration: 250ms;
                        easing: cubic-bezier(0.2, 0, 0, 1);
                    }
                }

                // Dot 1
                Rectangle {
                    width: root.current_page == 1 ? 24px : 8px;
                    height: 8px;
                    border_radius: 4px;
                    background: root.current_page == 1 ? MaterialPalette.primary : MaterialPalette.on_surface_variant.with_alpha(30%);

                    animate width, background {
                        duration: 250ms;
                        easing: cubic-bezier(0.2, 0, 0, 1);
                    }
                }

                // Dot 2
                Rectangle {
                    width: root.current_page == 2 ? 24px : 8px;
                    height: 8px;
                    border_radius: 4px;
                    background: root.current_page == 2 ? MaterialPalette.primary : MaterialPalette.on_surface_variant.with_alpha(30%);

                    animate width, background {
                        duration: 250ms;
                        easing: cubic-bezier(0.2, 0, 0, 1);
                    }
                }

                // Dot 3
                Rectangle {
                    width: root.current_page == 3 ? 24px : 8px;
                    height: 8px;
                    border_radius: 4px;
                    background: root.current_page == 3 ? MaterialPalette.primary : MaterialPalette.on_surface_variant.with_alpha(30%);

                    animate width, background {
                        duration: 250ms;
                        easing: cubic-bezier(0.2, 0, 0, 1);
                    }
                }
            }
        }

        // Left slot: Back Button (pages 1, 2, 3)
        if root.current_page > 0 : back_btn := Rectangle {
            x: 24px;
            y: (parent.height - self.height) / 2;
            width: 80px;
            height: 40px;
            border_radius: 20px;

            StateLayerArea {
                width: 100%;
                height: 100%;
                border_radius: parent.border_radius;
                color: MaterialPalette.on_surface_variant;

                clicked => {
                    root.go_back();
                }

                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        MaterialText {
                            text: "Back";
                            style: MaterialTypography.label_large;
                            color: MaterialPalette.on_surface_variant;
                        }
                    }
                }
            }
        }

        // Right slot: Next or Get Started Button
        next_btn := Rectangle {
            x: parent.width - self.width - 24px;
            y: (parent.height - self.height) / 2;
            width: root.current_page == 3 ? 130px : 80px;
            height: 40px;
            border_radius: 20px;
            background: MaterialPalette.primary;

            StateLayerArea {
                width: 100%;
                height: 100%;
                border_radius: parent.border_radius;
                color: MaterialPalette.on_primary;

                clicked => {
                    root.go_next();
                }

                HorizontalLayout {
                    alignment: center;
                    padding_left: 16px;
                    padding_right: 16px;
                    VerticalLayout {
                        alignment: center;
                        MaterialText {
                            text: root.current_page == 3 ? "Get Started" : "Next";
                            style: MaterialTypography.label_large;
                            color: MaterialPalette.on_primary;
                        }
                    }
                }
            }
        }
    }
}
