import { Icons, ScrollView, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, Icon } from "@material";
import { ToolCard } from "../components/tool-card.slint";
import { SectionHeader } from "../components/section-header.slint";
import { AppIcons } from "../components/app-icons.slint";
import { TopBar } from "../components/top-bar.slint";

export component FavoritesScreen inherits VerticalLayout {
    in property <bool> is_wide: root.width >= 600px;
    in property <length> status_bar_inset: 24px;
    in property <length> nav_bar_inset: 16px;
    in property <length> pill_height: 56px;
    in property <length> pill_bottom_margin: 28px;
    property <length> bottom_clearance: root.pill_height + root.pill_bottom_margin + root.nav_bar_inset + 24px;
    in property <[bool]> tool_favorites: [false, false, false, false, false, false, false, false, false, false, false, false, false, false, false];
    callback open_tool(int);
    callback toggle_favorite(int);

    property <bool> has_favorites: root.tool_favorites[1] || root.tool_favorites[2] || root.tool_favorites[3] || root.tool_favorites[4] || root.tool_favorites[5] || root.tool_favorites[6] || root.tool_favorites[7] || root.tool_favorites[8] || root.tool_favorites[9] || root.tool_favorites[10] || root.tool_favorites[11] || root.tool_favorites[12] || root.tool_favorites[13] || root.tool_favorites[14];

    // Status bar clearance
    Rectangle {
        height: root.status_bar_inset;
    }

    // Material 3 Small App Bar (56dp height, aligned on 28dp centerline)
    TopBar {
        title: "Favorites";
        has_back: false;
    }

    if !root.has_favorites : VerticalLayout {
        vertical-stretch: 1;
        alignment: center;
        padding_bottom: 80px;

        VerticalLayout {
            alignment: center;
            spacing: MaterialStyleMetrics.spacing_12;
            padding: MaterialStyleMetrics.padding_24;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 72px;
                    height: 72px;
                    border_radius: 36px;
                    background: MaterialPalette.surface_container_high;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Icon {
                                source: AppIcons.star_outline;
                                colorize: MaterialPalette.on_surface_variant.with_alpha(50%);
                                width: 36px;
                                height: 36px;
                            }
                        }
                    }
                }
            }

            MaterialText {
                text: "No favorites yet";
                style: MaterialTypography.title_large;
                color: MaterialPalette.on_surface;
                horizontal_alignment: center;
            }

            MaterialText {
                text: "Pin your most frequently used tools for one-tap access.";
                style: MaterialTypography.body_medium;
                color: MaterialPalette.on_surface_variant;
                horizontal_alignment: center;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    background: MaterialPalette.primary_container.with_alpha(35%);

                    HorizontalLayout {
                        padding_left: MaterialStyleMetrics.padding_12;
                        padding_right: MaterialStyleMetrics.padding_12;
                        padding_top: MaterialStyleMetrics.padding_8;
                        padding_bottom: MaterialStyleMetrics.padding_8;
                        spacing: 6px;
                        alignment: center;

                        Icon {
                            source: AppIcons.star;
                            colorize: #f59e0b;
                            width: 16px;
                            height: 16px;
                        }

                        MaterialText {
                            text: "Tap the star on any tool card in Home";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface;
                        }
                    }
                }
            }
        }
    }

    if root.has_favorites : ScrollView {
        vertical-stretch: 1;

        HorizontalLayout {
            alignment: center;
            width: 100%;

            VerticalLayout {
                max_width: 720px;
                width: 100%;
                padding_left: root.width >= 600px ? 24px : 16px;
                padding_right: root.width >= 600px ? 24px : 16px;
                padding_top: MaterialStyleMetrics.padding_8;
                padding_bottom: root.bottom_clearance;
                spacing: MaterialStyleMetrics.spacing_16;
                alignment: start;

            SectionHeader {
                title: "PINNED TOOLS";
            }

            VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_12;

                if root.tool_favorites[1] : ToolCard {
                    title: "Subnet Calculator";
                    description: "IPv4 CIDR, netmask & range";
                    icon: AppIcons.lan;
                    accent_color: #00897b;
                    is_favorite: true;
                    clicked => { root.open_tool(1); }
                    toggle_favorite => { root.toggle_favorite(1); }
                }

                if root.tool_favorites[2] : ToolCard {
                    title: "Hash Calculator";
                    description: "MD5, SHA-256 checksums";
                    icon: AppIcons.lock;
                    accent_color: #8e24aa;
                    is_favorite: true;
                    clicked => { root.open_tool(2); }
                    toggle_favorite => { root.toggle_favorite(2); }
                }

                if root.tool_favorites[3] : ToolCard {
                    title: "Base64";
                    description: "Encode & decode strings";
                    icon: AppIcons.code;
                    accent_color: #f4511e;
                    is_favorite: true;
                    clicked => { root.open_tool(3); }
                    toggle_favorite => { root.toggle_favorite(3); }
                }

                if root.tool_favorites[4] : ToolCard {
                    title: "UUID Generator";
                    description: "Generate unique identifiers";
                    icon: AppIcons.fingerprint;
                    accent_color: #2e7d32;
                    is_favorite: true;
                    clicked => { root.open_tool(4); }
                    toggle_favorite => { root.toggle_favorite(4); }
                }

                if root.tool_favorites[5] : ToolCard {
                    title: "Timestamp";
                    description: "Epoch & date conversions";
                    icon: AppIcons.timer;
                    accent_color: #1e88e5;
                    is_favorite: true;
                    clicked => { root.open_tool(5); }
                    toggle_favorite => { root.toggle_favorite(5); }
                }

                if root.tool_favorites[6] : ToolCard {
                    title: "Regex Tester";
                    description: "Evaluate pattern matches";
                    icon: AppIcons.regex;
                    accent_color: #d97706;
                    is_favorite: true;
                    clicked => { root.open_tool(6); }
                    toggle_favorite => { root.toggle_favorite(6); }
                }

                if root.tool_favorites[7] : ToolCard {
                    title: "JSON ↔ YAML";
                    description: "Convert between formats";
                    icon: AppIcons.swap;
                    accent_color: #0288d1;
                    is_favorite: true;
                    clicked => { root.open_tool(7); }
                    toggle_favorite => { root.toggle_favorite(7); }
                }

                if root.tool_favorites[8] : ToolCard {
                    title: "CRON Parser";
                    description: "Parse schedule syntax";
                    icon: AppIcons.schedule;
                    accent_color: #7b1fa2;
                    is_favorite: true;
                    clicked => { root.open_tool(8); }
                    toggle_favorite => { root.toggle_favorite(8); }
                }

                if root.tool_favorites[9] : ToolCard {
                    title: "GZip";
                    description: "Compress & decompress";
                    icon: AppIcons.archive;
                    accent_color: #c2185b;
                    is_favorite: true;
                    clicked => { root.open_tool(9); }
                    toggle_favorite => { root.toggle_favorite(9); }
                }

                if root.tool_favorites[10] : ToolCard {
                    title: "Code Formatter";
                    description: "Format code syntax";
                    icon: AppIcons.formatter;
                    accent_color: #0097a7;
                    is_favorite: true;
                    clicked => { root.open_tool(10); }
                    toggle_favorite => { root.toggle_favorite(10); }
                }

                if root.tool_favorites[11] : ToolCard {
                    title: "Chmod Calculator";
                    description: "Octal & symbolic bits";
                    icon: AppIcons.security;
                    accent_color: #388e3c;
                    is_favorite: true;
                    clicked => { root.open_tool(11); }
                    toggle_favorite => { root.toggle_favorite(11); }
                }

                if root.tool_favorites[12] : ToolCard {
                    title: "Color Converter";
                    description: "HEX, RGB, HSL values";
                    icon: AppIcons.palette;
                    accent_color: #f57c00;
                    is_favorite: true;
                    clicked => { root.open_tool(12); }
                    toggle_favorite => { root.toggle_favorite(12); }
                }

                if root.tool_favorites[13] : ToolCard {
                    title: "Contrast Checker";
                    description: "WCAG contrast ratio";
                    icon: AppIcons.contrast;
                    accent_color: #512da8;
                    is_favorite: true;
                    clicked => { root.open_tool(13); }
                    toggle_favorite => { root.toggle_favorite(13); }
                }

                if root.tool_favorites[14] : ToolCard {
                    title: "JWT Decoder";
                    description: "Decode headers & claims";
                    icon: AppIcons.key;
                    accent_color: #e64a19;
                    is_favorite: true;
                    clicked => { root.open_tool(14); }
                    toggle_favorite => { root.toggle_favorite(14); }
                }
            }
        }
    }
}
}
