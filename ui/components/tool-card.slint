import { Icon, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, StateLayerArea } from "@material";
import { AppIcons } from "./app-icons.slint";

export component ToolCard inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    in property <int> entrance_index: 0;
    in property <bool> is_entered: true;
    in property <bool> is_favorite: false;
    in property <color> accent_color: MaterialPalette.primary;

    callback clicked();
    callback toggle_favorite();

    min_height: 124px;

    // Staggered entrance animation
    property <float> enter_opacity: root.is_entered ? 1.0 : 0.0;
    property <length> enter_y_offset: root.is_entered ? 0px : 16px;

    animate enter_opacity {
        duration: 250ms;
        delay: root.entrance_index * 40ms;
        easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
    }
    animate enter_y_offset {
        duration: 250ms;
        delay: root.entrance_index * 40ms;
        easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
    }

    // Touch press scale animation (120ms in, 180ms out)
    property <float> press_scale: touch_area.pressed ? 0.97 : 1.0;
    animate press_scale {
        duration: touch_area.pressed ? 120ms : 180ms;
        easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
    }

    card_body := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + root.enter_y_offset;
        width: parent.width * root.press_scale;
        height: parent.height * root.press_scale;
        opacity: root.enter_opacity;
        border_radius: MaterialStyleMetrics.border_radius_16;
        background: MaterialPalette.surface_container_low;

        // Subtle outline for tonal contrast
        border_width: 1px;
        border_color: MaterialPalette.outline_variant.with_alpha(15%);

        touch_area := StateLayerArea {
            width: 100%;
            height: 100%;
            border_radius: parent.border_radius;
            color: MaterialPalette.on_surface;

            clicked => {
                root.clicked();
            }

            VerticalLayout {
                padding: MaterialStyleMetrics.padding_16;
                spacing: MaterialStyleMetrics.spacing_8;
                alignment: space-between;

                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border_radius: MaterialStyleMetrics.border_radius_12;
                        background: root.accent_color.with_alpha(18%);

                        Icon {
                            source: root.icon;
                            colorize: root.accent_color;
                            width: 24px;
                            height: 24px;
                        }
                    }
                }

                VerticalLayout {
                    spacing: MaterialStyleMetrics.spacing_4;

                    MaterialText {
                        text: root.title;
                        style: MaterialTypography.title_medium;
                        color: MaterialPalette.on_surface;
                        overflow: elide;
                    }

                    if root.description != "" : MaterialText {
                        text: root.description;
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                        overflow: elide;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Star favorite button in top-right corner
        star_btn := Rectangle {
            x: parent.width - self.width - 8px;
            y: 8px;
            width: 36px;
            height: 36px;
            border_radius: 18px;

            star_touch := StateLayerArea {
                width: 100%;
                height: 100%;
                border_radius: parent.border_radius;
                color: #f59e0b;

                clicked => {
                    root.toggle_favorite();
                }

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            source: root.is_favorite ? AppIcons.star : AppIcons.star_outline;
                            colorize: root.is_favorite ? #f59e0b : MaterialPalette.on_surface_variant.with_alpha(45%);
                            width: 22px;
                            height: 22px;

                            animate colorize {
                                duration: 150ms;
                                easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
                            }
                        }
                    }
                }
            }
        }
    }
}
