import { Icon, Icons, MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, StateLayerArea } from "@material";

export struct NavItem {
    icon: image,
    label: string,
}

export component PillNavBar inherits Rectangle {
    in property <[NavItem]> items;
    in property <int> active_index: 0;
    callback select(int);

    // Geometry parameters (Material 3 Expressive compact floating pill with active label)
    property <length> icon_width: 44px;
    property <length> extra_width: 56px;
    property <length> item_height: 44px;
    property <length> inner_padding: 4px;

    // Self-contained pill dimensions: wraps items in their resting layout
    width: root.items.length * root.icon_width + (root.active_index >= 0 ? root.extra_width : 0px) + root.inner_padding * 2;
    height: root.item_height + root.inner_padding * 2;
    border_radius: self.height / 2;
    background: MaterialPalette.surface_container_high.with_alpha(92%);

    // Material 3 elevation drop shadow for floating pill effect
    drop_shadow_blur: 16px;
    drop_shadow_offset_y: 4px;
    drop_shadow_color: MaterialPalette.shadow_30;

    // Subtle outline for tonal contrast against scrolling content
    border_width: 1px;
    border_color: MaterialPalette.outline_variant.with_alpha(20%);

    // Smoothly animate pill width if items or active state change
    animate width {
        duration: 280ms;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }

    // =========================================================================
    // Single Animated Moving Indicator Pill (Material 3 Emphasized Decelerate)
    // =========================================================================
    indicator := Rectangle {
        x: root.inner_padding + (root.active_index >= 0 ? root.active_index : 0) * root.icon_width;
        y: root.inner_padding;
        width: root.icon_width + (root.active_index >= 0 ? root.extra_width : 0px);
        height: root.item_height;
        border_radius: self.height / 2;
        background: MaterialPalette.secondary_container;
        visible: root.active_index >= 0;

        // Animate x and width together in a single animate block
        // Easing: cubic-bezier(0.2, 0, 0, 1) - Material 3 Emphasized Decelerate
        animate x, width {
            duration: 280ms;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }
    }

    // =========================================================================
    // Interactive Navigation Items Row
    // Inactive: Icon only (44px)
    // Active: Icon + Label side-by-side (44px + 56px = 100px)
    // =========================================================================
    items_row := HorizontalLayout {
        x: root.inner_padding;
        y: root.inner_padding;
        height: root.item_height;
        spacing: 0px;

        for item[index] in root.items : item_cell := Rectangle {
            property <bool> is_active: index == root.active_index;
            property <color> content_color: is_active ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;

            width: root.icon_width + (self.is_active ? root.extra_width : 0px);

            // Animate cell width to smoothly expand/collapse active item in lockstep with indicator
            animate width {
                duration: 280ms;
                easing: cubic-bezier(0.2, 0, 0, 1);
            }

            animate content_color {
                duration: 280ms;
                easing: cubic-bezier(0.2, 0, 0, 1);
            }

            touch_area := StateLayerArea {
                width: 100%;
                height: 100%;
                border_radius: self.height / 2;
                color: item_cell.content_color;

                clicked => {
                    root.select(index);
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    padding_left: 6px;
                    padding_right: 6px;

                    VerticalLayout {
                        alignment: center;

                        Icon {
                            source: item.icon;
                            width: touch_area.pressed ? 20px : 22px;
                            height: self.width;
                            colorize: item_cell.content_color;

                            animate width {
                                duration: 100ms;
                                easing: ease-out;
                            }
                        }
                    }

                    label_container := Rectangle {
                        clip: true;
                        width: item_cell.is_active ? (root.extra_width - 4px) : 0px;
                        opacity: item_cell.is_active ? 1.0 : 0.0;

                        // Synchronized width and opacity animations matching indicator exactly
                        animate width, opacity {
                            duration: 280ms;
                            easing: cubic-bezier(0.2, 0, 0, 1);
                        }

                        VerticalLayout {
                            alignment: center;
                            width: 100%;
                            height: 100%;

                            MaterialText {
                                text: item.label;
                                style: MaterialTypography.label_medium;
                                color: item_cell.content_color;
                                vertical_alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
