import { Icon, Icons, MaterialPalette, MaterialStyleMetrics, StateLayerArea } from "@material";

export struct NavItem {
    icon: image,
    label: string,
}

export component PillNavBar inherits Rectangle {
    in property <[NavItem]> items;
    in property <int> active_index: 0;
    callback select(int);

    // Geometry parameters (Material 3 Expressive compact floating pill)
    property <length> item_width: 56px;
    property <length> item_height: 48px;
    property <length> inner_padding: 4px;

    // Self-contained pill dimensions: wraps only its items
    width: root.items.length * root.item_width + root.inner_padding * 2;
    height: root.item_height + root.inner_padding * 2;
    border_radius: self.height / 2;
    background: MaterialPalette.surface_container_high.with_alpha(92%);

    // Material 3 elevation drop shadow for floating pill effect
    drop_shadow_blur: 16px;
    drop_shadow_offset_y: 4px;
    drop_shadow_color: MaterialPalette.shadow_30;

    // Subtle outline for tonal contrast against scrolling content
    border_width: 1px;
    border_color: MaterialPalette.outline_variant.with_alpha(20%);

    // =========================================================================
    // Single Animated Moving Indicator Pill (Material 3 Emphasized Decelerate)
    // =========================================================================
    indicator := Rectangle {
        x: root.inner_padding + (root.active_index >= 0 ? root.active_index : 0) * root.item_width;
        y: root.inner_padding;
        width: root.item_width;
        height: root.item_height;
        border_radius: self.height / 2;
        background: MaterialPalette.secondary_container;
        visible: root.active_index >= 0;

        // Animate x and width together in a single animate block
        // Easing: cubic-bezier(0.05, 0.7, 0.1, 1.0) - fast-out, gentle-in, 0 overshoot
        animate x, width {
            duration: 280ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }
    }

    // =========================================================================
    // Interactive Navigation Items Row (Icon-Only)
    // =========================================================================
    items_row := HorizontalLayout {
        x: root.inner_padding;
        y: root.inner_padding;
        width: root.items.length * root.item_width;
        height: root.item_height;

        for item[index] in root.items : item_cell := Rectangle {
            width: root.item_width;
            height: root.item_height;

            property <bool> is_active: index == root.active_index;
            property <color> icon_color: is_active ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;

            // Delayed color transition: starts 40ms after indicator slide begins
            animate icon_color {
                duration: 180ms;
                delay: 40ms;
                easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
            }

            touch_area := StateLayerArea {
                width: 100%;
                height: 100%;
                border_radius: self.height / 2;
                color: item_cell.icon_color;

                clicked => {
                    root.select(index);
                }

                HorizontalLayout {
                    alignment: center;

                    VerticalLayout {
                        alignment: center;

                        Icon {
                            source: item.icon;
                            width: touch_area.pressed ? 22px : 24px;
                            height: self.width;
                            colorize: item_cell.icon_color;

                            animate width {
                                duration: 100ms;
                                easing: ease-out;
                            }
                        }
                    }
                }
            }
        }
    }
}
