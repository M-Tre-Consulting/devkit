import { MaterialPalette, MaterialStyleMetrics, MaterialTypography, MaterialText, Icon, StateLayerArea } from "@material";
import { AppIcons } from "./app-icons.slint";

export component ToolActionButton inherits HorizontalLayout {
    in property <string> text: "Calculate";
    in property <bool> enabled: true;
    in property <bool> has_clear: true;
    callback clicked();
    callback clear();

    spacing: MaterialStyleMetrics.spacing_12;

    Rectangle {
        horizontal-stretch: 1;
        height: 48px;

        property <float> btn_scale: action_touch.pressed ? 0.98 : 1.0;
        animate btn_scale {
            duration: action_touch.pressed ? 80ms : 180ms;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }

        action_box := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width * parent.btn_scale;
            height: parent.height * parent.btn_scale;
            border_radius: MaterialStyleMetrics.shape_full;
            background: root.enabled ? MaterialPalette.primary : MaterialPalette.on_surface.with_alpha(12%);

            action_touch := StateLayerArea {
                width: 100%;
                height: 100%;
                border_radius: parent.border_radius;
                color: MaterialPalette.on_primary;
                clicked => {
                    if root.enabled {
                        root.clicked();
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        MaterialText {
                            text: root.text;
                            style: MaterialTypography.label_large;
                            color: root.enabled ? MaterialPalette.on_primary : MaterialPalette.on_surface_variant;
                        }
                    }
                }
            }
        }
    }

    if root.has_clear : Rectangle {
        width: 48px;
        height: 48px;

        property <float> clear_scale: clear_touch.pressed ? 0.98 : 1.0;
        animate clear_scale {
            duration: clear_touch.pressed ? 80ms : 180ms;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }

        clear_box := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width * parent.clear_scale;
            height: parent.height * parent.clear_scale;
            border_radius: MaterialStyleMetrics.shape_full;
            background: MaterialPalette.surface_container_high;

            clear_touch := StateLayerArea {
                width: 100%;
                height: 100%;
                border_radius: parent.border_radius;
                color: MaterialPalette.error;
                clicked => { root.clear(); }

                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            source: AppIcons.delete;
                            colorize: MaterialPalette.on_surface_variant;
                            width: 22px;
                            height: 22px;
                        }
                    }
                }
            }
        }
    }
}
