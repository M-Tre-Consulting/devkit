export global AppIcons {
    out property <image> home: @image-url("../icons/home.svg");
    out property <image> history: @image-url("../icons/history.svg");
    out property <image> star: @image-url("../icons/star.svg");
    out property <image> star_outline: @image-url("../icons/star_outline.svg");
    out property <image> settings: @image-url("../icons/settings.svg");
    out property <image> lan: @image-url("../icons/lan.svg");
    out property <image> lock: @image-url("../icons/lock.svg");
    out property <image> code: @image-url("../icons/code.svg");
    out property <image> fingerprint: @image-url("../icons/fingerprint.svg");
    out property <image> timer: @image-url("../icons/timer.svg");
    out property <image> regex: @image-url("../icons/regex.svg");
    out property <image> swap: @image-url("../icons/swap.svg");
    out property <image> schedule: @image-url("../icons/schedule.svg");
    out property <image> archive: @image-url("../icons/archive.svg");
    out property <image> formatter: @image-url("../icons/formatter.svg");
    out property <image> security: @image-url("../icons/security.svg");
    out property <image> palette: @image-url("../icons/palette.svg");
    out property <image> contrast: @image-url("../icons/contrast.svg");
    out property <image> key: @image-url("../icons/key.svg");
    out property <image> wrench: @image-url("../icons/wrench.svg");
    out property <image> copy: @image-url("../icons/copy.svg");
    out property <image> diff: @image-url("../icons/diff.svg");
    out property <image> qr_code: @image-url("../icons/qr_code.svg");
    out property <image> http: @image-url("../icons/http.svg");
    out property <image> radar: @image-url("../icons/radar.svg");
    out property <image> error: @image-url("../icons/error.svg");
    out property <image> delete: @image-url("../icons/delete.svg");
    out property <image> add: @image-url("../icons/add.svg");
    out property <image> search: @image-url("../icons/search.svg");
    out property <image> paste: @image-url("../icons/content_paste.svg");
    out property <image> close: @image-url("../icons/close.svg");
    out property <image> shield: @image-url("../icons/verified_user.svg");
    out property <image> sparkle: @image-url("../icons/auto_awesome.svg");
    out property <image> arrow_forward: @image-url("../icons/arrow_forward.svg");
    out property <image> mtre_logo: @image-url("../images/mtre-logo.png");

    /// Icon for a tool ID from the Rust catalog (src/catalog.rs).
    public pure function tool_icon(id: int) -> image {
        if id == 1 { return self.lan; }
        if id == 2 { return self.lock; }
        if id == 3 { return self.code; }
        if id == 4 { return self.fingerprint; }
        if id == 5 { return self.timer; }
        if id == 6 { return self.regex; }
        if id == 7 { return self.swap; }
        if id == 8 { return self.schedule; }
        if id == 9 { return self.archive; }
        if id == 10 { return self.formatter; }
        if id == 11 { return self.security; }
        if id == 12 { return self.palette; }
        if id == 13 { return self.contrast; }
        if id == 14 { return self.key; }
        if id == 15 { return self.diff; }
        if id == 16 { return self.qr_code; }
        if id == 17 { return self.http; }
        if id == 18 { return self.radar; }
        if id == 19 { return self.shield; }
        return self.wrench;
    }
}

/// Shared data model for a tool card (built in Rust from src/catalog.rs).
export struct ToolInfo {
    id: int,
    title: string,
    description: string,
    accent: int,
    is_favorite: bool,
}
