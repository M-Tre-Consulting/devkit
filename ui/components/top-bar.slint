import { Icons, MaterialPalette, MaterialTypography, MaterialText, StateLayerArea } from "@material";

export component TopBar inherits Rectangle {
    in property <string> title: "DevKit";
    in property <bool> has_back: false;
    in property <bool> has_action: false;
    in property <image> action_icon;
    in property <bool> show_background: false;
    callback back();
    callback action();

    height: 64px;
    background: Colors.transparent;

    HorizontalLayout {
        padding_left: root.has_back ? 4px : 16px;
        padding_right: 8px;
        spacing: 0px;

        // Leading slot: 48x48dp touch target, centered at Y = 32px
        if root.has_back : back_target := Rectangle {
            width: 48px;
            height: 48px;
            y: (parent.height - self.height) / 2;

            property <float> back_scale: touch_area.pressed ? 0.94 : 1.0;
            animate back_scale {
                duration: touch_area.pressed ? 80ms : 180ms;
                easing: cubic-bezier(0.2, 0, 0, 1);
            }

            touch_area := StateLayerArea {
                width: 48px;
                height: 48px;
                border_radius: 24px;
                color: MaterialPalette.on_surface;

                clicked => {
                    root.back();
                }

                // 24x24dp visible glyph centered inside 48dp tap target with spring press
                Image {
                    source: Icons.arrow_back;
                    width: 24px * back_target.back_scale;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: MaterialPalette.on_surface;
                }
            }
        }

        // Gap between leading button (or left edge) and title:
        if root.has_back : Rectangle {
            width: 8px;
        }

        // Title text: left-aligned, Material 3 headline_small typography
        title_box := Rectangle {
            horizontal_stretch: 1;
            height: 100%;

            MaterialText {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 100%;
                text: root.title;
                style: MaterialTypography.headline_small;
                color: MaterialPalette.on_surface;
                overflow: elide;
            }
        }

        // Trailing action slot: 48x48dp touch target
        if root.has_action : action_target := Rectangle {
            width: 48px;
            height: 48px;
            y: (parent.height - self.height) / 2;

            property <float> action_scale: action_touch.pressed ? 0.94 : 1.0;
            animate action_scale {
                duration: action_touch.pressed ? 80ms : 180ms;
                easing: cubic-bezier(0.2, 0, 0, 1);
            }

            action_touch := StateLayerArea {
                width: 48px;
                height: 48px;
                border_radius: 24px;
                color: MaterialPalette.on_surface_variant;

                clicked => {
                    root.action();
                }

                Image {
                    source: root.action_icon;
                    width: 24px * action_target.action_scale;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: MaterialPalette.on_surface_variant;
                }
            }
        }
    }
}
