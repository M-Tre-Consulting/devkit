import { NavigationBar, NavigationItem, Icons, MaterialPalette, MaterialTypography, MaterialText } from "@material";
import { HomeScreen } from "./screens/home.slint";
import { SubnetScreen } from "./screens/subnet.slint";
import { HashScreen } from "./screens/hash.slint";
export { MaterialWindowAdapter } from "@material";

export component AppWindow inherits Window {
    title: "DevKit";
    min_width: 360px;
    min_height: 640px;
    background: MaterialPalette.surface;

    in-out property <int> current_screen: 0;
    callback navigate(int);
    callback back();

    VerticalLayout {
        alignment: space-between;

        // Content Area
        VerticalLayout {
            vertical-stretch: 1;

            if root.current_screen == 0 : HomeScreen {
                open_tool(id) => {
                    root.navigate(id);
                }
            }

            if root.current_screen == 1 : SubnetScreen {
                back => {
                    root.back();
                }
            }

            if root.current_screen == 2 : HashScreen {
                back => {
                    root.back();
                }
            }

            if root.current_screen == 3 : VerticalLayout {
                alignment: center;
                MaterialText {
                    text: "Base64 Encoder";
                    style: MaterialTypography.headline_medium;
                    horizontal_alignment: center;
                }
            }

            if root.current_screen == 4 : VerticalLayout {
                alignment: center;
                MaterialText {
                    text: "UUID Generator";
                    style: MaterialTypography.headline_medium;
                    horizontal_alignment: center;
                }
            }

            if root.current_screen == 5 : VerticalLayout {
                alignment: center;
                MaterialText {
                    text: "Timestamp Converter";
                    style: MaterialTypography.headline_medium;
                    horizontal_alignment: center;
                }
            }

            if root.current_screen == 6 : VerticalLayout {
                alignment: center;
                MaterialText {
                    text: "Regex Tester";
                    style: MaterialTypography.headline_medium;
                    horizontal_alignment: center;
                }
            }
        }

        // Bottom Navigation Bar
        nav_bar := NavigationBar {
            current_index: root.current_screen <= 3 ? root.current_screen : -1;
            items: [
                {
                    icon: Icons.menu,
                    selected_icon: Icons.menu,
                    text: "Home",
                    show_badge: false,
                    badge: ""
                },
                {
                    icon: Icons.keyboard,
                    selected_icon: Icons.keyboard,
                    text: "Subnet",
                    show_badge: false,
                    badge: ""
                },
                {
                    icon: Icons.check,
                    selected_icon: Icons.check,
                    text: "Hash",
                    show_badge: false,
                    badge: ""
                },
                {
                    icon: Icons.schedule,
                    selected_icon: Icons.schedule,
                    text: "Time",
                    show_badge: false,
                    badge: ""
                },
            ];

            index_changed(index) => {
                if index == 3 {
                    root.navigate(5); // Timestamp
                } else {
                    root.navigate(index);
                }
            }
        }
    }
}
