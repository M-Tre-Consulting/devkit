import { Icons, MaterialPalette, MaterialTypography, MaterialText } from "@material";
import { HomeScreen } from "./screens/home.slint";
import { SubnetScreen } from "./screens/subnet.slint";
import { HashScreen } from "./screens/hash.slint";
import { Base64Screen } from "./screens/base64.slint";
import { UuidScreen } from "./screens/uuid.slint";
import { TimestampScreen } from "./screens/timestamp.slint";
import { RegexScreen } from "./screens/regex.slint";
import { PillNavBar } from "./components/pill-nav-bar.slint";
export { MaterialWindowAdapter } from "@material";

export component AppWindow inherits Window {
    title: "DevKit";
    min_width: 360px;
    min_height: 640px;
    background: MaterialPalette.surface;

    in-out property <int> current_screen: 0;
    callback navigate(int);
    callback back();

    // Content area filling the full window
    content_area := VerticalLayout {
        width: 100%;
        height: 100%;

        if root.current_screen == 0 : HomeScreen {
            open_tool(id) => {
                root.navigate(id);
            }
        }

        if root.current_screen == 1 : SubnetScreen {
            back => {
                root.back();
            }
        }

        if root.current_screen == 2 : HashScreen {
            back => {
                root.back();
            }
        }

        if root.current_screen == 3 : Base64Screen {
            back => {
                root.back();
            }
        }

        if root.current_screen == 4 : UuidScreen {
            back => {
                root.back();
            }
        }

        if root.current_screen == 5 : TimestampScreen {
            back => {
                root.back();
            }
        }

        if root.current_screen == 6 : RegexScreen {
            back => {
                root.back();
            }
        }
    }

    // Floating pill navigation bar anchored above the bottom edge
    pill_nav := PillNavBar {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 20px;
        active_index: root.current_screen == 0 ? 0 : root.current_screen == 1 ? 1 : root.current_screen == 2 ? 2 : root.current_screen == 5 ? 3 : -1;
        items: [
            { icon: Icons.menu, label: "Home" },
            { icon: Icons.keyboard, label: "Subnet" },
            { icon: Icons.check, label: "Hash" },
            { icon: Icons.schedule, label: "Time" },
        ];
        select(index) => {
            if index == 0 {
                root.navigate(0);
            } else if index == 1 {
                root.navigate(1);
            } else if index == 2 {
                root.navigate(2);
            } else if index == 3 {
                root.navigate(5); // Timestamp
            }
        }
    }
}
