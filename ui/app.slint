import { AboutScreen } from "screens/about.slint";
import { WelcomeScreen } from "screens/welcome.slint";
import { Icons, MaterialPalette, MaterialTypography, MaterialText, MaterialStyleMetrics } from "@material";
import { HomeScreen } from "./screens/home.slint";
import { RecentScreen } from "./screens/recent.slint";
import { FavoritesScreen } from "./screens/favorites.slint";
import { SettingsScreen } from "./screens/settings.slint";
import { SubnetScreen } from "./screens/subnet.slint";
import { HashScreen } from "./screens/hash.slint";
import { Base64Screen } from "./screens/base64.slint";
import { UuidScreen } from "./screens/uuid.slint";
import { TimestampScreen } from "./screens/timestamp.slint";
import { RegexScreen } from "./screens/regex.slint";
import { JsonYamlScreen } from "./screens/json-yaml.slint";
import { CronScreen } from "./screens/cron.slint";
import { GzipScreen } from "./screens/gzip.slint";
import { FormatterScreen } from "./screens/formatter.slint";
import { ChmodScreen } from "./screens/chmod.slint";
import { ColorScreen } from "./screens/color.slint";
import { ContrastScreen } from "./screens/contrast.slint";
import { JwtScreen } from "./screens/jwt.slint";
import { DiffScreen } from "./screens/diff.slint";
import { QrCodeScreen } from "./screens/qrcode.slint";
import { HttpClientScreen } from "./screens/http_client.slint";
import { LanScoutScreen, PortItem, HostItem } from "./screens/lan_scout.slint";
import { TlsScreen, TlsOutputResult, TlsCertItem } from "./screens/tls.slint";
import { PillNavBar } from "./components/pill-nav-bar.slint";
import { AppIcons, ToolInfo } from "./components/app-icons.slint";
import { SmartSuggestion } from "./screens/home.slint";
export { MaterialWindowAdapter } from "@material";
export { ToolInfo, SmartSuggestion, PortItem, HostItem, TlsOutputResult, TlsCertItem }

export struct SubnetResult {
    network_address: string,
    broadcast_address: string,
    first_host: string,
    last_host: string,
    host_count: string,
    netmask: string,
    wildcard_mask: string,
    cidr_notation: string,
    error_message: string,
}

export struct Base64Result {
    output_text: string,
    error_message: string,
}

export struct HashResult {
    hex_digest: string,
    base64_digest: string,
    error_message: string,
}

export struct UuidResult {
    uuids: [string],
    bulk_uuids: string,
    error_message: string,
}

export struct TimestampResult {
    input_value: string,
    unix_seconds: string,
    unix_millis: string,
    iso_8601: string,
    rfc_2822: string,
    human_readable: string,
    error_message: string,
}

export struct RegexResult {
    match_summary: string,
    matches_list: [string],
    error_message: string,
}

export struct JsonYamlResult {
    converted_text: string,
    error_message: string,
}

export struct CronResult {
    description: string,
    next_runs: [string],
    error_message: string,
}

export struct GzipResult {
    result_data: string,
    original_size: string,
    processed_size: string,
    ratio: string,
    error_message: string,
}

export struct FormatterResult {
    formatted_code: string,
    error_message: string,
}

export struct ChmodResult {
    octal_output: string,
    symbolic_output: string,
    command_output: string,
    error_message: string,
    has_matrix: bool,
    owner_r: bool,
    owner_w: bool,
    owner_x: bool,
    group_r: bool,
    group_w: bool,
    group_x: bool,
    other_r: bool,
    other_w: bool,
    other_x: bool,
}

export struct ColorResult {
    hex_output: string,
    rgb_output: string,
    hsl_output: string,
    hsv_output: string,
    cmyk_output: string,
    error_message: string,
}

export struct ContrastCheckResult {
    ratio_text: string,
    aa_normal_pass: bool,
    aa_large_pass: bool,
    aaa_normal_pass: bool,
    aaa_large_pass: bool,
    ui_components_pass: bool,
    error_message: string,
}

export struct JwtResult {
    header_json: string,
    payload_json: string,
    signature_output: string,
    algorithm: string,
    expiration_status: string,
    expiration_time: string,
    error_message: string,
}

export struct DiffOutputResult {
    additions: int,
    deletions: int,
    unchanged: int,
    unified_patch: string,
    error_message: string,
}

export struct QrOutputResult {
    qr_image: image,
    payload: string,
    totp_code: string,
    totp_remaining_secs: int,
    error_message: string,
}

export struct HttpOutputResult {
    status: int,
    status_text: string,
    latency_ms: int,
    ttfb_ms: int,
    size_bytes: int,
    headers: string,
    body: string,
    final_url: string,
    content_type: string,
    truncated: bool,
    error_message: string,
}

export struct TotpTick {
    code: string,
    remaining: int,
}

export struct HttpImportResult {
    method_idx: int,
    url: string,
    headers: string,
    body: string,
    error_message: string,
}

export struct LanScoutOutputResult {
    open_count: int,
    total_count: int,
    ports: [PortItem],
    open_ports: [PortItem],
    hosts: [HostItem],
    hosts_probed: int,
    error_message: string,
}

export component AppWindow inherits Window {
    title: "DevKit";
    min_width: 360px;
    min_height: 640px;
    background: MaterialPalette.surface;

    in-out property <int> current_mode: 0;
    in-out property <int> active_tool: 0;
    // Insets: prefer the live safe area reported by Slint (follows rotation / cutouts),
    // falling back to the values queried over JNI at startup.
    in property <length> status_bar_fallback: 0px;
    in property <length> nav_bar_fallback: 0px;
    out property <length> status_bar_inset: root.safe-area-insets.top > 0 ? root.safe-area-insets.top : root.status_bar_fallback;
    out property <length> nav_bar_inset: root.safe-area-insets.bottom > 0 ? root.safe-area-insets.bottom : root.nav_bar_fallback;
    property <length> pill_bottom_margin: 24px;
    // Driven natively (and animated) by Slint's IME insets: no polling needed.
    out property <length> keyboard_height: root.virtual-keyboard-size.height;
    out property <bool> keyboard_open: root.keyboard_height > 20px;
    in-out property <bool> modal_open: false;
    in-out property <bool> about_open: false;
    in-out property <bool> welcome_open: false;
    in-out property <int> welcome_page: 0;
    in-out property <bool> dark_theme_enabled <=> MaterialPalette.dark_color_scheme;
    in-out property <bool> dynamic_color_enabled <=> MaterialPalette.dynamic_color_enabled;
    in-out property <bool> has_monet <=> MaterialPalette.has_monet;
    in-out property <color> monet_primary_light <=> MaterialPalette.monet_primary_light;
    in-out property <color> monet_primary_dark <=> MaterialPalette.monet_primary_dark;
    in-out property <color> monet_primary_container_light <=> MaterialPalette.monet_primary_container_light;
    in-out property <color> monet_primary_container_dark <=> MaterialPalette.monet_primary_container_dark;
    in-out property <color> monet_secondary_light <=> MaterialPalette.monet_secondary_light;
    in-out property <color> monet_secondary_dark <=> MaterialPalette.monet_secondary_dark;
    in-out property <color> monet_secondary_container_light <=> MaterialPalette.monet_secondary_container_light;
    in-out property <color> monet_secondary_container_dark <=> MaterialPalette.monet_secondary_container_dark;
    in-out property <color> monet_tertiary_light <=> MaterialPalette.monet_tertiary_light;
    in-out property <color> monet_tertiary_dark <=> MaterialPalette.monet_tertiary_dark;
    in-out property <color> monet_surface_light <=> MaterialPalette.monet_surface_light;
    in-out property <color> monet_surface_dark <=> MaterialPalette.monet_surface_dark;
    in-out property <int> default_hash_algorithm: 2;
    in-out property <int> default_uuid_version: 1;
    in-out property <int> default_timestamp_format: 0;
    in-out property <int> graphics_backend: 0;
    in-out property <string> active_renderer: "";
    in-out property <bool> peak_refresh_enabled: false;

    // Tool lists (built in Rust from the catalog)
    in-out property <[ToolInfo]> home_tools: [];
    in-out property <[ToolInfo]> favorite_tools: [];
    in-out property <[ToolInfo]> recent_tools: [];
    in-out property <string> search_query: "";
    in-out property <[SmartSuggestion]> smart_suggestions: [];
    in-out property <string> smart_source: "";
    in-out property <string> paste_feedback: "";

    // Smart Paste prefill: a tool reacts when prefill_tool matches its id.
    in-out property <int> prefill_tool: 0;
    in-out property <string> prefill_text: "";
    in-out property <int> prefill_mode: 0;
    in-out property <int> prefill_seq: 0;

    // Network state, filled asynchronously from worker threads
    in-out property <string> detected_gateway: "192.168.0.1";
    in-out property <string> detected_device_ip: "127.0.0.1";
    in-out property <string> network_summary: "";
    in-out property <bool> http_busy: false;
    in-out property <HttpOutputResult> http_result;
    in-out property <bool> lan_busy: false;
    in-out property <string> lan_progress: "";
    in-out property <LanScoutOutputResult> lan_result;
    in-out property <bool> tls_busy: false;
    in-out property <TlsOutputResult> tls_result;

    // Live TOTP
    in-out property <string> totp_secret_active: "";
    in-out property <string> totp_live_code: "";
    in-out property <int> totp_live_remaining: 30;

    // Navigation and state callbacks
    callback switch_mode(int);
    callback open_tool(int);
    callback toggle_favorite(int);
    callback clear_recents();
    callback clear_favorites();
    callback open_about();
    callback dark_theme_changed(bool);
    callback dynamic_color_changed(bool);
    callback default_hash_algorithm_changed(int);
    callback default_uuid_version_changed(int);
    callback default_timestamp_format_changed(int);
    callback graphics_backend_changed(int);
    callback peak_refresh_changed(bool);
    callback dismiss_welcome();
    callback reset_welcome();
    callback back();
    callback handle_back() -> bool;
    callback copy_text(string);
    callback search_edited(string);
    callback clear_search();
    callback smart_paste();
    callback open_suggestion(int);
    callback open_tool_with(int, string);

    // Tool execution callbacks
    callback subnet-calculate(string) -> SubnetResult;
    callback hash-calculate(string, int) -> HashResult;
    callback base64-convert(string, bool, bool, bool) -> Base64Result;
    callback uuid-generate(int, int, bool, bool) -> UuidResult;
    callback timestamp-convert(string, int, string) -> TimestampResult;
    callback timestamp-now(int, string) -> TimestampResult;
    callback regex-test(string, string, bool, bool, bool) -> RegexResult;
    callback json-yaml-convert(string, bool, int) -> JsonYamlResult;
    callback cron-parse(string) -> CronResult;
    callback gzip-compress(string, bool) -> GzipResult;
    callback format-format(string, int, int) -> FormatterResult;
    callback chmod-apply(bool, bool, bool, bool, bool, bool, bool, bool, bool) -> ChmodResult;
    callback chmod-apply-octal(string) -> ChmodResult;
    callback color-convert(string, int) -> ColorResult;
    callback contrast-check(string, string) -> ContrastCheckResult;
    callback jwt-decode(string) -> JwtResult;
    callback diff-compare(string, string, bool) -> DiffOutputResult;
    callback qrcode-generate-text(string) -> QrOutputResult;
    callback qrcode-generate-wifi(string, string, int, bool) -> QrOutputResult;
    callback qrcode-generate-totp(string, string, string) -> QrOutputResult;
    callback http-send(int, string, string, string);
    callback http-import-curl(string) -> HttpImportResult;
    callback http-export-curl(int, string, string, string) -> string;
    callback lan-scout-scan(string, int, int, string);
    callback lan-scout-discover(int);
    callback refresh-network();
    callback tls-inspect(string);
    callback totp-tick(string) -> TotpTick;

    property <int> last_tool: 1;
    changed active_tool => {
        if root.active_tool > 0 {
            root.last_tool = root.active_tool;
        }
        back_focus.focus();
    }
    changed current_mode => {
        back_focus.focus();
    }

    init => {
        back_focus.focus();
    }

    property <bool> is_tool: root.active_tool > 0;
    // Keep the last tool alive while it slides out, then render it no more.
    property <int> displayed_tool: root.is_tool ? root.active_tool : root.last_tool;

    // Live TOTP countdown for the QR Studio (only ticks while that screen is open).
    Timer {
        interval: 1s;
        running: root.is_tool && root.active_tool == 16 && root.totp_secret_active != "";
        triggered => {
            let t = root.totp-tick(root.totp_secret_active);
            root.totp_live_code = t.code;
            root.totp_live_remaining = t.remaining;
        }
    }

    back_focus := FocusScope {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == Key.Back || event.text == Key.Escape {
                if root.handle_back() {
                    return accept;
                }
            }
            reject
        }

        key-released(event) => {
            if event.text == Key.Back || event.text == Key.Escape {
                if root.active_tool > 0 || root.current_mode != 0 || root.modal_open || (root.welcome_open && root.welcome_page > 0) {
                    return accept;
                }
            }
            reject
        }

        // Base layer: mode screens (0: Home, 1: Recent, 2: Favorites, 3: Settings).
        // Only opacity and a render transform are animated: animating width/height (as
        // before) re-ran layout for every card on every frame of the transition.
        mode_container := Rectangle {
            width: 100%;
            height: 100%;
            transform-scale: root.is_tool ? 0.96 : 1.0;
            opacity: root.is_tool ? 0.0 : 1.0;
            // Not rendered (nor hit-tested) under the opaque welcome flow.
            visible: self.opacity > 0.01 && !root.welcome_open;

            animate transform-scale, opacity {
                duration: 200ms;
                easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
            }

            screen_0 := Rectangle {
                property <bool> is_active: root.current_mode == 0;
                // The active screen is always on top, so during a cross-fade the outgoing
                // screen can never intercept taps meant for the incoming one.
                z: self.is_active ? 1 : 0;
                x: self.is_active ? 0px : (0 > root.current_mode ? 24px : -24px);
                opacity: self.is_active ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                width: 100%;
                height: 100%;

                animate x, opacity {
                    duration: self.is_active ? 260ms : 180ms;
                    easing: self.is_active ? cubic-bezier(0.05, 0.7, 0.1, 1.0) : cubic-bezier(0.3, 0, 0.8, 0.15);
                }

                HomeScreen {
                    status_bar_inset: root.status_bar_inset;
                    nav_bar_inset: root.nav_bar_inset;
                    pill_height: pill_nav.height;
                    pill_bottom_margin: root.pill_bottom_margin;
                    tools: root.home_tools;
                    search_query <=> root.search_query;
                    suggestions: root.smart_suggestions;
                    suggestion_source: root.smart_source;
                    paste_feedback: root.paste_feedback;
                    home-open-tool(id) => { root.open_tool(id); }
                    home-toggle-favorite(id) => { root.toggle_favorite(id); }
                    search-edited(text) => { root.search_edited(text); }
                    clear-search => { root.clear_search(); }
                    smart-paste => { root.smart_paste(); }
                    open-suggestion(i) => { root.open_suggestion(i); }
                }
            }

            screen_1 := Rectangle {
                property <bool> is_active: root.current_mode == 1;
                // The active screen is always on top, so during a cross-fade the outgoing
                // screen can never intercept taps meant for the incoming one.
                z: self.is_active ? 1 : 0;
                x: self.is_active ? 0px : (1 > root.current_mode ? 24px : -24px);
                opacity: self.is_active ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                width: 100%;
                height: 100%;

                animate x, opacity {
                    duration: self.is_active ? 260ms : 180ms;
                    easing: self.is_active ? cubic-bezier(0.05, 0.7, 0.1, 1.0) : cubic-bezier(0.3, 0, 0.8, 0.15);
                }

                RecentScreen {
                    status_bar_inset: root.status_bar_inset;
                    nav_bar_inset: root.nav_bar_inset;
                    pill_height: pill_nav.height;
                    pill_bottom_margin: root.pill_bottom_margin;
                    recent_tools: root.recent_tools;
                    recent-open-tool(id) => { root.open_tool(id); }
                    recent-toggle-favorite(id) => { root.toggle_favorite(id); }
                }
            }

            screen_2 := Rectangle {
                property <bool> is_active: root.current_mode == 2;
                // The active screen is always on top, so during a cross-fade the outgoing
                // screen can never intercept taps meant for the incoming one.
                z: self.is_active ? 1 : 0;
                x: self.is_active ? 0px : (2 > root.current_mode ? 24px : -24px);
                opacity: self.is_active ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                width: 100%;
                height: 100%;

                animate x, opacity {
                    duration: self.is_active ? 260ms : 180ms;
                    easing: self.is_active ? cubic-bezier(0.05, 0.7, 0.1, 1.0) : cubic-bezier(0.3, 0, 0.8, 0.15);
                }

                FavoritesScreen {
                    status_bar_inset: root.status_bar_inset;
                    nav_bar_inset: root.nav_bar_inset;
                    pill_height: pill_nav.height;
                    pill_bottom_margin: root.pill_bottom_margin;
                    favorite_tools: root.favorite_tools;
                    favorites-open-tool(id) => { root.open_tool(id); }
                    favorites-toggle-favorite(id) => { root.toggle_favorite(id); }
                }
            }

            screen_3 := Rectangle {
                property <bool> is_active: root.current_mode == 3;
                // The active screen is always on top, so during a cross-fade the outgoing
                // screen can never intercept taps meant for the incoming one.
                z: self.is_active ? 1 : 0;
                x: self.is_active ? 0px : (3 > root.current_mode ? 24px : -24px);
                opacity: self.is_active ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                width: 100%;
                height: 100%;

                animate x, opacity {
                    duration: self.is_active ? 260ms : 180ms;
                    easing: self.is_active ? cubic-bezier(0.05, 0.7, 0.1, 1.0) : cubic-bezier(0.3, 0, 0.8, 0.15);
                }

                SettingsScreen {
                    status_bar_inset: root.status_bar_inset;
                    nav_bar_inset: root.nav_bar_inset;
                    pill_height: pill_nav.height;
                    pill_bottom_margin: root.pill_bottom_margin;
                    dark_theme_enabled: root.dark_theme_enabled;
                    dynamic_color_enabled: root.dynamic_color_enabled;
                    default_hash_algorithm: root.default_hash_algorithm;
                    default_uuid_version: root.default_uuid_version;
                    default_timestamp_format: root.default_timestamp_format;
                    graphics_backend: root.graphics_backend;
                    active_renderer: root.active_renderer;
                    peak_refresh_enabled: root.peak_refresh_enabled;
                    settings-dark-theme-changed(enabled) => {
                        root.dark_theme_enabled = enabled;
                        root.dark_theme_changed(enabled);
                    }
                    settings-dynamic-color-changed(enabled) => {
                        root.dynamic_color_enabled = enabled;
                        root.dynamic_color_changed(enabled);
                    }
                    settings-default-hash-algorithm-changed(algo) => {
                        root.default_hash_algorithm = algo;
                        root.default_hash_algorithm_changed(algo);
                    }
                    settings-default-uuid-version-changed(ver) => {
                        root.default_uuid_version = ver;
                        root.default_uuid_version_changed(ver);
                    }
                    settings-default-timestamp-format-changed(fmt) => {
                        root.default_timestamp_format = fmt;
                        root.default_timestamp_format_changed(fmt);
                    }
                    settings-graphics-backend-changed(v) => {
                        root.graphics_backend = v;
                        root.graphics_backend_changed(v);
                    }
                    settings-peak-refresh-changed(v) => {
                        root.peak_refresh_enabled = v;
                        root.peak_refresh_changed(v);
                    }
                    settings-clear-recents => { root.clear_recents(); }
                    settings-clear-favorites => { root.clear_favorites(); }
                    settings-reset-welcome => { root.reset_welcome(); }
                    settings-open-about => { root.open_about(); }
                }
            }

        }

        // Overlay layer: tool screen with slide and fade transition
        tool_container := Rectangle {
            x: root.is_tool ? 0px : (root.width * 0.15);
            y: root.status_bar_inset;
            width: 100%;
            height: parent.height - root.status_bar_inset - (root.keyboard_open ? root.keyboard_height : 0px);
            opacity: root.is_tool ? 1.0 : 0.0;
            visible: self.opacity > 0.01;

            animate x, opacity {
                duration: 200ms;
                easing: root.is_tool ? cubic-bezier(0.05, 0.7, 0.1, 1.0) : cubic-bezier(0.3, 0, 0.8, 0.15);
            }

            // Input shield: taps on empty parts of a tool must not reach the home grid
            // that is still fading out underneath.
            TouchArea {
                width: 100%;
                height: 100%;
                enabled: root.is_tool;
                scroll-event(e) => { accept }
            }

            // Closing shield (declared after the tool, so it sits on top of it): while the
            // tool fades out, its buttons must not react to taps meant for the screen below.
            TouchArea {
                width: 100%;
                height: 100%;
                z: 10;
                enabled: !root.is_tool;
                scroll-event(e) => { accept }
            }

            if root.displayed_tool == 1 : SubnetScreen {
                property <int> pf: root.prefill_tool == 1 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.ip_input = root.prefill_text;
                    self.subnet-calculate();
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                status_bar_inset: root.status_bar_inset;
                nav_bar_inset: root.nav_bar_inset;
                subnet-back => { root.back(); }
                subnet-calculate => {
                    let res = root.subnet-calculate(self.ip_input);
                    self.network_address = res.network_address;
                    self.broadcast_address = res.broadcast_address;
                    self.first_host = res.first_host;
                    self.last_host = res.last_host;
                    self.host_count = res.host_count;
                    self.netmask = res.netmask;
                    self.wildcard_mask = res.wildcard_mask;
                    self.cidr_notation = res.cidr_notation;
                    self.error_message = res.error_message;
                }
                subnet-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 2 : HashScreen {
                property <int> pf: root.prefill_tool == 2 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.input_text = root.prefill_text;
                    self.hash-calculate();
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                status_bar_inset: root.status_bar_inset;
                nav_bar_inset: root.nav_bar_inset;
                selected_algorithm: root.default_hash_algorithm;
                hash-back => { root.back(); }
                hash-calculate => {
                    let res = root.hash-calculate(self.input_text, self.selected_algorithm);
                    self.hex_digest = res.hex_digest;
                    self.base64_digest = res.base64_digest;
                    self.error_message = res.error_message;
                }
                hash-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 3 : Base64Screen {
                property <int> pf: root.prefill_tool == 3 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.input_text = root.prefill_text;
                    self.mode = root.prefill_mode;
                    self.base64-convert();
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                status_bar_inset: root.status_bar_inset;
                nav_bar_inset: root.nav_bar_inset;
                keyboard_open: root.keyboard_open;
                keyboard_height: root.keyboard_height;
                base64-back => { root.back(); }
                base64-convert => {
                    let res = root.base64-convert(self.input_text, self.mode == 0, self.variant == 1, self.use_padding);
                    self.output_text = res.output_text;
                    self.error_message = res.error_message;
                }
                base64-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 4 : UuidScreen {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                status_bar_inset: root.status_bar_inset;
                nav_bar_inset: root.nav_bar_inset;
                version: root.default_uuid_version;
                uuid-back => { root.back(); }
                uuid-generate => {
                    let res = root.uuid-generate(self.version, self.count, self.uppercase, self.hyphens);
                    self.uuids = res.uuids;
                    self.bulk_uuids = res.bulk_uuids;
                    self.error_message = res.error_message;
                }
                uuid-copy-item(val) => { root.copy_text(val); }
                uuid-copy-all => { root.copy_text(self.bulk_uuids); }
            }

            if root.displayed_tool == 5 : TimestampScreen {
                property <int> pf: root.prefill_tool == 5 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.input_value = root.prefill_text;
                    self.mode = root.prefill_mode;
                    self.timestamp-convert();
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                status_bar_inset: root.status_bar_inset;
                nav_bar_inset: root.nav_bar_inset;
                timestamp-back => { root.back(); }
                timestamp-convert => {
                    let res = root.timestamp-convert(self.input_value, self.mode, self.timezone == 0 ? "UTC" : "Local");
                    self.unix_seconds = res.unix_seconds;
                    self.unix_millis = res.unix_millis;
                    self.iso_8601 = res.iso_8601;
                    self.rfc_2822 = res.rfc_2822;
                    self.human_readable = res.human_readable;
                    self.error_message = res.error_message;
                }
                timestamp-now => {
                    let res = root.timestamp-now(self.mode, self.timezone == 0 ? "UTC" : "Local");
                    self.input_value = res.input_value;
                    self.unix_seconds = res.unix_seconds;
                    self.unix_millis = res.unix_millis;
                    self.iso_8601 = res.iso_8601;
                    self.rfc_2822 = res.rfc_2822;
                    self.human_readable = res.human_readable;
                    self.error_message = res.error_message;
                }
                timestamp-swap-mode => {
                    if self.mode == 1 && self.unix_seconds != "" && self.input_value == self.unix_seconds && self.iso_8601 != "" {
                        self.input_value = self.iso_8601;
                    } else if self.mode == 0 && self.iso_8601 != "" && self.input_value == self.iso_8601 && self.unix_seconds != "" {
                        self.input_value = self.unix_seconds;
                    }
                    if self.input_value != "" {
                        let res = root.timestamp-convert(self.input_value, self.mode, self.timezone == 0 ? "UTC" : "Local");
                        self.unix_seconds = res.unix_seconds;
                        self.unix_millis = res.unix_millis;
                        self.iso_8601 = res.iso_8601;
                        self.rfc_2822 = res.rfc_2822;
                        self.human_readable = res.human_readable;
                        self.error_message = res.error_message;
                    }
                }
                timestamp-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 6 : RegexScreen {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                status_bar_inset: root.status_bar_inset;
                nav_bar_inset: root.nav_bar_inset;
                regex-back => { root.back(); }
                regex-test => {
                    let res = root.regex-test(self.pattern, self.test_string, self.case_insensitive, self.multiline, self.dot_matches_newline);
                    self.match_summary = res.match_summary;
                    self.matches_list = res.matches_list;
                    self.error_message = res.error_message;
                }
                regex-copy-match(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 7 : JsonYamlScreen {
                property <int> pf: root.prefill_tool == 7 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.source_text = root.prefill_text;
                    self.direction = root.prefill_mode;
                    self.json-yaml-convert();
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                status_bar_inset: root.status_bar_inset;
                nav_bar_inset: root.nav_bar_inset;
                json-yaml-back => { root.back(); }
                json-yaml-convert => {
                    let res = root.json-yaml-convert(self.source_text, self.direction == 0, self.indent_size);
                    self.converted_text = res.converted_text;
                    self.error_message = res.error_message;
                }
                json-yaml-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 8 : CronScreen {
                property <int> pf: root.prefill_tool == 8 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.expression = root.prefill_text;
                    self.cron-parse();
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                status_bar_inset: root.status_bar_inset;
                nav_bar_inset: root.nav_bar_inset;
                cron-back => { root.back(); }
                cron-parse => {
                    let res = root.cron-parse(self.expression);
                    self.description = res.description;
                    self.next_runs = res.next_runs;
                    self.error_message = res.error_message;
                }
                cron-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 9 : GzipScreen {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                status_bar_inset: root.status_bar_inset;
                nav_bar_inset: root.nav_bar_inset;
                gzip-back => { root.back(); }
                gzip-compress => {
                    let res = root.gzip-compress(self.input_data, true);
                    self.result_data = res.result_data;
                    self.original_size = res.original_size;
                    self.processed_size = res.processed_size;
                    self.ratio = res.ratio;
                    self.error_message = res.error_message;
                }
                gzip-decompress => {
                    let res = root.gzip-compress(self.input_data, false);
                    self.result_data = res.result_data;
                    self.original_size = res.original_size;
                    self.processed_size = res.processed_size;
                    self.ratio = res.ratio;
                    self.error_message = res.error_message;
                }
                gzip-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 10 : FormatterScreen {
                property <int> pf: root.prefill_tool == 10 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.source_code = root.prefill_text;
                    self.selected_lang = root.prefill_mode;
                    self.format-format();
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                status_bar_inset: root.status_bar_inset;
                nav_bar_inset: root.nav_bar_inset;
                format-back => { root.back(); }
                format-format => {
                    let res = root.format-format(self.source_code, self.selected_lang, self.indent_size);
                    self.formatted_code = res.formatted_code;
                    self.error_message = res.error_message;
                }
                format-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 11 : ChmodScreen {
                property <int> pf: root.prefill_tool == 11 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.octal_input = root.prefill_text;
                    self.chmod-apply-octal(root.prefill_text);
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                nav_bar_inset: root.nav_bar_inset;
                chmod-back => { root.back(); }
                chmod-apply => {
                    let res = root.chmod-apply(
                        self.owner_r, self.owner_w, self.owner_x,
                        self.group_r, self.group_w, self.group_x,
                        self.other_r, self.other_w, self.other_x,
                    );
                    self.octal_output = res.octal_output;
                    self.symbolic_output = res.symbolic_output;
                    self.command_output = res.command_output;
                    self.error_message = res.error_message;
                }
                chmod-apply-octal(octal) => {
                    let res = root.chmod-apply-octal(octal);
                    self.octal_output = res.octal_output;
                    self.symbolic_output = res.symbolic_output;
                    self.command_output = res.command_output;
                    self.error_message = res.error_message;
                    if res.has_matrix {
                        self.owner_r = res.owner_r;
                        self.owner_w = res.owner_w;
                        self.owner_x = res.owner_x;
                        self.group_r = res.group_r;
                        self.group_w = res.group_w;
                        self.group_x = res.group_x;
                        self.other_r = res.other_r;
                        self.other_w = res.other_w;
                        self.other_x = res.other_x;
                    }
                }
                chmod-apply-preset(preset) => {
                    let res = root.chmod-apply-octal(preset);
                    self.octal_output = res.octal_output;
                    self.symbolic_output = res.symbolic_output;
                    self.command_output = res.command_output;
                    self.error_message = res.error_message;
                    if res.has_matrix {
                        self.owner_r = res.owner_r;
                        self.owner_w = res.owner_w;
                        self.owner_x = res.owner_x;
                        self.group_r = res.group_r;
                        self.group_w = res.group_w;
                        self.group_x = res.group_x;
                        self.other_r = res.other_r;
                        self.other_w = res.other_w;
                        self.other_x = res.other_x;
                    }
                }
                chmod-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 12 : ColorScreen {
                property <int> pf: root.prefill_tool == 12 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.color_input = root.prefill_text;
                    self.selected_format = 0;
                    self.color-convert();
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                nav_bar_inset: root.nav_bar_inset;
                color-back => { root.back(); }
                color-convert => {
                    let res = root.color-convert(self.color_input, self.selected_format);
                    self.hex_output = res.hex_output;
                    self.rgb_output = res.rgb_output;
                    self.hsl_output = res.hsl_output;
                    self.hsv_output = res.hsv_output;
                    self.cmyk_output = res.cmyk_output;
                    self.error_message = res.error_message;
                }
                color-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 13 : ContrastScreen {
                property <int> pf: root.prefill_tool == 13 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.fg_color_text = root.prefill_text;
                    self.contrast-check();
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                nav_bar_inset: root.nav_bar_inset;
                contrast-back => { root.back(); }
                contrast-check => {
                    let res = root.contrast-check(self.fg_color_text, self.bg_color_text);
                    self.ratio_text = res.ratio_text;
                    self.aa_normal_pass = res.aa_normal_pass;
                    self.aa_large_pass = res.aa_large_pass;
                    self.aaa_normal_pass = res.aaa_normal_pass;
                    self.aaa_large_pass = res.aaa_large_pass;
                    self.ui_components_pass = res.ui_components_pass;
                    self.error_message = res.error_message;
                }
                contrast-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 14 : JwtScreen {
                property <int> pf: root.prefill_tool == 14 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.token_input = root.prefill_text;
                    self.jwt-decode();
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                nav_bar_inset: root.nav_bar_inset;
                jwt-back => { root.back(); }
                jwt-decode => {
                    let res = root.jwt-decode(self.token_input);
                    self.header_json = res.header_json;
                    self.payload_json = res.payload_json;
                    self.signature_output = res.signature_output;
                    self.algorithm = res.algorithm;
                    self.expiration_status = res.expiration_status;
                    self.expiration_time = res.expiration_time;
                    self.error_message = res.error_message;
                }
                jwt-copy(val) => { root.copy_text(val); }
                jwt-copy-header(val) => { root.copy_text(val); }
                jwt-copy-payload(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 15 : DiffScreen {
                property <int> pf: root.prefill_tool == 15 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.original_text = root.prefill_text;
                    self.view_mode = 0;
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                nav_bar_inset: root.nav_bar_inset;
                diff-back => { root.back(); }
                diff-compare => {
                    let res = root.diff-compare(self.original_text, self.modified_text, self.ignore_whitespace);
                    self.additions_count = res.additions;
                    self.deletions_count = res.deletions;
                    self.unchanged_count = res.unchanged;
                    self.unified_patch = res.unified_patch;
                    self.error_message = res.error_message;
                }
                diff-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 16 : QrCodeScreen {
                property <int> pf: root.prefill_tool == 16 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.selected_type = 0;
                    self.text_payload = root.prefill_text;
                    self.qrcode-generate();
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                nav_bar_inset: root.nav_bar_inset;
                live_totp_code: root.totp_live_code;
                totp_remaining_secs: root.totp_live_remaining;
                qrcode-back => { root.back(); }
                qrcode-generate => {
                    if self.selected_type == 0 {
                        root.totp_secret_active = "";
                        let res = root.qrcode-generate-text(self.text_payload);
                        self.qr_image = res.qr_image;
                        self.encoded_payload = res.payload;
                        self.error_message = res.error_message;
                    } else if self.selected_type == 1 {
                        let res = root.qrcode-generate-wifi(self.wifi_ssid, self.wifi_password, self.wifi_auth, self.wifi_hidden);
                        self.qr_image = res.qr_image;
                        self.encoded_payload = res.payload;
                        self.error_message = res.error_message;
                    } else {
                        let res = root.qrcode-generate-totp(self.totp_issuer, self.totp_account, self.totp_secret);
                        self.qr_image = res.qr_image;
                        self.encoded_payload = res.payload;
                        root.totp_secret_active = res.error_message == "" ? self.totp_secret : "";
                        root.totp_live_code = res.totp_code;
                        root.totp_live_remaining = res.totp_remaining_secs;
                        self.error_message = res.error_message;
                    }
                }
                qrcode-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 17 : HttpClientScreen {
                property <int> pf: root.prefill_tool == 17 ? root.prefill_seq : 0;
                function apply_prefill() {
                    if root.prefill_mode == 1 {
                        self.curl_command = root.prefill_text;
                        self.active_tab = 2;
                        self.http-import-curl(root.prefill_text);
                    } else {
                        self.url = root.prefill_text;
                        self.selected_method = 0;
                    }
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                nav_bar_inset: root.nav_bar_inset;
                http-back => { root.back(); }
                is_loading: root.http_busy;
                response_status: root.http_result.status;
                response_status_text: root.http_result.status_text;
                response_latency_ms: root.http_result.latency_ms;
                response_ttfb_ms: root.http_result.ttfb_ms;
                response_size_bytes: root.http_result.size_bytes;
                response_headers: root.http_result.headers;
                response_body: root.http_result.body;
                response_final_url: root.http_result.final_url;
                response_content_type: root.http_result.content_type;
                response_truncated: root.http_result.truncated;
                request_error: root.http_result.error_message;
                http-send => {
                    if !root.http_busy {
                        root.http-send(self.selected_method, self.url, self.headers_text, self.body_text);
                    }
                }
                http-copy(val) => { root.copy_text(val); }
                http-import-curl(cmd) => {
                    let res = root.http-import-curl(cmd);
                    if res.error_message == "" {
                        self.selected_method = res.method_idx;
                        self.url = res.url;
                        self.headers_text = res.headers;
                        self.body_text = res.body;
                    }
                    self.error_message = res.error_message;
                }
                http-export-curl => {
                    self.curl_command = root.http-export-curl(self.selected_method, self.url, self.headers_text, self.body_text);
                }
            }

            if root.displayed_tool == 18 : LanScoutScreen {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                nav_bar_inset: root.nav_bar_inset;
                detected_gateway: root.detected_gateway;
                detected_device_ip: root.detected_device_ip;
                network_summary: root.network_summary;
                target_host: root.detected_gateway;
                is_scanning: root.lan_busy;
                progress_text: root.lan_progress;
                error_message: root.lan_result.error_message;
                open_ports_count: root.lan_result.open_count;
                total_scanned_count: root.lan_result.total_count;
                scan_results: root.lan_result.ports;
                open_results: root.lan_result.open_ports;
                hosts: root.lan_result.hosts;
                hosts_probed: root.lan_result.hosts_probed;
                property <int> pf: root.prefill_tool == 18 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.target_host = root.prefill_text;
                    self.mode = 0;
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                scout-back => { root.back(); }
                scout-scan(host, timeout_ms, mode, ports) => {
                    if !root.lan_busy { root.lan-scout-scan(host, timeout_ms, mode, ports); }
                }
                scout-discover(timeout_ms) => {
                    if !root.lan_busy { root.lan-scout-discover(timeout_ms); }
                }
                scout-refresh-network => { root.refresh-network(); }
                scout-open-tool(id, payload) => { root.open_tool_with(id, payload); }
                scout-copy(val) => { root.copy_text(val); }
            }

            if root.displayed_tool == 19 : TlsScreen {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                nav_bar_inset: root.nav_bar_inset;
                is_loading: root.tls_busy;
                result: root.tls_result;
                property <int> pf: root.prefill_tool == 19 ? root.prefill_seq : 0;
                function apply_prefill() {
                    self.target = root.prefill_text;
                    self.expanded_cert = 0;
                    root.tls-inspect(root.prefill_text);
                }
                init => { if self.pf > 0 { self.apply_prefill(); } }
                changed pf => { if self.pf > 0 { self.apply_prefill(); } }
                tls-back => { root.back(); }
                tls-inspect(target) => {
                    if !root.tls_busy {
                        self.expanded_cert = 0;
                        root.tls-inspect(target);
                    }
                }
                tls-copy(val) => { root.copy_text(val); }
            }
        }

        // Overlay layer: About screen with slide and fade transition
        about_container := Rectangle {
            background: MaterialPalette.surface;
            x: root.about_open ? 0px : (root.width * 0.15);
            y: 0px;
            width: 100%;
            height: parent.height;
            opacity: root.about_open ? 1.0 : 0.0;
            visible: self.opacity > 0.01;

            animate x, opacity {
                duration: root.about_open ? 320ms : 200ms;
                easing: root.about_open ? cubic-bezier(0.05, 0.7, 0.1, 1.0) : cubic-bezier(0.3, 0, 0.8, 0.15);
            }

            // Input shield (About is opaque, but a bare Rectangle lets taps through).
            TouchArea {
                width: 100%;
                height: 100%;
                enabled: root.about_open;
                scroll-event(e) => { accept }
            }

            AboutScreen {
                status_bar_inset: root.status_bar_inset;
                nav_bar_inset: root.nav_bar_inset;
                pill_height: pill_nav.height;
                pill_bottom_margin: root.pill_bottom_margin;
                about-back => {
                    root.back();
                }
            }

            // Closing shield: About stays drawn while it fades out; swallow taps meanwhile.
            TouchArea {
                width: 100%;
                height: 100%;
                enabled: !root.about_open;
                scroll-event(e) => { accept }
            }
        }
    }

    // Floating pill navigation bar anchored above system nav bar / gesture inset
    pill_wrapper := VerticalLayout {
        alignment: end;
        y: root.keyboard_open ? 48px : 0px;
        width: 100%;
        height: 100%;
        padding_bottom: root.nav_bar_inset + root.pill_bottom_margin;
        opacity: (root.keyboard_open || root.welcome_open) ? 0.0 : 1.0;
        visible: self.opacity > 0.01;

        animate opacity, y {
            duration: 150ms;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }

        HorizontalLayout {
            alignment: center;
            width: 100%;

            pill_nav := PillNavBar {
                active_index: root.is_tool ? -1 : root.current_mode;
                items: [
                    { icon: AppIcons.home, label: "Home" },
                    { icon: AppIcons.history, label: "Recent" },
                    { icon: AppIcons.star, label: "Favorites" },
                    { icon: AppIcons.settings, label: "Settings" },
                ];
                select(index) => {
                    root.switch_mode(index);
                }
            }
        }
    }

    // First-launch Welcome flow (topmost; blocks all input underneath).
    // It fades out instead of vanishing, and keeps swallowing input while it does: a quick
    // double tap on "Get Started" used to land on the tool card that appeared under it.
    welcome_layer := Rectangle {
        width: 100%;
        height: 100%;
        opacity: root.welcome_open ? 1.0 : 0.0;
        visible: self.opacity > 0.01;

        animate opacity {
            duration: 260ms;
            easing: cubic-bezier(0.3, 0, 0.8, 0.15);
        }

        if root.welcome_open || welcome_layer.visible : WelcomeScreen {
            status_bar_inset: root.status_bar_inset;
            nav_bar_inset: root.nav_bar_inset;
            current_page <=> root.welcome_page;
            finish => {
                if root.welcome_open {
                    root.dismiss_welcome();
                }
            }
        }

        TouchArea {
            width: 100%;
            height: 100%;
            enabled: !root.welcome_open;
            scroll-event(e) => { accept }
        }
    }
}
