    property <MaterialSchemes> active_schemes: root.dynamic_color_enabled ? root.dynamic_schemes : root.brand_schemes;
    property <MaterialScheme> scheme: Palette.color_scheme == ColorScheme.dark ? root.active_schemes.dark : root.active_schemes.light;
