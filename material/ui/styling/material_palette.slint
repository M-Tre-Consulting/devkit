            onPrimaryFixedVariant: rgb(14, 81, 64),
            secondaryFixed: rgb(255, 219, 208),
            onSecondaryFixed: rgb(59, 10, 1),
            secondaryFixedDim: rgb(224, 122, 95),
            onSecondaryFixedVariant: rgb(114, 53, 34),
            tertiaryFixed: rgb(255, 223, 158),
