            tertiaryFixedDim: rgb(245, 199, 103),
            onTertiaryFixedVariant: rgb(92, 67, 0),
            surfaceDim: rgb(10, 10, 10),
            surfaceBright: rgb(54, 58, 56),
            surfaceContainerLowest: rgb(5, 5, 5),
